---
export const prerender = false;

import { supabase } from '../../lib/supabase';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';

const { slug } = Astro.params;

// Fetch product details (graceful)
let product: any = null;
try {
	const { data } = await supabase
		.from('repuestos_productos')
		.select('*')
		.eq('slug', slug)
		.single();
	product = data;
} catch (e: any) {
	console.error('[repuesto] Supabase error:', e?.message);
}

if (!product) {
	Astro.response.status = 404;
}

const compStr = product?.compatibilidad && product.compatibilidad.length > 0 
	? product.compatibilidad.slice(0, 3).join(', ') 
	: 'varios modelos';

const titleSEO = product 
	? `${product.titulo} para ${compStr} - SKU: ${product.sku} | SERVITECNOLOGY`
	: 'Repuesto no encontrado (404) | SERVITECNOLOGY';
const descSEO = product
	? `Compra tu ${product.titulo} compatible con ${compStr}. Repuesto original con SKU ${product.sku}. Disponible en Santiago de Chile con entrega previa coordinación.`
	: 'El repuesto solicitado no está disponible en nuestro catálogo.';
const keywordsSEO = product?.seo_keywords || `repuesto, ${product?.titulo || ''}, ${product?.sku || ''}, servitecnology`;

const phone = "56948672300";
const msg = product ? encodeURIComponent(`Hola SERVITECNOLOGY, me interesa el repuesto: ${product.titulo} (SKU: ${product.sku}) que vi en su catálogo web en la URL de detalle. ¿Tienen stock o valor con instalación?`) : '';
const waLink = `https://wa.me/${phone}?text=${msg}`;

const images: string[] = product?.imagenes ?? [];
const hasMultipleImages = images.length > 1;

// Infer brand from title or compatibilidad or default to SERVITECNOLOGY
const titleLower = (product?.titulo || '').toLowerCase();
let brandName = 'SERVITECNOLOGY';
if (titleLower.includes('dell')) brandName = 'Dell';
else if (titleLower.includes('asus')) brandName = 'ASUS';
else if (titleLower.includes('lenovo') || titleLower.includes('thinkpad')) brandName = 'Lenovo';
else if (titleLower.includes('hp') || titleLower.includes('hewlett')) brandName = 'HP';
else if (titleLower.includes('samsung')) brandName = 'Samsung';
else if (titleLower.includes('toshiba')) brandName = 'Toshiba';
else if (titleLower.includes('epson')) brandName = 'Epson';
else if (titleLower.includes('canon')) brandName = 'Canon';
else if (titleLower.includes('hikvision')) brandName = 'Hikvision';

// Prepare JSON-LD schema
const productSchema = product ? {
	"@context": "https://schema.org",
	"@type": "Product",
	"name": product.titulo,
	"sku": product.sku,
	"mpn": product.sku,
	"brand": {
		"@type": "Brand",
		"name": brandName
	},
	"model": product.compatibilidad && product.compatibilidad.length > 0 ? product.compatibilidad.join(', ') : product.sku,
	"description": `${product.descripcion || ''} | SKU: ${product.sku} | Compatibilidad: ${product.compatibilidad ? product.compatibilidad.join(', ') : 'Varios'}`,
	"image": images.length > 0 ? images[0] : "https://servitecnology.com/imagenes/principal.jpg",
	"offers": {
		"@type": "Offer",
		"priceCurrency": "CLP",
		"price": product.precio_venta,
		"priceValidUntil": "2027-12-31",
		"itemCondition": "https://schema.org/UsedCondition",
		"availability": product.stock_cantidad > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
		"seller": {
			"@type": "Organization",
			"name": "SERVITECNOLOGY",
			"url": "https://servitecnology.com"
		},
		"hasMerchantReturnPolicy": {
			"@type": "MerchantReturnPolicy",
			"applicableCountry": "CL",
			"returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
			"merchantReturnDays": 10,
			"returnMethod": "https://schema.org/ReturnInStore",
			"returnFees": "https://schema.org/FreeReturn",
			"merchantReturnLink": "https://servitecnology.com/garantias"
		},
		"shippingDetails": {
			"@type": "OfferShippingDetails",
			"shippingDestination": {
				"@type": "DefinedRegion",
				"addressCountry": "CL"
			},
			"shippingRate": {
				"@type": "MonetaryAmount",
				"value": 0,
				"currency": "CLP"
			},
			"deliveryTime": {
				"@type": "ShippingDeliveryTime",
				"handlingTime": {
					"@type": "QuantitativeValue",
					"minValue": 0,
					"maxValue": 1,
					"unitCode": "DAY"
				},
				"transitTime": {
					"@type": "QuantitativeValue",
					"minValue": 1,
					"maxValue": 3,
					"unitCode": "DAY"
				}
			}
		}
	}
} : null;
---

<Layout title={titleSEO} description={descSEO} keywords={keywordsSEO}>
	<Header />
	
	{!product ? (
		<main class="relative bg-black min-h-[70vh] flex items-center justify-center py-20 px-6">
			<div class="relative z-10 max-w-lg mx-auto text-center space-y-6">
				<div class="w-20 h-20 mx-auto rounded-3xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 text-3xl font-black">
					404
				</div>
				<h1 class="text-3xl font-black text-white">Repuesto No Encontrado</h1>
				<p class="text-sm text-slate-300 leading-relaxed">
					El componente o SKU solicitado no se encuentra disponible actualmente en nuestro catálogo o fue dado de baja.
				</p>
				<div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
					<a href="/repuestos" class="w-full sm:w-auto px-6 py-3 rounded-xl bg-gradient-to-r from-brand-green to-brand-cyan text-black font-bold text-xs uppercase tracking-wider hover:opacity-90 transition-all">
						Ver Catálogo Completo
					</a>
					<a href="/" class="w-full sm:w-auto px-6 py-3 rounded-xl bg-white/10 text-white font-bold text-xs uppercase tracking-wider hover:bg-white/15 transition-all">
						Ir al Inicio
					</a>
				</div>
			</div>
		</main>
	) : (
		<>
			<!-- Structured Data JSON-LD Product Schema -->
			{productSchema && (
				<script type="application/ld+json" is:inline set:html={JSON.stringify(productSchema)} />
			)}
			
			<main class="relative bg-black min-h-screen py-20 border-b border-white/5">
		<!-- Background Glows -->
		<div class="absolute top-1/4 left-1/4 -translate-x-1/2 -translate-y-1/2 w-[300px] md:w-[500px] h-[300px] md:h-[500px] bg-brand-cyan/5 rounded-full blur-[120px] pointer-events-none"></div>
		<div class="absolute bottom-1/4 right-1/4 translate-x-1/2 translate-y-1/2 w-[300px] md:w-[500px] h-[300px] md:h-[500px] bg-brand-green/5 rounded-full blur-[120px] pointer-events-none"></div>

		<div class="relative z-10 mx-auto max-w-5xl px-6 w-full mt-8">
			<!-- Back Button -->
			<a href="/repuestos" class="inline-flex items-center gap-2 text-xs font-semibold text-slate-400 hover:text-brand-cyan transition-colors mb-8">
				← Volver a la Tienda Ecommerce
			</a>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start bg-zinc-950/45 border border-white/5 p-8 rounded-2xl backdrop-blur-sm">
				
				<!-- Product Gallery (Left) -->
				<div>
					{images.length > 0 ? (
						<div class="relative w-full aspect-[4/3] rounded-xl overflow-hidden bg-zinc-900 border border-white/10 shadow-2xl group/gallery">
							{images.map((img, idx) => (
								<img
									src={img}
									alt={`${product.titulo} - imagen ${idx + 1}`}
									class:list={[
										"detail-carousel-img absolute inset-0 w-full h-full object-cover transition-opacity duration-500 cursor-zoom-in",
										idx === 0 ? "opacity-100 z-10" : "opacity-0"
									]}
									data-index={idx}
									data-lightbox-images={JSON.stringify(images)}
									loading="eager"
								/>
							))}
							{hasMultipleImages && (
								<>
									<button
										type="button"
										class="detail-prev absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 flex items-center justify-center rounded-full bg-black/40 text-white hover:bg-brand-cyan hover:text-black transition-all opacity-0 group-hover/gallery:opacity-100 hover:opacity-100 focus:opacity-100 z-20 focus:outline-none"
										aria-label="Anterior"
									>
										<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
									</button>
									<button
										type="button"
										class="detail-next absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 flex items-center justify-center rounded-full bg-black/40 text-white hover:bg-brand-cyan hover:text-black transition-all opacity-0 group-hover/gallery:opacity-100 hover:opacity-100 focus:opacity-100 z-20 focus:outline-none"
										aria-label="Siguiente"
									>
										<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
									</button>
								</>
							)}
						</div>
					) : (
						<div class="w-full aspect-[4/3] rounded-xl bg-zinc-900 border border-white/5 flex items-center justify-center text-slate-600">
							No hay imagen disponible
						</div>
					)}
				</div>

				<!-- Product Details (Right) -->
				<div class="space-y-6">
					<!-- Badges -->
					<div class="flex flex-wrap gap-2">
						<span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full border text-brand-cyan bg-brand-cyan/10 border-brand-cyan/20">
							{product.estado || 'Usado Verificado'}
						</span>
						{product.stock_cantidad <= 0 && (
							<span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full border text-red-400 bg-red-500/10 border-red-500/20">
								Agotado
							</span>
						)}
						<span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full border text-slate-400 bg-white/5 border-white/10">
							SKU: {product.sku}
						</span>
						<span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full border text-brand-green bg-brand-green/10 border-brand-green/20">
							{product.categoria}
						</span>
					</div>

					<h1 class="text-3xl font-extrabold text-white tracking-tight leading-tight">
						{product.titulo}
					</h1>

					<!-- Price -->
					<div class="flex items-baseline gap-2 border-y border-white/5 py-4">
						<span class="text-3xl font-black text-white">${product.precio_venta?.toLocaleString('es-CL')}</span>
						<span class="text-xs text-slate-500 uppercase font-semibold">CLP</span>
					</div>

					<!-- Stock Badge -->
					<div class="flex items-center gap-2">
						{product.stock_cantidad > 0 ? (
							<>
								<span class="w-2.5 h-2.5 rounded-full bg-brand-green animate-pulse shrink-0"></span>
								<span class="text-sm font-semibold text-brand-green">Disponibles: {product.stock_cantidad} unidades</span>
							</>
						) : (
							<>
								<span class="w-2.5 h-2.5 rounded-full bg-red-500 shrink-0"></span>
								<span class="text-sm font-semibold text-red-500">Agotado Temporalmente</span>
							</>
						)}
					</div>

					<!-- Description -->
					<div class="space-y-2">
						<h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Descripción del Repuesto</h3>
						<p class="text-sm text-slate-300 leading-relaxed whitespace-pre-line">
							{product.descripcion}
						</p>
					</div>

					<!-- Compatibility -->
					{product.compatibilidad && product.compatibilidad.length > 0 && (
						<div class="space-y-2">
							<h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Compatibilidad de Equipos</h3>
							<div class="flex flex-wrap gap-1.5">
								{product.compatibilidad.map((comp: string) => (
									<span class="text-xs px-2.5 py-1 rounded-md bg-white/5 border border-white/5 text-slate-300">
										{comp}
									</span>
								))}
							</div>
						</div>
					)}

					<!-- CTA buttons -->
					<div class="pt-4 space-y-3">
						{product.stock_cantidad > 0 ? (
							<div class="flex flex-col sm:flex-row gap-3">
								<button
									type="button"
									id="btn-detail-add-cart"
									class="flex-1 flex items-center justify-center gap-2.5 px-6 py-4 rounded-xl font-bold text-white bg-white/10 hover:bg-white/15 border border-white/15 hover:border-brand-green/40 transition-all duration-300 text-sm tracking-wide cursor-pointer"
									data-sku={product.sku}
									data-title={product.titulo}
									data-price={product.precio_venta}
									data-image={images[0] || '/imagenes/logost.png'}
									data-slug={product.slug}
									data-stock={product.stock_cantidad}
								>
									<svg class="w-4 h-4 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
									<span id="btn-detail-add-text">Agregar al Carrito</span>
								</button>
								<button
									type="button"
									id="btn-detail-buy-now"
									class="flex-1 flex items-center justify-center gap-2.5 px-6 py-4 rounded-xl font-black text-black bg-gradient-to-r from-brand-green to-brand-cyan hover:opacity-90 active:scale-98 shadow-[0_0_25px_rgba(0,255,127,0.3)] transition-all duration-300 text-sm uppercase tracking-wide cursor-pointer"
									data-sku={product.sku}
									data-title={product.titulo}
									data-price={product.precio_venta}
									data-image={images[0] || '/imagenes/logost.png'}
									data-slug={product.slug}
									data-stock={product.stock_cantidad}
								>
									<svg class="w-4 h-4 fill-none stroke-current" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
									<span>Comprar Ahora</span>
								</button>
							</div>
						) : (
							<div class="w-full py-4 text-center rounded-xl bg-red-500/10 border border-red-500/20 text-red-500 font-bold text-sm">
								Producto Agotado / Sin Stock
							</div>
						)}

						<a
							href={product.stock_cantidad > 0 ? waLink : "#"}
							target={product.stock_cantidad > 0 ? "_blank" : "_self"}
							rel="noopener noreferrer"
							data-track-event="clic_boton"
							data-element-id={`btn_whatsapp_producto_${product.sku}`}
							class={`flex items-center justify-center gap-2.5 w-full px-6 py-3.5 rounded-xl font-bold tracking-wide transition-all duration-300 text-xs ${product.stock_cantidad > 0 ? 'bg-brand-green/15 border border-brand-green/30 text-brand-green hover:bg-brand-green hover:text-black shadow-[0_0_20px_rgba(0,255,127,0.15)]' : 'hidden'}`}
						>
							<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.458 5.704 1.459h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
							<span>Coordinar Compra vía WhatsApp</span>
						</a>
					</div>
				</div>

			</div>
		</div>
	</main>
	</>
	)}

	<Footer />
</Layout>

<script>
	// Detail Image carousel logic
	const prevBtn = document.querySelector('.detail-prev') as HTMLButtonElement;
	const nextBtn = document.querySelector('.detail-next') as HTMLButtonElement;
	const imgs = document.querySelectorAll('.detail-carousel-img');
	
	if (prevBtn && nextBtn && imgs.length > 1) {
		let currentIndex = 0;
		const showImg = (idx: number) => {
			imgs.forEach((img, i) => {
				if (i === idx) {
					img.classList.replace('opacity-0', 'opacity-100');
					img.classList.add('z-10');
				} else {
					img.classList.replace('opacity-100', 'opacity-0');
					img.classList.remove('z-10');
				}
			});
			currentIndex = idx;
		};

		prevBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			showImg((currentIndex - 1 + imgs.length) % imgs.length);
		});
		nextBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			showImg((currentIndex + 1) % imgs.length);
		});
	}

	// Lightbox trigger logic
	imgs.forEach(img => {
		img.addEventListener('click', () => {
			const imagesRaw = img.getAttribute('data-lightbox-images');
			if (!imagesRaw) return;
			try {
				const images = JSON.parse(imagesRaw);
				const idx = parseInt(img.getAttribute('data-index') || '0', 10);
				if ((window as any).openLightbox) {
					(window as any).openLightbox(images, idx);
				}
			} catch(e) {}
		});
	});

	// Cart & Buy button logic
	import { addToCart } from '../../lib/cart';

	const btnDetailAddCart = document.getElementById('btn-detail-add-cart');
	const btnDetailAddText = document.getElementById('btn-detail-add-text');
	const btnDetailBuyNow = document.getElementById('btn-detail-buy-now');

	function getItemData(btn: HTMLElement) {
		const sku = btn.getAttribute('data-sku') || '';
		const title = btn.getAttribute('data-title') || '';
		const price = parseFloat(btn.getAttribute('data-price') || '0');
		const image = btn.getAttribute('data-image') || '';
		const slug = btn.getAttribute('data-slug') || '';
		const rawStock = btn.getAttribute('data-stock');
		const stockNum = rawStock !== null ? parseInt(rawStock, 10) : undefined;
		return { sku, titulo: title, precio_venta: price, cantidad: 1, imagen: image, slug, stock_disponible: stockNum };
	}

	btnDetailAddCart?.addEventListener('click', () => {
		const item = getItemData(btnDetailAddCart);
		if (!item.sku) return;

		const result = addToCart(item);

		const originalText = btnDetailAddText ? btnDetailAddText.textContent : 'Agregar al Carrito';

		if (!result.success) {
			if (btnDetailAddText) btnDetailAddText.textContent = '¡Máx. Stock en Carrito!';
			btnDetailAddCart.classList.add('ring-2', 'ring-amber-400', 'text-amber-300');
			setTimeout(() => {
				if (btnDetailAddText) btnDetailAddText.textContent = originalText;
				btnDetailAddCart.classList.remove('ring-2', 'ring-amber-400', 'text-amber-300');
			}, 1500);
			return;
		}

		if (btnDetailAddText) btnDetailAddText.textContent = '¡Agregado al Carrito! ✓';
		btnDetailAddCart.classList.add('ring-2', 'ring-brand-green', 'text-brand-green');

		setTimeout(() => {
			if (btnDetailAddText) btnDetailAddText.textContent = originalText;
			btnDetailAddCart.classList.remove('ring-2', 'ring-brand-green', 'text-brand-green');
		}, 1500);
	});

	btnDetailBuyNow?.addEventListener('click', () => {
		const item = getItemData(btnDetailBuyNow);
		if (!item.sku) return;

		addToCart(item);
		window.location.href = '/checkout';
	});
</script>
