---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Catalog from '../components/Catalog.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout 
	title="Ecommerce Servitecnology | Componentes, Repuestos y Hardware en Santiago" 
	description="Tienda online de repuestos y hardware para computadores, laptops e impresoras en Santiago. Compra con transferencia bancaria, retiro en oficina o despacho RM."
	keywords="ecommerce repuestos, comprar repuestos notebook, pantallas laptop, baterias, teclados, ssd, memoria ram, servitecnology chile"
>
	<!-- Fixed Header -->
	<Header />
	
	<main class="relative bg-black min-h-screen">
		<!-- Parts & Components Catalog with multi-criteria search and checkout links -->
		<Catalog />
	</main>

	<!-- Footer -->
	<Footer />

	<!-- Floating WhatsApp CTA -->
	<WhatsAppButton phone="56948672300" message="Hola SERVITECNOLOGY, consulto por la tienda Ecommerce..." />
</Layout>
