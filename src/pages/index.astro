---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FeaturedParts from '../components/FeaturedParts.astro';
import SaaSProducts from '../components/SaaSProducts.astro';
import Services from '../components/Services.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout 
	title="SERVITECNOLOGY | Servicio Técnico de Computadoras, Repuestos y Soluciones IT en Santiago"
	description="Servicio técnico profesional de computadoras y notebooks, repuestos de hardware garantizados y desarrollo SaaS en Santiago de Chile. Diagnóstico, mantención y soporte informático."
>
	<!-- Fixed Header -->
	<Header />
	
	<main class="relative bg-black min-h-screen">
		<!-- Hero Section -->
		<Hero />

		<!-- Featured Hardware Parts (Direct Internal Linking for SEO & Googlebot) -->
		<FeaturedParts />

		<!-- SaaS Products Section -->
		<SaaSProducts />

		<!-- Services Section -->
		<Services />
	</main>

	<!-- Footer -->
	<Footer />

	<!-- Floating WhatsApp CTA -->
	<WhatsAppButton phone="56948672300" message="Hola SERVITECNOLOGY, requiero soporte técnico..." />
</Layout>
