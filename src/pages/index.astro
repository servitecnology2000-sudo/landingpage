---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FeaturedParts from '../components/FeaturedParts.astro';
import SaaSProducts from '../components/SaaSProducts.astro';
import Services from '../components/Services.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout 
	title="SERVITECNOLOGY | Software a Medida, Agentes IA, Bots de WhatsApp y Soporte TI en Santiago"
	description="Desarrollo de software a medida, agentes IA y bots para WhatsApp en Chile. Automatización de procesos, servicio técnico de computadoras y repuestos originales en Santiago."
	keywords="desarrollo de software a medida, agentes ia, bots para whatsapp, bot whatsapp chile, automatizacion de redes sociales, desarrollo web saas, soporte tecnico, repuestos computacion, servitecnology, santiago"
>
	<!-- Fixed Header -->
	<Header />
	
	<main class="relative bg-black min-h-screen">
		<!-- Hero Section -->
		<Hero />

		<!-- Featured Hardware Parts (Direct Internal Linking for SEO & Googlebot) -->
		<FeaturedParts />

		<!-- SaaS Products Section -->
		<SaaSProducts />

		<!-- Services Section -->
		<Services />
	</main>

	<!-- Footer -->
	<Footer />

	<!-- Floating WhatsApp CTA -->
	<WhatsAppButton phone="56948672300" message="Hola SERVITECNOLOGY, requiero soporte técnico..." />
</Layout>
