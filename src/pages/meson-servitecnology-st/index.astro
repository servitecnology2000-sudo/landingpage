---
export const prerender = false;

import { supabase, supabaseAdmin } from '../../lib/supabase';

// Auth guard — runtime read
const _env = typeof process !== 'undefined' ? process.env : ({} as Record<string, string>);
const adminSecret = _env['ADMIN_SECRET'] || import.meta.env.ADMIN_SECRET || '20181860';
const cookie = Astro.cookies.get('admin_session');
if (cookie?.value !== adminSecret) {
	return Astro.redirect('/meson-servitecnology-st/login');
}

let notification = '';

// Helper to sanitize file names to URL-friendly format
function sanitizeFileName(originalName: string, index: number): string {
	const lastDot = originalName.lastIndexOf('.');
	const ext = lastDot !== -1 ? originalName.substring(lastDot + 1).toLowerCase() : 'jpg';
	const nameWithoutExt = lastDot !== -1 ? originalName.substring(0, lastDot) : originalName;

	const cleanBase = nameWithoutExt
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.toLowerCase()
		.replace(/[^a-z0-9]/g, '_')
		.replace(/_+/g, '_')
		.replace(/^_+|_+$/g, '');

	const safeBase = cleanBase || 'imagen';
	const timeStamp = Date.now().toString().slice(-6);
	return `${safeBase}_${timeStamp}_${index + 1}.${ext}`;
}

// Handle POST actions for SSR fallbacks
if (Astro.request.method === 'POST') {
	const formData = await Astro.request.formData();
	const action = formData.get('action')?.toString();
	const id = formData.get('id')?.toString();
	
	if (action === 'delete' && id) {
		await supabaseAdmin.from('repuestos_productos').delete().eq('id', id);
		return Astro.redirect('/meson-servitecnology-st');
	}

	if (action === 'upload_galeria') {
		const rawFiles = formData.getAll('imagen');
		const files = rawFiles.filter((f): f is File => f instanceof File && f.size > 0);
		const categoria = formData.get('categoria')?.toString() || 'Soporte';
		const titulo = formData.get('titulo')?.toString() || '';

		if (files.length > 0) {
			try {
				const { data: bucketData, error: getBucketErr } = await supabaseAdmin.storage.getBucket('trabajos_galeria');
				if (!bucketData || getBucketErr) {
					await supabaseAdmin.storage.createBucket('trabajos_galeria', { public: true });
				}
			} catch (e) {
				console.log('[Bucket Check] Log:', e);
			}

			let uploadedCount = 0;
			let errors: string[] = [];

			await Promise.all(
				files.map(async (file, index) => {
					try {
						const arrayBuffer = await file.arrayBuffer();
						const buffer = Buffer.from(arrayBuffer);
						const cleanName = sanitizeFileName(file.name, index);
						const fileName = `${categoria.toLowerCase()}_${cleanName}`;
						
						const { data: uploadData, error: uploadError } = await supabaseAdmin.storage
							.from('trabajos_galeria')
							.upload(fileName, buffer, {
								contentType: file.type || 'image/jpeg',
								upsert: true
							});

						if (uploadError) {
							console.error(`[Storage Error on ${file.name}]`, uploadError);
							errors.push(`"${file.name}": ${uploadError.message}`);
							return;
						}

						const { data: publicUrlData } = supabaseAdmin.storage
							.from('trabajos_galeria')
							.getPublicUrl(fileName);

						const itemTitle = files.length > 1 && titulo
							? `${titulo} (${index + 1})`
							: (titulo || `Trabajo realizado - ${categoria}`);

						const { error: dbError } = await supabaseAdmin
							.from('trabajos_galeria')
							.insert({
								titulo: itemTitle,
								imagen_url: publicUrlData.publicUrl,
								storage_path: fileName,
								categoria: categoria,
								activo: true
							});

						if (dbError) {
							console.error(`[DB Insert Error on ${file.name}]`, dbError);
							await supabaseAdmin.storage.from('trabajos_galeria').remove([fileName]);
							errors.push(`"${file.name}": Error RLS/BD (${dbError.message})`);
						} else {
							uploadedCount++;
						}
					} catch(err: any) {
						errors.push(`"${file.name}": ${err?.message || 'Error inesperado'}`);
					}
				})
			);

			if (errors.length > 0 && uploadedCount === 0) {
				const isRlsError = errors.some(e => e.toLowerCase().includes('row-level security') || e.toLowerCase().includes('violates row-level security'));
				if (isRlsError) {
					notification = 'Error RLS en Supabase: Las políticas RLS de la tabla bloquean la inserción. Solución: Ejecuta el script SQL "trabajos_galeria_schema.sql" en el SQL Editor de tu proyecto Supabase o añade SUPABASE_SERVICE_ROLE_KEY en las variables de entorno de Vercel.';
				} else {
					notification = 'Error al cargar las imágenes: ' + errors.join(' | ');
				}
			} else if (errors.length > 0) {
				const encodedErrors = encodeURIComponent(errors.join(' | '));
				return Astro.redirect(`/meson-servitecnology-st?tab=galeria&success=${uploadedCount}&errors=${encodedErrors}`);
			} else {
				return Astro.redirect(`/meson-servitecnology-st?tab=galeria&success=${uploadedCount}`);
			}
		} else {
			notification = 'Por favor selecciona al menos una imagen válida para subir.';
		}
	}

	if (action === 'toggle_galeria' && id) {
		const currentActivo = formData.get('activo')?.toString() === 'true';
		await supabaseAdmin.from('trabajos_galeria').update({ activo: !currentActivo }).eq('id', id);
		return Astro.redirect('/meson-servitecnology-st?tab=galeria');
	}

	if (action === 'delete_galeria' && id) {
		const storagePath = formData.get('storage_path')?.toString();
		if (storagePath) {
			await supabaseAdmin.storage.from('trabajos_galeria').remove([storagePath]);
		}
		await supabaseAdmin.from('trabajos_galeria').delete().eq('id', id);
		return Astro.redirect('/meson-servitecnology-st?tab=galeria');
	}
}

// Fetch all products
let items: any[] = [];
try {
	const { data: products } = await supabaseAdmin
		.from('repuestos_productos')
		.select('*')
		.order('created_at', { ascending: false });
	items = products ?? [];
} catch (e: any) {
	console.error('[Admin] Supabase fetch error:', e?.message);
}

// Fetch galeria items
let galeriaItems: any[] = [];
try {
	const { data: galeria } = await supabaseAdmin
		.from('trabajos_galeria')
		.select('*')
		.order('created_at', { ascending: false });
	galeriaItems = galeria ?? [];
} catch (e) {}

// Fetch metrics
let metrics: any[] = [];
try {
	const { data } = await supabaseAdmin.from('metricas_eventos').select('*');
	metrics = data ?? [];
} catch(e) {}

const totalVisitas = metrics.filter(m => m.tipo_evento === 'visita_pagina').length;
const totalWaClicks = metrics.filter(m => m.tipo_evento === 'clic_boton' && m.elemento_id?.startsWith('btn_whatsapp')).length;

const clicks = metrics.filter(m => m.tipo_evento === 'clic_boton' && m.elemento_id);
const elementCounts = clicks.reduce((acc, curr) => {
	acc[curr.elemento_id] = (acc[curr.elemento_id] || 0) + 1;
	return acc;
}, {} as Record<string, number>);
const topSection = Object.keys(elementCounts).sort((a,b) => elementCounts[b] - elementCounts[a])[0] || 'N/A';

const urlObj = Astro.url;
const activeTab = urlObj.searchParams.get('tab') || 'inventario';
const successParam = urlObj.searchParams.get('success');
const errorsParam = urlObj.searchParams.get('errors');

const successMsg = successParam ? `¡Se cargaron exitosamente ${successParam} foto(s) a la galería!` : '';
const partialErrorsMsg = errorsParam ? decodeURIComponent(errorsParam) : '';
---

<html lang="es">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />
	<meta name="robots" content="noindex, nofollow" />
	<title>SERVITECNOLOGY Admin — Dashboard</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
	<style>
		* { margin: 0; padding: 0; box-sizing: border-box; }
		body { font-family: 'Inter', sans-serif; background: #09090b; color: #e2e8f0; min-height: 100vh; }
		.topbar { background: rgba(24,24,27,0.9); border-bottom: 1px solid rgba(255,255,255,0.05); padding: 1rem 2rem; display: flex; align-items: center; justify-content: space-between; backdrop-filter: blur(12px); position: sticky; top: 0; z-index: 50; }
		.brand { font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 1.25rem; background: linear-gradient(to right, #00FF7F, #00CFFF); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
		.topbar-actions { display: flex; gap: 0.75rem; align-items: center; }
		.btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.5rem 1rem; border-radius: 0.5rem; font-size: 0.75rem; font-weight: 600; text-decoration: none; cursor: pointer; transition: all 0.2s; border: none; }
		.btn-primary { background: linear-gradient(to right, #00CFFF, #00FF7F); color: black; }
		.btn-primary:hover { opacity: 0.9; }
		.btn-outline { background: transparent; border: 1px solid rgba(255,255,255,0.1); color: #94a3b8; }
		.btn-outline:hover { border-color: #00CFFF; color: #00CFFF; }
		.btn-danger { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.2); color: #f87171; }
		.btn-danger:hover { background: #ef4444; color: white; }
		.container { max-width: 1200px; margin: 0 auto; padding: 2rem; }
		.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
		.stat-card { background: rgba(24,24,27,0.6); border: 1px solid rgba(255,255,255,0.05); border-radius: 0.75rem; padding: 1.5rem; }
		.stat-value { font-family: 'Outfit', sans-serif; font-size: 2rem; font-weight: 800; color: white; }
		.stat-label { font-size: 0.7rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.25rem; }
		.table-wrap { background: rgba(24,24,27,0.6); border: 1px solid rgba(255,255,255,0.05); border-radius: 0.75rem; overflow: hidden; }
		table { width: 100%; border-collapse: collapse; }
		th { text-align: left; padding: 0.75rem 1rem; font-size: 0.65rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid rgba(255,255,255,0.05); background: rgba(0,0,0,0.3); }
		td { padding: 0.75rem 1rem; font-size: 0.8rem; border-bottom: 1px solid rgba(255,255,255,0.03); vertical-align: middle; }
		tr:hover td { background: rgba(255,255,255,0.02); }
		.sku { font-family: monospace; color: #00CFFF; font-size: 0.7rem; }
		.stock-yes { color: #00FF7F; }
		.stock-no { color: #f87171; }
		.thumb { width: 44px; height: 44px; border-radius: 0.375rem; object-fit: cover; border: 1px solid rgba(255,255,255,0.1); }
		.empty { text-align: center; padding: 4rem 2rem; color: #64748b; }
		.empty-icon { font-size: 3rem; margin-bottom: 1rem; }
		.actions-cell { display: flex; gap: 0.4rem; align-items: center; }
		.search-bar { width: 100%; padding: 1rem; margin-bottom: 1.5rem; background: rgba(24,24,27,0.6); border: 1px solid rgba(255,255,255,0.05); border-radius: 0.75rem; color: white; font-family: 'Inter', sans-serif; }
		.search-bar:focus { outline: none; border-color: #00CFFF; }
		.section-title { font-family: 'Outfit', sans-serif; font-size: 1.25rem; font-weight: 700; color: white; margin-bottom: 1rem; margin-top: 1rem; }
		
		/* Tabs UI */
		.tabs-nav { display: flex; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); margin-bottom: 1.5rem; }
		.tab-btn { padding: 0.75rem 1.25rem; font-weight: 700; font-size: 0.9rem; color: #94a3b8; border-bottom: 2px solid transparent; cursor: pointer; text-decoration: none; transition: all 0.2s; }
		.tab-btn.active { color: #00CFFF; border-bottom-color: #00CFFF; }
		
		/* Upload Box */
		.upload-box { background: rgba(24,24,27,0.8); border: 1px dashed rgba(0,207,255,0.3); border-radius: 0.75rem; padding: 1.5rem; margin-bottom: 2rem; }
		.form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-top: 1rem; }
		.form-group { display: flex; flex-direction: column; gap: 0.4rem; }
		.form-group label { font-size: 0.75rem; color: #94a3b8; font-weight: 600; }
		.form-group input, .form-group select { background: #18181b; border: 1px solid rgba(255,255,255,0.1); border-radius: 0.5rem; padding: 0.6rem; color: white; font-size: 0.85rem; }
		.form-group input:focus, .form-group select:focus { outline: none; border-color: #00CFFF; }

		/* Galería Grid */
		.galeria-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.25rem; margin-top: 1.5rem; }
		.galeria-card { background: rgba(24,24,27,0.8); border: 1px solid rgba(255,255,255,0.08); border-radius: 0.75rem; overflow: hidden; display: flex; flex-direction: column; transition: all 0.2s; }
		.galeria-card:hover { border-color: rgba(0,207,255,0.4); transform: translateY(-2px); }
		.galeria-img-wrap { height: 160px; overflow: hidden; position: relative; }
		.galeria-img { width: 100%; height: 100%; object-fit: cover; }
		.galeria-badge { position: absolute; top: 0.5rem; left: 0.5rem; background: rgba(0,0,0,0.75); border: 1px solid rgba(255,255,255,0.2); color: #00CFFF; font-size: 0.65rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 0.375rem; }
		.galeria-status { position: absolute; top: 0.5rem; right: 0.5rem; font-size: 0.65rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 0.375rem; }
		.status-active { background: rgba(0,255,127,0.2); color: #00FF7F; border: 1px solid rgba(0,255,127,0.3); }
		.status-hidden { background: rgba(248,113,113,0.2); color: #f87171; border: 1px solid rgba(248,113,113,0.3); }
		.galeria-body { padding: 1rem; flex: 1; display: flex; flex-direction: column; justify-content: space-between; gap: 0.75rem; }
		.galeria-title { font-size: 0.85rem; font-weight: 600; color: white; }

		@media (max-width: 768px) {
			.hide-mobile { display: none; }
			td, th { padding: 0.5rem; font-size: 0.7rem; }
		}
	</style>
</head>
<body>
	<div class="topbar">
		<span class="brand">SERVITECNOLOGY Admin</span>
		<div class="topbar-actions">
			<a href="/meson-servitecnology-st/nuevo" class="btn btn-primary">+ Nuevo Producto</a>
			<a href="/" class="btn btn-outline">Ver Sitio</a>
			<a href="/meson-servitecnology-st/logout" class="btn btn-outline">Cerrar sesión</a>
		</div>
	</div>

	<div class="container">
		<div id="clientNoticeBox" style="display:none; padding:1rem; border-radius:0.75rem; margin-bottom:1.5rem; font-size:0.85rem; line-height:1.5;"></div>

		{notification && (
			<div style="background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.3); color: #f87171; padding: 1rem; border-radius: 0.75rem; margin-bottom: 1.5rem; font-size: 0.85rem; line-height: 1.5;">
				⚠️ {notification}
			</div>
		)}

		{successMsg && (
			<div style="background: rgba(0,255,127,0.15); border: 1px solid rgba(0,255,127,0.3); color: #00FF7F; padding: 1rem; border-radius: 0.75rem; margin-bottom: 1.5rem; font-size: 0.85rem; font-weight: 600;">
				✅ {successMsg}
			</div>
		)}

		{partialErrorsMsg && (
			<div style="background: rgba(234,179,8,0.15); border: 1px solid rgba(234,179,8,0.3); color: #facc15; padding: 1rem; border-radius: 0.75rem; margin-bottom: 1.5rem; font-size: 0.85rem;">
				⚠️ Advertencia en algunas fotos: {partialErrorsMsg}
			</div>
		)}

		<!-- Metrics Dashboard -->
		<h2 class="section-title">Panel de Analíticas</h2>
		<div class="stats" style="border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 2rem;">
			<div class="stat-card">
				<div class="stat-value text-brand-cyan">{totalVisitas}</div>
				<div class="stat-label">Visitas Únicas / Páginas Vistas</div>
			</div>
			<div class="stat-card">
				<div class="stat-value text-brand-green">{totalWaClicks}</div>
				<div class="stat-label">Clics a WhatsApp (Conversiones)</div>
			</div>
			<div class="stat-card">
				<div class="stat-value" style="font-size: 1.5rem;">{topSection}</div>
				<div class="stat-label">Sección Top Interactuada</div>
			</div>
		</div>

		<!-- Main Navigation Tabs -->
		<div class="tabs-nav">
			<a href="/meson-servitecnology-st?tab=inventario" class={`tab-btn ${activeTab === 'inventario' ? 'active' : ''}`}>
				📦 Inventario de Repuestos ({items.length})
			</a>
			<a href="/meson-servitecnology-st?tab=galeria" class={`tab-btn ${activeTab === 'galeria' ? 'active' : ''}`}>
				🖼️ Galería de Trabajos / Clientes Satisfechos ({galeriaItems.length})
			</a>
		</div>

		<!-- TAB 1: INVENTARIO -->
		{activeTab === 'inventario' && (
			<div>
				<div class="stats">
					<div class="stat-card">
						<div class="stat-value">{items.length}</div>
						<div class="stat-label">Productos totales</div>
					</div>
					<div class="stat-card">
						<div class="stat-value" style="color: #00FF7F;">{items.filter(p => p.stock_cantidad > 0).length}</div>
						<div class="stat-label">Con stock</div>
					</div>
					<div class="stat-card">
						<div class="stat-value" style="color: #f87171;">{items.filter(p => p.stock_cantidad <= 0).length}</div>
						<div class="stat-label">Sin stock</div>
					</div>
				</div>

				<input type="text" id="searchInput" class="search-bar" placeholder="🔍 Buscar por nombre, SKU o categoría..." />

				<div class="table-wrap">
					{items.length === 0 ? (
						<div class="empty">
							<div class="empty-icon">📦</div>
							<p>No hay productos registrados.</p>
							<p style="margin-top: 0.5rem;"><a href="/meson-servitecnology-st/nuevo" class="btn btn-primary" style="display: inline-flex; margin-top: 1rem;">+ Crear primer producto</a></p>
						</div>
					) : (
						<table>
							<thead>
								<tr>
									<th>Img</th>
									<th>SKU</th>
									<th>Título</th>
									<th class="hide-mobile">Categoría</th>
									<th class="hide-mobile">Precio</th>
									<th>Stock</th>
									<th class="hide-mobile">Fecha</th>
									<th>Acciones</th>
								</tr>
							</thead>
							<tbody id="tableBody">
								{items.map(p => (
									<tr class="product-row" data-search={`${p.sku} ${p.titulo} ${p.categoria}`.toLowerCase()}>
										<td>
											{p.imagenes?.[0] ? (
												<img src={p.imagenes[0]} alt="" class="thumb" />
											) : (
												<div class="thumb" style="background: #27272a; display:flex; align-items:center; justify-content:center; font-size:0.7rem; color:#64748b;">—</div>
											)}
										</td>
										<td><span class="sku">{p.sku}</span></td>
										<td>{p.titulo}</td>
										<td class="hide-mobile">{p.categoria}</td>
										<td class="hide-mobile">${p.precio_venta?.toLocaleString('es-CL')}</td>
										<td>
											{p.stock_cantidad > 0 ? (
												<span class="stock-yes">● {p.stock_cantidad} uds</span>
											) : (
												<span class="stock-no">● Agotado</span>
											)}
										</td>
										<td class="hide-mobile">{new Date(p.created_at).toLocaleDateString('es-CL')}</td>
										<td>
											<div class="actions-cell">
												<a href={`/meson-servitecnology-st/editar/${p.id}`} class="btn btn-outline" style="padding:0.35rem 0.6rem;">Editar</a>
												<form method="POST" style="display:inline;" onsubmit="return confirm('¿Eliminar este producto?');">
													<input type="hidden" name="action" value="delete" />
													<input type="hidden" name="id" value={p.id} />
													<button type="submit" class="btn btn-danger" style="padding:0.35rem 0.6rem;">Eliminar</button>
												</form>
											</div>
										</td>
									</tr>
								))}
							</tbody>
						</table>
					)}
				</div>
			</div>
		)}

		<!-- TAB 2: GALERÍA DE TRABAJOS Y CLIENTES SATISFECHOS -->
		{activeTab === 'galeria' && (
			<div>
				<!-- Upload Box -->
				<div class="upload-box">
					<h3 style="font-family:'Outfit',sans-serif; font-size:1.1rem; color:white; font-weight:700;">
						📸 Cargar Fotos a la Galería (Server Action / API Route Upload)
					</h3>
					<p style="font-size:0.8rem; color:#94a3b8; margin-top:0.2rem;">
						Las imágenes son enviadas al servidor en lote y procesadas con el cliente Admin (Service Role) omitiendo políticas RLS.
					</p>

					<form method="POST" enctype="multipart/form-data" id="galeriaUploadForm">
						<input type="hidden" name="action" value="upload_galeria" />
						<div class="form-grid">
							<div class="form-group">
								<label for="imagen">Seleccionar Imagen(es) (JPG, PNG, WEBP)</label>
								<input type="file" id="imagen" name="imagen" accept="image/*" multiple required />
								<p id="fileCountText" style="font-size:0.75rem; color:#00CFFF; margin-top:0.4rem; font-weight:600; display:none;"></p>
							</div>
							<div class="form-group">
								<label for="categoria">Categoría del Servicio</label>
								<select id="categoria" name="categoria" required>
									<option value="Redes">Redes (/redes)</option>
									<option value="CCTV">CCTV (/cctv)</option>
									<option value="Soporte">Soporte Técnico (/soporte)</option>
									<option value="Impresoras">Impresoras (/impresoras)</option>
									<option value="Gaming">Gaming / Modding (/gaming)</option>
									<option value="Desarrollo">Desarrollo Web (/desarrollo)</option>
								</select>
							</div>
							<div class="form-group">
								<label for="titulo">Título / Descripción corta (opcional)</label>
								<input type="text" id="titulo" name="titulo" placeholder="Ej: Cableado estructurado oficina 12 puntos" />
							</div>
						</div>
						<div style="margin-top: 1.25rem; display:flex; align-items:center; gap:1rem;">
							<button type="submit" id="uploadBtn" class="btn btn-primary" style="padding: 0.65rem 1.25rem; font-size:0.85rem;">
								⬆️ Enviar al Servidor / Subir Fotos
							</button>
							<span id="uploadSpinner" style="display:none; font-size:0.8rem; color:#00CFFF; font-weight:600;">
								⏳ Enviando archivos al Servidor Admin API... por favor espera.
							</span>
						</div>
					</form>
				</div>

				<!-- Galería List Grid -->
				<h3 class="section-title">Fotos Subidas por Categoría (Mostrando las 10 más recientes por sección)</h3>
				{galeriaItems.length === 0 ? (
					<div class="empty table-wrap">
						<div class="empty-icon">🖼️</div>
						<p>Aún no has subido fotos personalizadas a la galería.</p>
						<p style="font-size:0.75rem; margin-top:0.4rem; color:#64748b;">(Actualmente las páginas están desplegando las imágenes por defecto de cada categoría).</p>
					</div>
				) : (
					<div class="galeria-grid">
						{galeriaItems.map(item => (
							<div class="galeria-card">
								<div class="galeria-img-wrap">
									<img src={item.imagen_url} alt={item.titulo} class="galeria-img" />
									<span class="galeria-badge">{item.categoria}</span>
									<span class={`galeria-status ${item.activo ? 'status-active' : 'status-hidden'}`}>
										{item.activo ? '● Activo' : '○ Oculto'}
									</span>
								</div>
								<div class="galeria-body">
									<div class="galeria-title">{item.titulo || `Trabajo ${item.categoria}`}</div>
									<div class="actions-cell" style="justify-content: space-between; margin-top:auto;">
										<form method="POST" style="margin:0;">
											<input type="hidden" name="action" value="toggle_galeria" />
											<input type="hidden" name="id" value={item.id} />
											<input type="hidden" name="activo" value={item.activo ? 'true' : 'false'} />
											<button type="submit" class="btn btn-outline" style="padding:0.3rem 0.6rem;">
												{item.activo ? 'Ocultar' : 'Mostrar'}
											</button>
										</form>
										<form method="POST" style="margin:0;" onsubmit="return confirm('¿Eliminar esta foto permanentemente del almacenamiento y la base de datos?');">
											<input type="hidden" name="action" value="delete_galeria" />
											<input type="hidden" name="id" value={item.id} />
											<input type="hidden" name="storage_path" value={item.storage_path} />
											<button type="submit" class="btn btn-danger" style="padding:0.3rem 0.6rem;">
												Eliminar
											</button>
										</form>
									</div>
								</div>
							</div>
						))}
					</div>
				)}
			</div>
		)}
	</div>

	<script>
		// Real-time search filter for Inventory
		const searchInput = document.getElementById('searchInput');
		const rows = document.querySelectorAll('.product-row');

		if (searchInput) {
			searchInput.addEventListener('input', (e) => {
				const term = (e.target as HTMLInputElement).value.toLowerCase();
				rows.forEach(row => {
					const searchData = row.getAttribute('data-search') || '';
					if (searchData.includes(term)) {
						(row as HTMLElement).style.display = '';
					} else {
						(row as HTMLElement).style.display = 'none';
					}
				});
			});
		}

		// Multi-file selection feedback & AJAX Server Endpoint Submission
		const fileInput = document.getElementById('imagen') as HTMLInputElement;
		const fileCountText = document.getElementById('fileCountText');
		const form = document.getElementById('galeriaUploadForm') as HTMLFormElement;
		const uploadBtn = document.getElementById('uploadBtn') as HTMLButtonElement;
		const uploadSpinner = document.getElementById('uploadSpinner');
		const clientNoticeBox = document.getElementById('clientNoticeBox');

		if (fileInput) {
			fileInput.addEventListener('change', () => {
				if (fileInput.files && fileInput.files.length > 0) {
					if (fileCountText) {
						fileCountText.textContent = `📁 ${fileInput.files.length} archivo(s) seleccionado(s) listos para enviar al servidor.`;
						fileCountText.style.display = 'block';
					}
				} else {
					if (fileCountText) fileCountText.style.display = 'none';
				}
			});
		}

		if (form && uploadBtn && uploadSpinner) {
			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				uploadBtn.disabled = true;
				uploadBtn.style.opacity = '0.6';
				uploadSpinner.style.display = 'inline-block';
				if (clientNoticeBox) clientNoticeBox.style.display = 'none';

				try {
					const formData = new FormData(form);
					const response = await fetch('/api/admin/galeria/upload', {
						method: 'POST',
						body: formData
					});
					const result = await response.json();

					if (result.success) {
						window.location.href = `/meson-servitecnology-st?tab=galeria&success=${result.uploadedCount}`;
					} else {
						if (clientNoticeBox) {
							clientNoticeBox.style.display = 'block';
							clientNoticeBox.style.background = 'rgba(239,68,68,0.15)';
							clientNoticeBox.style.border = '1px solid rgba(239,68,68,0.3)';
							clientNoticeBox.style.color = '#f87171';
							clientNoticeBox.innerHTML = `⚠️ ${result.message || 'Error procesando la subida.'}`;
						}
						uploadBtn.disabled = false;
						uploadBtn.style.opacity = '1';
						uploadSpinner.style.display = 'none';
					}
				} catch (err: any) {
					if (clientNoticeBox) {
						clientNoticeBox.style.display = 'block';
						clientNoticeBox.style.background = 'rgba(239,68,68,0.15)';
						clientNoticeBox.style.border = '1px solid rgba(239,68,68,0.3)';
						clientNoticeBox.style.color = '#f87171';
						clientNoticeBox.innerHTML = `⚠️ Error de conexión con el servidor: ${err?.message || 'Error de red'}`;
					}
					uploadBtn.disabled = false;
					uploadBtn.style.opacity = '1';
					uploadSpinner.style.display = 'none';
				}
			});
		}
	</script>
</body>
</html>
