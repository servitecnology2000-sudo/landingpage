	// ─── Acción: Volver a Colores Originales (Restaurar Ambos Fondos) ─────────────────
	async function handleResetOriginal() {
		let confirmado = false;
		if (window.showAdminConfirm) {
			confirmado = await window.showAdminConfirm({
				title: '¿Volver a colores originales?',
				message: 'Esta acción desactivará cualquier fondo personalizado tanto en la búsqueda como en el carrusel, devolviendo ambas áreas a su diseño original limpio.',
				type: 'warning',
				confirmText: 'Sí, volver a colores originales',
				cancelText: 'Cancelar'
			});
		} else {
			confirmado = confirm('¿Deseas restaurar la apariencia original en la sección de búsqueda y en el carrusel?');
		}

		if (!confirmado) return;

		try {
			const res = await fetch('/api/admin/banners/custom-backgrounds', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ action: 'reset_original' })
			});

			const data = await res.json();
			if (!res.ok || !data.success) {
				throw new Error(data.message || data.error || 'Error al restaurar diseño original.');
			}

			if (window.showAdminToast) {
				window.showAdminToast('Colores y apariencia original restaurados exitosamente', 'success');
			}

			setTimeout(() => window.location.reload(), 700);
		} catch (err) {
			console.error('[Reset Original Error]', err);
			if (window.showAdminAlert) {
				await window.showAdminAlert({
					title: 'Error de restauración',
					message: err.message || 'No fue posible volver a los colores originales.',
					type: 'danger'
				});
			} else {
				alert(err.message || 'Error al restaurar diseño.');
			}
		}
	}

	document.getElementById('btnResetOriginalColors')?.addEventListener('click', handleResetOriginal);
