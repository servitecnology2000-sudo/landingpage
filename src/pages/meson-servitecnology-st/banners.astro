---
export const prerender = false;

// 1. Guardia de Seguridad SSR Inmediato en cabecera de página (Previene ResponseSentError)
const _env = typeof process !== 'undefined' ? process.env : ({} as Record<string, string>);
const adminSecret = _env['ADMIN_SECRET'] || import.meta.env.ADMIN_SECRET || '20181860';
const cookie = Astro.cookies.get('admin_session');
if (!adminSecret || cookie?.value !== adminSecret) {
	return Astro.redirect('/meson-servitecnology-st/login');
}

import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabaseAdmin } from '../../lib/supabase';
import { formatDateTime } from '../../lib/dates';

// 2. Obtención SSR de todos los banners exclusivos de /repuestos
let banners: any[] = [];
let fetchWarning = '';

try {
	const { data, error } = await supabaseAdmin
		.from('hero_banners')
		.select('*')
		.eq('seccion', 'repuestos')
		.order('orden', { ascending: true })
		.order('created_at', { ascending: false });

	if (error) {
		fetchWarning = error.message;
		console.warn('[Admin Banners] Advertencia al consultar hero_banners:', error.message);
	} else {
		banners = data || [];
	}
} catch (e: any) {
	fetchWarning = e?.message || 'Error de conexión con la base de datos.';
}

const totalBanners = banners.length;
const activeBanners = banners.filter(b => b.activo).length;
const pausedBanners = banners.filter(b => !b.activo).length;

// 3. Fondos Personalizados de /repuestos y Menú Principal Global
let currentSearchBg: string | null = null;
let currentCarouselBg: string | null = null;
let currentMenuBg: string | null = null;

try {
	const { data: bgData } = await supabaseAdmin
		.from('hero_banners')
		.select('*')
		.in('seccion', ['repuestos_fondo_busqueda', 'repuestos_fondo_carrusel', 'menu_principal'])
		.eq('activo', true);

	if (bgData) {
		const sBg = bgData.find(b => b.seccion === 'repuestos_fondo_busqueda');
		const cBg = bgData.find(b => b.seccion === 'repuestos_fondo_carrusel');
		const mBg = bgData.find(b => b.seccion === 'menu_principal');
		if (sBg) currentSearchBg = sBg.imagen_url;
		if (cBg) currentCarouselBg = cBg.imagen_url;
		if (mBg) currentMenuBg = mBg.imagen_url;
	}
} catch (e: any) {
	console.warn('[Admin Banners] Error al consultar fondos personalizados:', e);
}
