						<th class="py-3 px-3">Página / URL</th>
						<th class="py-3 px-3 text-right">Fecha y Hora (Chile)</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-white/5 text-slate-300 font-mono">
					{recentEvents.slice(0, 30).map(e => {
						const isWA = esClicWhatsApp(e.elemento_id);
						const isClick = e.tipo_evento === 'clic_boton';
						const info = etiquetarBoton(e.elemento_id);

						return (
							<tr class="hover:bg-white/[0.02] transition-colors">
								<!-- Tipo de Evento -->
								<td class="py-3 px-3 whitespace-nowrap">
									{isWA ? (
										<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
											<span>💬</span> Clic WhatsApp
										</span>
									) : isClick ? (
										<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-purple-500/10 text-purple-300 border border-purple-500/20">
											<span>🖱️</span> Clic Botón
										</span>
									) : (
										<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-medium bg-blue-500/10 text-blue-300 border border-blue-500/20">
											<span>👁️</span> Visita Página
										</span>
									)}
								</td>

								<!-- Elemento / Botón -->
								<td class="py-3 px-3 font-sans text-slate-200">
									{e.elemento_id ? (
										<div>
											<span class="font-medium text-white">{info.label}</span>
											<span class="block text-[10px] font-mono text-slate-500 truncate max-w-xs">{e.elemento_id}</span>
										</div>
									) : (
										<span class="text-slate-600">—</span>
									)}
								</td>

								<!-- URL / Origen -->
								<td class="py-3 px-3 font-sans text-slate-300">
									{e.url_origen ? (
										<a
											href={e.url_origen}
											target="_blank"
											class="text-brand-cyan/90 hover:text-brand-cyan hover:underline truncate inline-block max-w-[240px]"
											title={e.url_origen}
										>
											{e.url_origen}
										</a>
									) : (
										<span class="text-slate-600">—</span>
									)}
								</td>

								<!-- Fecha y Hora -->
								<td class="py-3 px-3 text-right text-slate-400 whitespace-nowrap text-[11px]">
									{formatDateTime(e.creado_en)}
								</td>
							</tr>
						);
					})}
				</tbody>
			</table>
		</div>
	</div>

	<!-- Script de interactividad: Refresco y Simulación de Prueba en Vivo -->
	<script is:inline>
		// 1. Botón de refresco manual
		document.getElementById('btnRecargarFeed')?.addEventListener('click', () => {
			window.location.reload();
		});

		// 2. Simulación de prueba en vivo
		const btnPrueba = document.getElementById('btnSimularPrueba');
		if (btnPrueba) {
			btnPrueba.addEventListener('click', async () => {
				const originalText = btnPrueba.innerHTML;
				btnPrueba.disabled = true;
				btnPrueba.innerHTML = '<span>⏳</span><span>Registrando evento...</span>';

				try {
					const res = await fetch('/api/track', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({
							tipo_evento: 'clic_boton',
							elemento_id: 'btn_whatsapp_flotante',
							url_origen: '/repuestos?test=simulacion_admin'
						})
					});

					if (res.ok) {
						if (window.adminShowToast) {
							window.adminShowToast('¡Evento de prueba registrado con éxito en Supabase!', 'success');
						} else {
							alert('¡Evento de prueba registrado con éxito en Supabase!');
						}
						// Recargar tras 1 segundo para mostrar el nuevo evento en la tabla
						setTimeout(() => {
							window.location.reload();
						}, 1000);
					} else {
						throw new Error('El endpoint devolvió estado ' + res.status);
					}
				} catch (err) {
					console.error('Error al simular evento:', err);
					if (window.adminShowToast) {
						window.adminShowToast('Error al registrar evento: ' + err.message, 'error');
					} else {
						alert('Error al registrar evento: ' + err.message);
					}
					btnPrueba.disabled = false;
					btnPrueba.innerHTML = originalText;
				}
			});
		}
	</script>
</AdminLayout>
