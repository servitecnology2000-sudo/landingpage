export const prerender = false;

// 1. Guardia de Seguridad SSR Inmediato en cabecera de página
const _env = typeof process !== 'undefined' ? process.env : ({} as Record<string, string>);
const _metaEnv = typeof import.meta !== 'undefined' && (import.meta as any).env ? (import.meta as any).env : {};
const adminSecret = _env['ADMIN_SECRET'] || _metaEnv['ADMIN_SECRET'] || '20181860';
const cookie = Astro.cookies.get('admin_session');
if (!adminSecret || cookie?.value !== adminSecret) {
	return Astro.redirect('/meson-servitecnology-st/login');
}

import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabaseAdmin } from '../../lib/supabase';
import { formatDateTime } from '../../lib/dates';

// 2. Parámetro de Período seleccionado
const url = new URL(Astro.request.url);
const validPeriods = ['hoy', '7d', '30d', 'historico'] as const;
type Period = typeof validPeriods[number];
const rawPeriod = (url.searchParams.get('period') as Period) || 'historico';
const currentPeriod: Period = validPeriods.includes(rawPeriod) ? rawPeriod : 'historico';

// 3. Cálculo de fecha de inicio según período
const now = new Date();
let startDateISO: string | null = null;

if (currentPeriod === 'hoy') {
	const startOfDay = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 0, 0, 0);
	startDateISO = startOfDay.toISOString();
} else if (currentPeriod === '7d') {
	const d7 = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
	startDateISO = d7.toISOString();
} else if (currentPeriod === '30d') {
	const d30 = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);
	startDateISO = d30.toISOString();
}

// 4. Consultas a Supabase (con conteo exacto sin el corte de 1.000 filas de PostgREST)
let totalVisitas = 0;
let totalEventosPeriodo = 0;
let clicsBotones: any[] = [];
let recentEvents: any[] = [];
let queryWarning = '';

try {
	// A) Conteo exacto de visitas a páginas
	let qVisitas = supabaseAdmin
		.from('metricas_eventos')
		.select('id', { count: 'exact', head: true })
		.eq('tipo_evento', 'visita_pagina');
	if (startDateISO) qVisitas = qVisitas.gte('creado_en', startDateISO);

	// B) Conteo exacto de todos los eventos del período
	let qTotal = supabaseAdmin
		.from('metricas_eventos')
		.select('id', { count: 'exact', head: true });
	if (startDateISO) qTotal = qTotal.gte('creado_en', startDateISO);

	// C) Todos los clics de botones del período (para filtrar conversiones a WhatsApp y botones top)
	let qClics = supabaseAdmin
		.from('metricas_eventos')
		.select('id, tipo_evento, elemento_id, url_origen, creado_en')
		.eq('tipo_evento', 'clic_boton')
		.order('creado_en', { ascending: false })
		.limit(1000);
	if (startDateISO) qClics = qClics.gte('creado_en', startDateISO);

	// D) Feed de eventos recientes para el desglose de páginas y actividad en vivo
	let qFeed = supabaseAdmin
		.from('metricas_eventos')
		.select('id, tipo_evento, elemento_id, url_origen, creado_en')
		.order('creado_en', { ascending: false })
		.limit(500);
	if (startDateISO) qFeed = qFeed.gte('creado_en', startDateISO);

	const [resVisitas, resTotal, resClics, resFeed] = await Promise.all([
		qVisitas,
		qTotal,
		qClics,
		qFeed
	]);

	if (resVisitas.error) queryWarning = resVisitas.error.message;
	totalVisitas = resVisitas.count || 0;
	totalEventosPeriodo = resTotal.count || 0;
	clicsBotones = resClics.data || [];
	recentEvents = resFeed.data || [];
} catch (err: any) {
	queryWarning = err?.message || 'Error de conexión con la base de datos de analítica.';
}

// 5. Función clasificadora de clics a WhatsApp
function esClicWhatsApp(elementoId: string | null): boolean {
	if (!elementoId) return false;
	const id = elementoId.toLowerCase();
	return (
		id.includes('whatsapp') ||
		id.startsWith('btn_whatsapp') ||
		id.includes('wa.me') ||
		id.includes('cotiza') ||
		id.includes('escribenos')
	);
}

// 6. Métricas derivadas
const eventosWhatsApp = clicsBotones.filter(c => esClicWhatsApp(c.elemento_id));
const totalWhatsApp = eventosWhatsApp.length;
const tasaConversion = totalVisitas > 0 ? ((totalWhatsApp / totalVisitas) * 100).toFixed(2) : '0.00';

// Elemento top interactuado
const conteoElementos: Record<string, number> = {};
clicsBotones.forEach(c => {
	if (c.elemento_id) {
		conteoElementos[c.elemento_id] = (conteoElementos[c.elemento_id] || 0) + 1;
	}
});
const elementoTopEntry = Object.entries(conteoElementos).sort((a, b) => b[1] - a[1])[0];
const elementoTopNombre = elementoTopEntry ? elementoTopEntry[0] : 'Sin interacción';
const elementoTopCount = elementoTopEntry ? elementoTopEntry[1] : 0;

// Desglose de Páginas más visitadas (usando la muestra de eventos recientes del período)
const conteoPaginas: Record<string, number> = {};
recentEvents
	.filter(e => e.tipo_evento === 'visita_pagina' && e.url_origen)
	.forEach(e => {
		const path = e.url_origen.split('?')[0]; // quitar query params
		conteoPaginas[path] = (conteoPaginas[path] || 0) + 1;
	});

const paginasTop = Object.entries(conteoPaginas)
	.sort((a, b) => b[1] - a[1])
	.slice(0, 8)
	.map(([url, count]) => {
		const totalMuestra = Object.values(conteoPaginas).reduce((acc, c) => acc + c, 0) || 1;
		return {
			url,
			count,
			pct: ((count / totalMuestra) * 100).toFixed(1)
		};
	});

// Desglose de orígenes de clic a WhatsApp
const conteoCanalesWA: Record<string, number> = {};
eventosWhatsApp.forEach(e => {
	const key = e.elemento_id || 'WhatsApp (General)';
	conteoCanalesWA[key] = (conteoCanalesWA[key] || 0) + 1;
});
const canalesWATop = Object.entries(conteoCanalesWA)
	.sort((a, b) => b[1] - a[1])
	.map(([btn, count]) => ({
		btn,
		count,
		pct: totalWhatsApp > 0 ? ((count / totalWhatsApp) * 100).toFixed(1) : '0'
	}));

// Formateador amigable de nombres de botones
function etiquetarBoton(rawId: string): { label: string; badge: string; isWA: boolean } {
	if (!rawId) return { label: 'General / No especificado', badge: 'neutral', isWA: false };
	if (rawId === 'btn_whatsapp_flotante') return { label: 'Botón Flotante WhatsApp', badge: 'whatsapp', isWA: true };
	if (rawId === 'btn_whatsapp_footer') return { label: 'Pie de Página (Footer)', badge: 'whatsapp', isWA: true };
	if (rawId.startsWith('btn_whatsapp_producto_')) {
		const sku = rawId.replace('btn_whatsapp_producto_', '');
		return { label: `WhatsApp Producto (SKU: ${sku})`, badge: 'whatsapp', isWA: true };
	}
	if (rawId === 'btn_hero_escribenos') return { label: 'Hero: "Escríbenos"', badge: 'whatsapp', isWA: true };
	if (rawId === 'btn_repuestos_cotiza_servicio') return { label: 'Banner: "Cotizar Servicio"', badge: 'whatsapp', isWA: true };
	if (rawId === 'btn_hero_servicios') return { label: 'Hero: Ver Servicios', badge: 'click', isWA: false };
	if (rawId === 'btn_hero_repuestos') return { label: 'Hero: Ver Repuestos', badge: 'click', isWA: false };
	if (rawId === 'btn_hero_software') return { label: 'Hero: Software & SaaS', badge: 'click', isWA: false };
	if (rawId === 'btn_repuestos_ver_catalogo') return { label: 'Repuestos: Catálogo', badge: 'click', isWA: false };
	if (rawId.startsWith('seccion_servicios_')) {
		const nombre = rawId.replace('seccion_servicios_', '').replace(/_/g, ' ');
		return { label: `Servicio: ${nombre}`, badge: 'click', isWA: false };
	}
	return { label: rawId, badge: 'click', isWA: rawId.toLowerCase().includes('whatsapp') };
}
