					<span>🔄</span>
					<span>Refrescar</span>
				</button>
			</div>
		</div>

		<div class="overflow-x-auto">
			<table class="w-full text-left text-xs border-collapse">
				<thead>
					<tr class="border-b border-white/10 text-slate-400 font-mono text-[11px] uppercase tracking-wider">
