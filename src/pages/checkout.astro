---

<Layout 
	title="Checkout Seguro | SERVITECNOLOGY E-commerce" 
	description="Finaliza tu compra de repuestos y hardware técnico con Mercado Pago o Transferencia. Envíos a todo Chile bajo modalidad cobro en destino y retiro en oficina."
	keywords="checkout servitecnology, comprar repuestos st, mercado pago, cobro en destino, envio starken chilexpress"
>
	<Header />

	<main class="relative bg-black min-h-screen py-14 border-b border-white/5">
		<!-- Background Ambient Glows -->
		<div class="absolute top-1/4 left-1/4 -translate-x-1/2 -translate-y-1/2 w-[450px] h-[450px] bg-brand-cyan/5 rounded-full blur-[140px] pointer-events-none"></div>
		<div class="absolute bottom-1/4 right-1/4 translate-x-1/2 translate-y-1/2 w-[450px] h-[450px] bg-brand-green/5 rounded-full blur-[140px] pointer-events-none"></div>

		<div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 w-full">
			<!-- Breadcrumb / Back Link -->
			<div class="mb-8">
				<a href="/repuestos" class="inline-flex items-center gap-2 text-xs font-semibold text-slate-400 hover:text-brand-cyan transition-colors">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
					Volver al Catálogo de Repuestos
				</a>
			</div>

			<!-- Page Header with User State Badge -->
			<div class="flex items-center justify-between flex-wrap gap-4 mb-8 pb-6 border-b border-white/10">
				<div>
					<div class="flex items-center gap-2">
						<span class="text-[11px] font-extrabold uppercase tracking-widest text-brand-green bg-brand-green/10 border border-brand-green/20 px-3 py-1 rounded-full">
							MVP E-commerce Automatizado
						</span>
						<span class="text-[11px] font-bold text-slate-400 bg-white/5 border border-white/10 px-2.5 py-0.5 rounded-full">
							Fase 1: Auth & Datos
						</span>
					</div>
					<h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-white tracking-tight mt-3">
						Checkout & Datos de Envío
					</h1>
				</div>
			</div>

			<!-- Google OAuth Optional Persuasion Banner (Modo Invitado Activo) -->
			<div id="google-login-banner" class="mb-8 p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-brand-cyan/15 via-zinc-950 to-brand-green/10 border border-brand-cyan/30 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-[0_0_30px_rgba(0,207,255,0.1)]">
				<div class="flex items-start sm:items-center gap-3.5">
					<div class="w-10 h-10 rounded-xl bg-brand-cyan/20 border border-brand-cyan/30 flex items-center justify-center text-lg shrink-0">
						💡
					</div>
					<div>
						<p class="text-xs sm:text-sm font-bold text-white leading-snug">
							¿Tienes cuenta? Ingresa con Google para autorellenar tus datos.
						</p>
						<p class="text-[11px] sm:text-xs text-slate-300 mt-0.5">
							Si creas tu cuenta podrás tener y ver el historial de tus compras y hacer seguimiento en vivo.
						</p>
					</div>
				</div>
				<div class="flex items-center gap-2 shrink-0 w-full sm:w-auto">
					<button 
						type="button" 
						id="btn-quick-google-login" 
						class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-white hover:bg-slate-100 text-slate-900 font-bold text-xs flex items-center justify-center gap-2 shadow-md hover:shadow-lg transition-all cursor-pointer"
					>
						<svg class="w-4 h-4" viewBox="0 0 24 24">
							<path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.8 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.4 9 5 12 5z"/>
							<path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.8z"/>
							<path fill="#FBBC05" d="M5.6 14.8c-.2-.7-.4-1.5-.4-2.8s.2-2.1.4-2.8L1.9 6.3C.7 8.7 0 10.3 0 12s.7 3.3 1.9 5.7l3.7-2.9z"/>
							<path fill="#34A853" d="M12 23c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2-6.4-4.8L1.9 16.4C3.7 20.1 7.5 23 12 23z"/>
						</svg>
						<span>Acceder con Google</span>
					</button>
				</div>
			</div>

			<!-- User Authenticated State Banner (Hidden by default, shown when user logs in) -->
			<div id="user-logged-banner" class="hidden mb-8 p-4 rounded-2xl bg-brand-green/10 border border-brand-green/30 flex items-center justify-between flex-wrap gap-3">
				<div class="flex items-center gap-3">
					<div class="w-8 h-8 rounded-full bg-brand-green/20 border border-brand-green/40 flex items-center justify-center text-sm">
						✅
					</div>
					<div>
						<span class="text-xs font-bold text-white flex items-center gap-2">
							Sesión activa: <span id="logged-user-name" class="text-brand-green font-bold">Usuario</span>
						</span>
						<p class="text-[10px] text-slate-400">Tus datos quedarán vinculados a tu cuenta para registrar esta compra en tu historial.</p>
					</div>
				</div>
				<div class="flex items-center gap-2">
					<button type="button" id="btn-logout" class="text-xs text-red-400 hover:text-red-300 px-3 py-1.5 rounded-lg bg-red-500/10 hover:bg-red-500/20 transition-colors cursor-pointer">
						Cerrar Sesión
					</button>
				</div>
			</div>

			<!-- Form Container -->
			<form id="checkout-form" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
				
				<!-- Left Column: Delivery & Shipping Data (7 Cols) -->
				<div class="lg:col-span-7 space-y-6">
					
					<!-- Section 1: Delivery Mode (Cobro en Destino / Retiro) -->
					<div class="p-6 rounded-2xl bg-zinc-950/70 border border-white/10 backdrop-blur-md space-y-6 shadow-xl">
						<div class="flex items-center justify-between">
							<div class="flex items-center gap-3">
								<span class="w-7 h-7 rounded-full bg-brand-cyan/20 border border-brand-cyan/40 text-brand-cyan text-xs font-bold flex items-center justify-center">1</span>
								<h2 class="text-base sm:text-lg font-bold text-white">Método de Entrega & Despacho</h2>
							</div>
							<span class="text-[11px] text-brand-green bg-brand-green/10 border border-brand-green/20 px-2.5 py-0.5 rounded-full font-mono font-bold">
								Flete $0 en Web
							</span>
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<!-- Option A: Retiro en Oficina -->
							<label class="relative flex flex-col p-4 rounded-xl border-2 cursor-pointer transition-all delivery-option border-brand-green/50 bg-brand-green/5" data-delivery="retiro">
								<input type="radio" name="delivery_type" value="retiro" checked class="hidden" />
								<div class="flex items-center justify-between mb-2">
									<span class="font-bold text-sm text-white flex items-center gap-2">
										<svg class="w-4 h-4 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
										Retiro en Oficina
									</span>
									<span class="text-[11px] font-extrabold text-brand-green bg-brand-green/20 px-2 py-0.5 rounded">GRATIS ($0)</span>
								</div>
								<p class="text-xs text-slate-400 leading-relaxed">
									Retira en nuestra oficina técnica en Santiago Centro previa coordinación y validación.
								</p>
							</label>

							<!-- Option B: Envío por Pagar (Cobro en Destino) -->
							<label class="relative flex flex-col p-4 rounded-xl border-2 cursor-pointer transition-all delivery-option border-white/10 hover:border-white/20 bg-white/5" data-delivery="envio_cobro_destino">
								<input type="radio" name="delivery_type" value="envio_cobro_destino" class="hidden" />
								<div class="flex items-center justify-between mb-2">
									<span class="font-bold text-sm text-white flex items-center gap-2">
										<svg class="w-4 h-4 text-brand-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"></path></svg>
										Envío por Pagar
									</span>
									<span class="text-[11px] font-bold text-brand-cyan bg-brand-cyan/20 px-2 py-0.5 rounded">Cobro en Destino</span>
								</div>
								<p class="text-xs text-slate-400 leading-relaxed">
									Despacho a todo Chile (Starken / Chilexpress). Cancelas el costo del transporte al recibir.
								</p>
							</label>
						</div>

						<!-- Cobro en Destino Fields & Estimaciones -->
						<div id="despacho-fields" class="hidden space-y-4 pt-4 border-t border-white/10">
							
							<!-- Selector de Región -->
							<div>
								<label for="region-select" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
									Región de Destino *
								</label>
								<select id="region-select" name="region" class="w-full px-4 py-3 rounded-xl bg-black/70 border border-white/15 text-white text-sm focus:border-brand-cyan focus:outline-none transition-colors">
									<option value="" disabled selected>Selecciona tu región...</option>
									{REGIONES_CHILE.map(r => (
										<option value={r.id} data-min={r.estimatedMin} data-max={r.estimatedMax}>
											{r.name}
										</option>
									))}
								</select>
							</div>

							<!-- Comuna (Dinámica según región) -->
							<div id="commune-rm-container">
								<label for="commune-select" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
									Comuna de Destino (Región Metropolitana) *
								</label>
								<select id="commune-select" name="commune_rm" class="w-full px-4 py-3 rounded-xl bg-black/70 border border-white/15 text-white text-sm focus:border-brand-cyan focus:outline-none transition-colors">
									<option value="" disabled selected>Selecciona tu comuna...</option>
									{COMUNAS_RM.map(c => (
										<option value={c.name} data-estimated={c.estimated}>
											{c.name} — Estimado: ~${c.estimated.toLocaleString('es-CL')} CLP
										</option>
									))}
								</select>
							</div>

							<div id="commune-manual-container" class="hidden">
								<label for="commune-manual" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
									Ciudad o Comuna en Región *
								</label>
								<input 
									type="text" 
									id="commune-manual" 
									name="commune_manual" 
									placeholder="Ej: Viña del Mar, Concepción, La Serena"
									class="w-full px-4 py-3 rounded-xl bg-black/70 border border-white/15 text-white text-sm focus:border-brand-cyan focus:outline-none transition-colors"
								/>
							</div>

							<!-- Dirección exacta -->
							<div>
								<label for="address-input" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
									Dirección Completa (Calle, Número, Depto / Sucursal Courier) *
								</label>
								<input 
									type="text" 
									id="address-input" 
									name="address" 
									placeholder="Ej: Av. Providencia 1234, Depto 502 (o Sucursal Starken)"
									class="w-full px-4 py-3 rounded-xl bg-black/70 border border-white/15 text-white text-sm focus:border-brand-cyan focus:outline-none transition-colors"
								/>
							</div>

							<!-- Banner Explicativo de Flete Estimado Referencial -->
							<div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-xs text-amber-200 space-y-2">
								<div class="flex items-center gap-2 font-bold text-amber-300">
									<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
									<span>Modalidad Cobro en Destino (Flete por pagar)</span>
								</div>
								<p class="leading-relaxed text-amber-200/90 text-[11px]">
									En esta web pagarás únicamente el valor de los productos seleccionados (<strong class="text-white">$0 flete en el checkout</strong>). 
									El costo del flete mostrado (<span id="estimated-shipping-text" class="font-bold text-white">~$3.990 - $4.990 CLP</span>) es solo un <strong>estimado referencial</strong> que deberás abonar directamente a Starken o Chilexpress al recibir tu encomienda.
								</p>
							</div>

						</div>
					</div>

					<!-- Section 2: Customer Data & SII Tax Invoicing -->
					<div class="p-6 rounded-2xl bg-zinc-950/70 border border-white/10 backdrop-blur-md space-y-6 shadow-xl">
						<div class="flex items-center gap-3">
							<span class="w-7 h-7 rounded-full bg-brand-green/20 border border-brand-green/40 text-brand-green text-xs font-bold flex items-center justify-center">2</span>
							<div>
								<h2 class="text-base sm:text-lg font-bold text-white">Datos del Comprador & Facturación SII</h2>
								<p class="text-xs text-slate-400">Emisión formal con respaldo tributario chileno</p>
							</div>
						</div>

						<!-- SII Invoicing Notice Banner -->
						<div class="p-4 rounded-xl bg-brand-cyan/10 border border-brand-cyan/30 flex items-start gap-3">
							<svg class="w-5 h-5 text-brand-cyan shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
							<div>
								<p class="text-xs font-semibold text-white leading-relaxed">
									Todas las compras incluyen <strong class="text-brand-cyan">Factura Electrónica</strong> conforme a las directrices del Servicio de Impuestos Internos (SII).
								</p>
								<p class="text-[11px] text-slate-400 mt-1">
									Por normativa legal, el RUT es obligatorio. Los datos quedarán vinculados a tu cuenta para futuros pedidos.
								</p>
							</div>
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div>
								<label for="full_name" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
									Nombre y Apellido / Razón Social *
								</label>
								<input 
									type="text" 
									id="full_name" 
									name="full_name" 
									required
									placeholder="Ej: Andrés Muñoz Silva"
									class="w-full px-4 py-3 rounded-xl bg-black/70 border border-white/15 text-white text-sm focus:border-brand-green focus:outline-none transition-colors"
								/>
							</div>

							<div>
								<label for="rut" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
									RUT Chileno (Persona o Empresa) *
								</label>
								<input 
									type="text" 
									id="rut" 
									name="rut" 
									required
									placeholder="Ej: 12.345.678-9"
									class="w-full px-4 py-3 rounded-xl bg-black/70 border border-white/15 text-white text-sm focus:border-brand-green focus:outline-none transition-colors font-mono"
								/>
								<span id="rut-error" class="hidden text-[11px] text-red-400 mt-1 font-medium">RUT inválido. Verifica el dígito verificador.</span>
							</div>

							<div>
								<label for="email" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
									Correo Electrónico (Factura y Resumen) *
								</label>
								<input 
									type="email" 
									id="email" 
									name="email" 
									required
									placeholder="ejemplo@correo.cl"
									class="w-full px-4 py-3 rounded-xl bg-black/70 border border-white/15 text-white text-sm focus:border-brand-green focus:outline-none transition-colors font-mono"
								/>
							</div>

							<div>
								<label for="phone" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
									Teléfono Móvil / WhatsApp *
								</label>
								<input 
									type="tel" 
									id="phone" 
									name="phone" 
									required
									placeholder="Ej: +56 9 1234 5678 o 2 2123 4567"
									class="w-full px-4 py-3 rounded-xl bg-black/70 border border-white/15 text-white text-sm focus:border-brand-green focus:outline-none transition-colors font-mono"
								/>
								<span id="phone-error" class="hidden text-[11px] text-red-400 mt-1 font-medium">Teléfono inválido. Ingresa un celular (+56 9 XXXX XXXX) o teléfono fijo de Chile (9 dígitos).</span>
							</div>
						</div>
					</div>

				</div>

