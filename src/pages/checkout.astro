---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { supabase } from '../lib/supabase';

// Si se recibe ?sku=... o ?id=... se busca el producto en Supabase para compra directa
const skuParam = Astro.url.searchParams.get('sku');
const idParam = Astro.url.searchParams.get('id');

let initialProduct: any = null;

if (skuParam || idParam) {
	try {
		let query = supabase.from('repuestos_productos').select('*');
		if (skuParam) {
			query = query.eq('sku', skuParam);
		} else if (idParam) {
			query = query.eq('id', idParam);
		}
		const { data } = await query.single();
		if (data) {
			initialProduct = data;
		}
	} catch (e) {
		console.error('Error cargando producto en checkout:', e);
	}
}

// Lista oficial de comunas de la Región Metropolitana con tarifas estimadas referenciales (Cobro en Destino)
const COMUNAS_RM = [
	{ name: "Santiago Centro", estimated: 3990 },
	{ name: "Providencia", estimated: 3990 },
	{ name: "Las Condes", estimated: 3990 },
	{ name: "Ñuñoa", estimated: 3990 },
