// Regiones de Chile para envíos nacionales por pagar
const REGIONES_CHILE = [
	{ id: "RM", name: "Región Metropolitana de Santiago", estimatedMin: 3990, estimatedMax: 4990 },
	{ id: "V", name: "Valparaíso (V Región)", estimatedMin: 4990, estimatedMax: 6490 },
	{ id: "VI", name: "O'Higgins (VI Región)", estimatedMin: 4990, estimatedMax: 6490 },
	{ id: "VII", name: "Maule (VII Región)", estimatedMin: 5990, estimatedMax: 7490 },
	{ id: "VIII", name: "Biobío (VIII Región)", estimatedMin: 5990, estimatedMax: 7990 },
	{ id: "XVI", name: "Ñuble (XVI Región)", estimatedMin: 5990, estimatedMax: 7490 },
	{ id: "IX", name: "Araucanía (IX Región)", estimatedMin: 6490, estimatedMax: 8490 },
	{ id: "XIV", name: "Los Ríos (XIV Región)", estimatedMin: 6990, estimatedMax: 8990 },
	{ id: "X", name: "Los Lagos (X Región)", estimatedMin: 6990, estimatedMax: 8990 },
	{ id: "IV", name: "Coquimbo (IV Región)", estimatedMin: 5490, estimatedMax: 6990 },
	{ id: "III", name: "Atacama (III Región)", estimatedMin: 6490, estimatedMax: 8490 },
	{ id: "II", name: "Antofagasta (II Región)", estimatedMin: 7490, estimatedMax: 9990 },
	{ id: "I", name: "Tarapacá (I Región)", estimatedMin: 7990, estimatedMax: 10490 },
	{ id: "XV", name: "Arica y Parinacota (XV Región)", estimatedMin: 8490, estimatedMax: 10990 },
	{ id: "XI", name: "Aysén (XI Región)", estimatedMin: 8990, estimatedMax: 12490 },
	{ id: "XII", name: "Magallanes y Antártica (XII Región)", estimatedMin: 9490, estimatedMax: 12990 }
