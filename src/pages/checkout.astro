<script>
	import { supabase } from '../lib/supabase';
	import { getCart, removeFromCart, updateItemQuantity, clearCart, addToCart } from '../lib/cart';
	import { cleanChileanPhone, isValidChileanPhone, formatChileanPhone } from '../lib/rut';

	// Algoritmo de validación de RUT Chileno (Módulo 11)
	function isValidChileanRut(rutStr: string): boolean {
		if (!rutStr || typeof rutStr !== 'string') return false;
		const clean = rutStr.replace(/[^0-9kK]/g, '').toUpperCase();
		if (clean.length < 8 || clean.length > 9) return false;

		const cuerpo = clean.slice(0, -1);
		const dv = clean.slice(-1);

		let suma = 0;
		let multiplo = 2;

		for (let i = cuerpo.length - 1; i >= 0; i--) {
			suma += parseInt(cuerpo[i], 10) * multiplo;
			multiplo = multiplo < 7 ? multiplo + 1 : 2;
		}

		const dvEsperado = 11 - (suma % 11);
		let dvCalculado = '';
		if (dvEsperado === 11) dvCalculado = '0';
		else if (dvEsperado === 10) dvCalculado = 'K';
		else dvCalculado = dvEsperado.toString();

		return dv === dvCalculado;
	}

	// Formateador visual de RUT (XX.XXX.XXX-X)
	function formatRut(rutStr: string): string {
		const clean = rutStr.replace(/[^0-9kK]/g, '').toUpperCase();
		if (clean.length < 2) return clean;
		const cuerpo = clean.slice(0, -1);
		const dv = clean.slice(-1);
		let formatted = '';
		let count = 0;
		for (let i = cuerpo.length - 1; i >= 0; i--) {
			formatted = cuerpo[i] + formatted;
			count++;
			if (count === 3 && i > 0) {
				formatted = '.' + formatted;
				count = 0;
			}
		}
		return `${formatted}-${dv}`;
	}



	// Elementos DOM
	const deliveryOptions = document.querySelectorAll('.delivery-option');
	const despachoFields = document.getElementById('despacho-fields');
	const regionSelect = document.getElementById('region-select') as HTMLSelectElement;
	const communeRmContainer = document.getElementById('commune-rm-container');
	const communeSelect = document.getElementById('commune-select') as HTMLSelectElement;
	const communeManualContainer = document.getElementById('commune-manual-container');
	const communeManual = document.getElementById('commune-manual') as HTMLInputElement;
	const addressInput = document.getElementById('address-input') as HTMLInputElement;
	const estimatedShippingText = document.getElementById('estimated-shipping-text');

	const fullNameInput = document.getElementById('full_name') as HTMLInputElement;
	const rutInput = document.getElementById('rut') as HTMLInputElement;
	const rutError = document.getElementById('rut-error');
	const emailInput = document.getElementById('email') as HTMLInputElement;
	const phoneInput = document.getElementById('phone') as HTMLInputElement;
	const phoneError = document.getElementById('phone-error');

	const summarySubtotal = document.getElementById('summary-subtotal');
	const summaryShipping = document.getElementById('summary-shipping');
	const summaryTotal = document.getElementById('summary-total');
	const summaryShippingNote = document.getElementById('summary-shipping-note');

	const googleLoginBanner = document.getElementById('google-login-banner');
	const userLoggedBanner = document.getElementById('user-logged-banner');
	const loggedUserName = document.getElementById('logged-user-name');
	const btnQuickGoogleLogin = document.getElementById('btn-quick-google-login');
	const btnLogout = document.getElementById('btn-logout');

	const btnProceedCheckout = document.getElementById('btn-proceed-checkout');
	const btnProceedText = document.getElementById('btn-proceed-text');

	// Modales
	const googleAuthModal = document.getElementById('google-auth-modal');
	const btnModalGoogleLogin = document.getElementById('btn-modal-google-login');
	const btnCloseGoogleModal = document.getElementById('btn-close-google-modal');

	const confirmModal = document.getElementById('confirm-modal');
	const btnCloseConfirmModal = document.getElementById('btn-close-confirm-modal');
	const btnFinalSaveAndPay = document.getElementById('btn-final-save-and-pay');
	const btnFinalText = document.getElementById('btn-final-text');
	const btnFinalSpinner = document.getElementById('btn-final-spinner');

	const modalDisplayName = document.getElementById('modal-display-name');
	const modalDisplayRut = document.getElementById('modal-display-rut');
	const modalDisplayEmail = document.getElementById('modal-display-email');
	const modalDisplayPhone = document.getElementById('modal-display-phone');
	const modalDisplayDelivery = document.getElementById('modal-display-delivery');
	const modalDisplayAddress = document.getElementById('modal-display-address');

	// Estado local
	let currentUser: any = null;
	let currentDelivery = 'retiro';

	// 1. Obtener items del carrito
	function getItems() {
		return getCart();
	}

	function updateTotals() {
		const items = getItems();
		let subtotal = 0;
		items.forEach(it => subtotal += (it.precio_venta || 0) * (it.cantidad || 1));

		if (summarySubtotal) {
			summarySubtotal.textContent = `$${subtotal.toLocaleString('es-CL')} CLP`;
		}

		if (summaryTotal) {
			// En modalidad cobro en destino, el flete en web es $0
			summaryTotal.textContent = `$${subtotal.toLocaleString('es-CL')} CLP`;
		}

		if (currentDelivery === 'retiro') {
			if (summaryShipping) summaryShipping.textContent = "GRATIS ($0)";
			if (summaryShippingNote) summaryShippingNote.textContent = "* Retiro presencial en nuestra oficina en Santiago Centro";
		} else {
			if (summaryShipping) summaryShipping.textContent = "$0 en web (Cobro en Destino)";
			if (summaryShippingNote) summaryShippingNote.textContent = "* Flete estimado por pagar directamente al transportista";
		}
	}

	// 2. Control de Delivery Type
	deliveryOptions.forEach(opt => {
		opt.addEventListener('click', () => {
			const type = opt.getAttribute('data-delivery');
			if (!type) return;
			currentDelivery = type;

			deliveryOptions.forEach(o => {
				o.classList.remove('border-brand-green/50', 'bg-brand-green/5', 'border-brand-cyan/50', 'bg-brand-cyan/5');
				o.classList.add('border-white/10', 'bg-white/5');
			});

			const radio = opt.querySelector('input[type="radio"]') as HTMLInputElement;
			if (radio) radio.checked = true;

			if (type === 'envio_cobro_destino') {
				opt.classList.remove('border-white/10', 'bg-white/5');
				opt.classList.add('border-brand-cyan/50', 'bg-brand-cyan/5');
				despachoFields?.classList.remove('hidden');
			} else {
				opt.classList.remove('border-white/10', 'bg-white/5');
				opt.classList.add('border-brand-green/50', 'bg-brand-green/5');
				despachoFields?.classList.add('hidden');
			}
			updateTotals();
		});
	});

	// Región select listener
	regionSelect?.addEventListener('change', () => {
		const regionVal = regionSelect.value;
		const selectedOpt = regionSelect.options[regionSelect.selectedIndex];
		const min = selectedOpt.getAttribute('data-min');
		const max = selectedOpt.getAttribute('data-max');

		if (estimatedShippingText && min && max) {
			estimatedShippingText.textContent = `~$${parseInt(min, 10).toLocaleString('es-CL')} - $${parseInt(max, 10).toLocaleString('es-CL')} CLP`;
		}

		if (regionVal === 'RM') {
			communeRmContainer?.classList.remove('hidden');
			communeManualContainer?.classList.add('hidden');
		} else {
			communeRmContainer?.classList.add('hidden');
			communeManualContainer?.classList.remove('hidden');
		}
	});

	// Formateo y validación de RUT en tiempo real
	rutInput?.addEventListener('input', () => {
		const formatted = formatRut(rutInput.value);
		rutInput.value = formatted;
		if (formatted.length >= 8) {
			if (isValidChileanRut(formatted)) {
				rutError?.classList.add('hidden');
				rutInput.classList.remove('border-red-500');
				rutInput.classList.add('border-brand-green');
			} else {
				rutError?.classList.remove('hidden');
				rutInput.classList.remove('border-brand-green');
				rutInput.classList.add('border-red-500');
			}
		} else {
			rutError?.classList.add('hidden');
			rutInput.classList.remove('border-brand-green', 'border-red-500');
		}
	});

	// Formateo y validación de Teléfono / Celular en tiempo real
	function formatPhoneInputWithCursor(input: HTMLInputElement) {
		const rawVal = input.value;
		const selStart = input.selectionStart ?? rawVal.length;

		// Contar cuántos dígitos significativos había antes del cursor
		const rawBeforeCursor = rawVal.slice(0, selStart);
		const digitsBefore = cleanChileanPhone(rawBeforeCursor).length;

		const formatted = formatChileanPhone(rawVal);
		input.value = formatted;

		if (selStart >= rawVal.length) {
			input.setSelectionRange(formatted.length, formatted.length);
			return;
		}

		let newPos = formatted.length;
		if (digitsBefore === 0) {
			newPos = formatted.startsWith('+56 ') ? 4 : 0;
		} else {
			let count = 0;
			const startSearch = formatted.startsWith('+56 ') ? 4 : 0;
			for (let i = startSearch; i < formatted.length; i++) {
				if (/\d/.test(formatted[i])) {
					count++;
					if (count === digitsBefore) {
						newPos = i + 1;
						break;
					}
				}
			}
		}

		input.setSelectionRange(newPos, newPos);
	}

	phoneInput?.addEventListener('keydown', (e) => {
		if (e.key === 'Backspace') {
			const start = phoneInput.selectionStart;
			const end = phoneInput.selectionEnd;
			if (start !== null && start === end && start > 0) {
				// Si el cursor está justo después del prefijo "+56 " y el usuario borra, limpiar todo
				if (phoneInput.value.slice(0, start) === '+56 ' || phoneInput.value.slice(0, start) === '+56') {
					e.preventDefault();
					phoneInput.value = '';
					phoneInput.dispatchEvent(new Event('input'));
					return;
				}
				// Si el carácter previo es un espacio, saltarlo y borrar el dígito anterior
				if (phoneInput.value[start - 1] === ' ') {
					e.preventDefault();
					const newVal = phoneInput.value.slice(0, start - 2) + phoneInput.value.slice(start);
					phoneInput.value = newVal;
					const newCursor = Math.max(0, start - 2);
					phoneInput.setSelectionRange(newCursor, newCursor);
					phoneInput.dispatchEvent(new Event('input'));
				}
			}
		}
	});

	phoneInput?.addEventListener('input', () => {
		formatPhoneInputWithCursor(phoneInput);
		const clean = cleanChileanPhone(phoneInput.value);
		if (clean.length >= 9) {
			if (isValidChileanPhone(phoneInput.value)) {
				phoneError?.classList.add('hidden');
				phoneInput.classList.remove('border-red-500');
				phoneInput.classList.add('border-brand-green');
			} else {
				phoneError?.classList.remove('hidden');
				phoneInput.classList.remove('border-brand-green');
				phoneInput.classList.add('border-red-500');
			}
		} else {
			phoneError?.classList.add('hidden');
			phoneInput.classList.remove('border-brand-green', 'border-red-500');
		}
	});

	phoneInput?.addEventListener('blur', () => {
		const val = phoneInput.value.trim();
		if (val.length > 0) {
			if (isValidChileanPhone(val)) {
				phoneInput.value = formatChileanPhone(val);
				phoneError?.classList.add('hidden');
				phoneInput.classList.remove('border-red-500');
				phoneInput.classList.add('border-brand-green');
			} else {
				phoneError?.classList.remove('hidden');
				phoneInput.classList.remove('border-brand-green');
				phoneInput.classList.add('border-red-500');
			}
		} else {
			phoneError?.classList.add('hidden');
			phoneInput.classList.remove('border-brand-green', 'border-red-500');
		}
	});

	// 3. Supabase Auth Management (Google OAuth Opcional)
	async function initAuth() {
		try {
			const { data: { session } } = await supabase.auth.getSession();
			handleSession(session);

			supabase.auth.onAuthStateChange((_event, session) => {
				handleSession(session);
			});
		} catch (e) {
			console.error('Error inicializando sesión de Supabase:', e);
		}
	}

	async function handleSession(session: any) {
		if (session && session.user) {
			currentUser = session.user;
			
			googleLoginBanner?.classList.add('hidden');
			userLoggedBanner?.classList.remove('hidden');
			if (loggedUserName) {
				loggedUserName.textContent = currentUser.user_metadata?.full_name || currentUser.email.split('@')[0];
			}

			// Pre-rellenar Email y Nombre si están vacíos
			if (emailInput && !emailInput.value) {
				emailInput.value = currentUser.email || '';
			}
			if (fullNameInput && !fullNameInput.value) {
				fullNameInput.value = currentUser.user_metadata?.full_name || '';
			}

			// Consultar si ya existe perfil guardado en public.customers
			try {
				const { data: customer } = await supabase
					.from('customers')
					.select('*')
					.or(`auth_user_id.eq.${currentUser.id},id.eq.${currentUser.id},email.eq.${currentUser.email}`)
					.limit(1)
					.maybeSingle();

				if (customer) {
					if (fullNameInput && customer.full_name) fullNameInput.value = customer.full_name;
					if (rutInput && customer.rut) {
						rutInput.value = customer.rut;
						if (isValidChileanRut(customer.rut)) {
							rutInput.classList.add('border-brand-green');
						}
					}
					if (phoneInput && customer.phone) {
						phoneInput.value = formatChileanPhone(customer.phone) || customer.phone;
						if (isValidChileanPhone(phoneInput.value)) {
							phoneInput.classList.add('border-brand-green');
						}
					}
					if (addressInput && customer.address) addressInput.value = customer.address;
				}
			} catch (cErr) {
				console.warn('Consulta de perfil existente en customers:', cErr);
			}

			if (btnProceedText) {
				btnProceedText.textContent = "Confirmar Datos & Continuar";
			}

		} else {
			currentUser = null;
			googleLoginBanner?.classList.remove('hidden');
			userLoggedBanner?.classList.add('hidden');
			if (btnProceedText) {
				btnProceedText.textContent = "Continuar al Pago";
			}
		}
	}

	// Gestor del Modal Moderno de Notificaciones
	const systemNoticeModal = document.getElementById('system-notice-modal');
	const noticeModalBox = document.getElementById('notice-modal-box');
	const noticeIconContainer = document.getElementById('notice-icon-container');
	const noticeIcon = document.getElementById('notice-icon');
	const noticeTitle = document.getElementById('notice-title');
	const noticeTag = document.getElementById('notice-tag');
	const noticeMessage = document.getElementById('notice-message');
	const btnCloseNoticeModal = document.getElementById('btn-close-notice-modal');
	const noticeBtnText = document.getElementById('notice-btn-text');

	let noticeResolve: (() => void) | null = null;

	function showSystemNotice({
		title = 'Atención con tu Pedido',
		message = '',
		type = 'warning',
		btnText = 'Entendido'
	}: {
		title?: string;
		message: string;
		type?: 'warning' | 'error' | 'success' | 'info';
		btnText?: string;
	}): Promise<void> {
		return new Promise((resolve) => {
			noticeResolve = resolve;

			if (noticeTitle) noticeTitle.textContent = title;
			if (noticeMessage) noticeMessage.textContent = message;
			if (noticeBtnText) noticeBtnText.textContent = btnText;

			if (type === 'error') {
				if (noticeIcon) noticeIcon.textContent = '🛑';
				if (noticeTag) {
					noticeTag.textContent = 'Error';
					noticeTag.className = 'text-[10px] uppercase tracking-wider font-extrabold px-2 py-0.5 rounded-full bg-red-500/20 text-red-300 border border-red-500/30 font-mono';
				}
				if (noticeIconContainer) {
					noticeIconContainer.className = 'w-12 h-12 rounded-2xl bg-red-500/15 border border-red-500/30 flex items-center justify-center text-2xl shrink-0';
				}
				if (noticeModalBox) {
					noticeModalBox.className = 'relative w-full max-w-md p-6 sm:p-8 rounded-3xl bg-zinc-950 border border-red-500/40 shadow-[0_0_50px_rgba(239,68,68,0.25)] transform scale-100 transition-all duration-300 space-y-6';
				}
			} else if (type === 'success') {
				if (noticeIcon) noticeIcon.textContent = '🎉';
				if (noticeTag) {
					noticeTag.textContent = 'Éxito';
					noticeTag.className = 'text-[10px] uppercase tracking-wider font-extrabold px-2 py-0.5 rounded-full bg-brand-green/20 text-brand-green border border-brand-green/30 font-mono';
				}
				if (noticeIconContainer) {
					noticeIconContainer.className = 'w-12 h-12 rounded-2xl bg-brand-green/15 border border-brand-green/30 flex items-center justify-center text-2xl shrink-0';
				}
				if (noticeModalBox) {
					noticeModalBox.className = 'relative w-full max-w-md p-6 sm:p-8 rounded-3xl bg-zinc-950 border border-brand-green/40 shadow-[0_0_50px_rgba(0,255,127,0.25)] transform scale-100 transition-all duration-300 space-y-6';
				}
			} else {
				if (noticeIcon) noticeIcon.textContent = '⚠️';
				if (noticeTag) {
					noticeTag.textContent = 'Aviso de Stock / Validación';
					noticeTag.className = 'text-[10px] uppercase tracking-wider font-extrabold px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 font-mono';
				}
				if (noticeIconContainer) {
					noticeIconContainer.className = 'w-12 h-12 rounded-2xl bg-amber-500/15 border border-amber-500/30 flex items-center justify-center text-2xl shrink-0';
				}
				if (noticeModalBox) {
					noticeModalBox.className = 'relative w-full max-w-md p-6 sm:p-8 rounded-3xl bg-zinc-950 border border-amber-500/40 shadow-[0_0_50px_rgba(245,158,11,0.25)] transform scale-100 transition-all duration-300 space-y-6';
				}
			}

			systemNoticeModal?.classList.remove('opacity-0', 'pointer-events-none');
			noticeModalBox?.classList.remove('scale-95');
			noticeModalBox?.classList.add('scale-100');
		});
	}

	function closeSystemNotice() {
		systemNoticeModal?.classList.add('opacity-0', 'pointer-events-none');
		noticeModalBox?.classList.add('scale-95');
		noticeModalBox?.classList.remove('scale-100');
		if (noticeResolve) {
			noticeResolve();
			noticeResolve = null;
		}
	}

	btnCloseNoticeModal?.addEventListener('click', closeSystemNotice);
	systemNoticeModal?.addEventListener('click', (e) => {
		if (e.target === systemNoticeModal) closeSystemNotice();
	});

	async function loginWithGoogle() {
		try {
			const { error } = await supabase.auth.signInWithOAuth({
				provider: 'google',
				options: {
					redirectTo: window.location.origin + window.location.pathname + window.location.search
				}
			});
			if (error) throw error;
		} catch (err: any) {
			showSystemNotice({
				title: 'Error de Autenticación',
				message: 'Hubo un error al intentar conectar con Google: ' + (err.message || err),
				type: 'error'
			});
		}
	}

	async function logoutUser() {
		await supabase.auth.signOut();
		window.location.reload();
	}

	btnQuickGoogleLogin?.addEventListener('click', loginWithGoogle);
	btnModalGoogleLogin?.addEventListener('click', loginWithGoogle);
	btnLogout?.addEventListener('click', logoutUser);

	// Modales open/close helpers
	function openGoogleModal() {
		googleAuthModal?.classList.remove('opacity-0', 'pointer-events-none');
		googleAuthModal?.querySelector('div')?.classList.remove('scale-95');
		googleAuthModal?.querySelector('div')?.classList.add('scale-100');
	}

	function closeGoogleModal() {
		googleAuthModal?.classList.add('opacity-0', 'pointer-events-none');
		googleAuthModal?.querySelector('div')?.classList.add('scale-95');
		googleAuthModal?.querySelector('div')?.classList.remove('scale-100');
	}

	btnCloseGoogleModal?.addEventListener('click', closeGoogleModal);

	function openConfirmModal() {
		// Populate modal values
		if (modalDisplayName) modalDisplayName.textContent = fullNameInput.value.trim();
		if (modalDisplayRut) modalDisplayRut.textContent = rutInput.value.trim().toUpperCase();
		if (modalDisplayEmail) modalDisplayEmail.textContent = emailInput.value.trim().toLowerCase();
		if (modalDisplayPhone) modalDisplayPhone.textContent = formatChileanPhone(phoneInput.value) || phoneInput.value.trim();
		if (modalDisplayDelivery) {
			modalDisplayDelivery.textContent = currentDelivery === 'retiro' ? 'Retiro en Oficina Técnica ($0)' : 'Envío por Pagar (Cobro en Destino)';
		}
		if (modalDisplayAddress) {
			if (currentDelivery === 'retiro') {
				modalDisplayAddress.textContent = 'Santiago Centro (Oficina Técnica)';
			} else {
				const commune = regionSelect.value === 'RM' ? communeSelect.value : communeManual.value.trim();
				modalDisplayAddress.textContent = `${addressInput.value.trim()}, ${commune}`;
			}
		}

		confirmModal?.classList.remove('opacity-0', 'pointer-events-none');
		confirmModal?.querySelector('div')?.classList.remove('scale-95');
		confirmModal?.querySelector('div')?.classList.add('scale-100');
	}

	function closeConfirmModal() {
		confirmModal?.classList.add('opacity-0', 'pointer-events-none');
		confirmModal?.querySelector('div')?.classList.add('scale-95');
		confirmModal?.querySelector('div')?.classList.remove('scale-100');
	}

	btnCloseConfirmModal?.addEventListener('click', closeConfirmModal);

	// 4. Click en "Continuar al Pago" (Validación de Flujo)
	btnProceedCheckout?.addEventListener('click', () => {
		const items = getItems();
		if (items.length === 0) {
			showSystemNotice({
				title: 'Carrito Vacío',
				message: 'Debes tener al menos un repuesto en tu carrito para continuar con la compra.',
				type: 'warning',
				btnText: 'Aceptar'
			});
			return;
		}

		// Validar campos obligatorios de Facturación SII (Tanto para Invitado como Registrado)
		if (!fullNameInput.value.trim()) {
			fullNameInput.focus();
			showSystemNotice({
				title: 'Nombre Obligatorio',
				message: 'Por favor ingresa tu Nombre y Apellido o Razón Social para emitir tu factura conforme a las normativas del SII.',
				type: 'warning'
			});
			return;
		}

		if (!rutInput.value.trim() || !isValidChileanRut(rutInput.value)) {
			rutInput.focus();
			rutError?.classList.remove('hidden');
			showSystemNotice({
				title: 'RUT Inválido',
				message: 'El RUT es obligatorio ante el SII y debe tener un formato válido con su dígito verificador (Módulo 11).',
				type: 'warning'
			});
			return;
		}

		if (!emailInput.value.trim() || !emailInput.value.includes('@')) {
			emailInput.focus();
			showSystemNotice({
				title: 'Correo Requerido',
				message: 'Por favor ingresa un correo electrónico válido para enviarte el respaldo de compra y factura electrónica.',
				type: 'warning'
			});
			return;
		}

		if (!phoneInput.value.trim() || !isValidChileanPhone(phoneInput.value)) {
			phoneInput.focus();
			phoneError?.classList.remove('hidden');
			phoneInput.classList.remove('border-brand-green');
			phoneInput.classList.add('border-red-500');
			showSystemNotice({
				title: 'Teléfono o Celular Inválido',
				message: 'Por favor ingresa un número de teléfono válido de Chile (Celular/WhatsApp: +56 9 XXXX XXXX o Red Fija: 9 dígitos) para coordinar el despacho o entrega.',
				type: 'warning'
			});
			return;
		}

		if (currentDelivery === 'envio_cobro_destino') {
			if (!regionSelect.value) {
				regionSelect.focus();
				showSystemNotice({
					title: 'Región de Entrega Requerida',
					message: 'Por favor selecciona la región de destino para calcular la estimación del transporte por pagar.',
					type: 'warning'
				});
				return;
			}
			if (regionSelect.value === 'RM' && !communeSelect.value) {
				communeSelect.focus();
				showSystemNotice({
					title: 'Comuna Requerida',
					message: 'Por favor selecciona la comuna en la Región Metropolitana.',
					type: 'warning'
				});
				return;
			}
			if (regionSelect.value !== 'RM' && !communeManual.value.trim()) {
				communeManual.focus();
				showSystemNotice({
					title: 'Ciudad o Comuna Requerida',
					message: 'Por favor escribe tu ciudad o comuna de destino para la entrega por pagar.',
					type: 'warning'
				});
				return;
			}
			if (!addressInput.value.trim()) {
				addressInput.focus();
				showSystemNotice({
					title: 'Dirección Requerida',
					message: 'Por favor ingresa la dirección exacta de entrega o sucursal de Starken / Chilexpress.',
					type: 'warning'
				});
				return;
			}
		}

		// Si todo es válido (con o sin sesión de Google), abrir modal de confirmación final
		openConfirmModal();
	});

	// 5. Guardar datos y conectar con Mercado Pago
	btnFinalSaveAndPay?.addEventListener('click', async () => {
		try {
			if (btnFinalText) btnFinalText.textContent = 'Conectando con Mercado Pago...';
			btnFinalSpinner?.classList.remove('hidden');
			btnFinalSaveAndPay.setAttribute('disabled', 'true');

			const communeVal = currentDelivery === 'retiro' 
				? 'Retiro en Oficina Técnica' 
				: (regionSelect.value === 'RM' ? communeSelect.value : communeManual.value.trim());

			const addressVal = currentDelivery === 'retiro'
				? 'Retiro en Oficina Técnica (Santiago Centro)'
				: addressInput.value.trim();

			const items = getItems();
			const payloadPreference = {
				customer_id: currentUser ? currentUser.id : null,
				customer: {
					full_name: fullNameInput.value.trim(),
					email: emailInput.value.trim().toLowerCase(),
					phone: formatChileanPhone(phoneInput.value) || phoneInput.value.trim(),
					rut: rutInput.value.trim().toUpperCase(),
					auth_user_id: currentUser ? currentUser.id : null,
					address: addressVal,
					commune: communeVal,
					region: regionSelect.value || 'RM'
				},
				delivery_type: currentDelivery === 'retiro' ? 'retiro' : 'envio_nacional',
				commune: communeVal,
				address: addressVal,
				items
			};

			const resPreference = await fetch('/api/mercadopago/create-preference', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(payloadPreference)
			});

			const dataPreference = await resPreference.json();

			if (!resPreference.ok || !dataPreference.success) {
				throw new Error(dataPreference.error || 'Error al generar la sesión de pago');
			}

			// Caso A: Credenciales aún no configuradas en .env (Esperando aprobación de ML)
			if (dataPreference.isPendingCredentials) {
				if (btnFinalText) btnFinalText.textContent = '¡Orden ST-2026 generada!';
				clearCart();
				await showSystemNotice({
					title: '¡Orden Generada!',
					message: `¡Orden ${dataPreference.orderId} generada con éxito!\n\nNota: Redirigiendo a la confirmación del pedido.`,
					type: 'success',
					btnText: 'Ver Pedido'
				});
				window.location.href = dataPreference.redirectUrl || `/pedido/${dataPreference.orderId}`;
				return;
			}

			// Caso B: Link Dinámico Oficial generado por Mercado Pago
			const targetPaymentUrl = dataPreference.initPoint || dataPreference.sandboxInitPoint;

			if (targetPaymentUrl) {
				if (btnFinalText) btnFinalText.textContent = 'Redirigiendo a Mercado Pago...';
				clearCart();
				window.location.href = targetPaymentUrl;
				return;
			}

			throw new Error('No se recibió el enlace de pago de Mercado Pago.');

		} catch (err: any) {
			closeConfirmModal();
			showSystemNotice({
				title: 'Inconveniente con el Pedido',
				message: err.message || 'Error al conectar con la pasarela de pago',
				type: 'warning',
				btnText: 'Entendido, Modificar Carrito'
			});
			if (btnFinalText) btnFinalText.textContent = 'Guardar Datos & Proceder al Pago';
			btnFinalSpinner?.classList.add('hidden');
			btnFinalSaveAndPay.removeAttribute('disabled');
		}
	});

	// Sincronización reactiva con Carrito LocalStorage
	function syncCartUI() {
		const cartItems = getCart();
		const itemsListEl = document.getElementById('checkout-items-list');
		const itemsCountBadge = document.getElementById('items-count-badge');
		if (!itemsListEl) return;

		// Si hay items en LocalStorage, renderizarlos sobreescribiendo el contenedor
		if (cartItems.length > 0) {
			itemsListEl.innerHTML = cartItems.map(it => `
				<div class="flex items-center gap-3 p-3.5 rounded-xl bg-white/5 border border-white/5" data-sku="${it.sku}" data-price="${it.precio_venta}" data-title="${it.titulo}" data-image="${it.imagen || ''}" data-quantity="${it.cantidad || 1}">
					<img src="${it.imagen || '/imagenes/logost.png'}" alt="" class="w-14 h-14 rounded-lg object-cover bg-zinc-900 border border-white/10 shrink-0" />
					<div class="flex-1 min-w-0">
						<h4 class="text-xs font-bold text-white truncate">${it.titulo}</h4>
						<p class="text-[10px] text-slate-400 font-mono">SKU: ${it.sku}</p>
						<div class="flex items-center justify-between mt-2 flex-wrap gap-2">
							<span class="text-xs font-extrabold text-brand-green font-mono">$${((it.precio_venta || 0) * (it.cantidad || 1)).toLocaleString('es-CL')} CLP</span>
							<div class="flex items-center gap-2">
								<div class="flex items-center bg-zinc-900 border border-white/15 rounded-lg p-0.5">
									<button type="button" class="btn-qty-minus w-6 h-6 flex items-center justify-center rounded text-slate-300 hover:text-white hover:bg-white/10 text-xs font-bold transition-colors cursor-pointer" data-sku="${it.sku}">-</button>
									<span class="text-xs font-bold text-white px-2 font-mono">${it.cantidad || 1}</span>
									<button type="button" class="btn-qty-plus w-6 h-6 flex items-center justify-center rounded text-slate-300 hover:text-white hover:bg-white/10 text-xs font-bold transition-colors cursor-pointer" data-sku="${it.sku}">+</button>
								</div>
								<button type="button" class="btn-remove-item text-slate-400 hover:text-red-400 p-1 transition-colors cursor-pointer" data-sku="${it.sku}" title="Eliminar del pedido">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
								</button>
							</div>
						</div>
					</div>
				</div>
			`).join('');

			if (itemsCountBadge) {
				const totalUnits = cartItems.reduce((acc, it) => acc + (it.cantidad || 1), 0);
				itemsCountBadge.textContent = `${totalUnits} item${totalUnits > 1 ? 's' : ''}`;
			}

			// Listeners para botones de cantidad
			itemsListEl.querySelectorAll('.btn-qty-minus').forEach(b => {
				b.addEventListener('click', () => {
					const sku = b.getAttribute('data-sku');
					if (!sku) return;
					const currentItem = cartItems.find(i => i.sku === sku);
					if (currentItem) {
						updateItemQuantity(sku, (currentItem.cantidad || 1) - 1);
					}
				});
			});

			itemsListEl.querySelectorAll('.btn-qty-plus').forEach(b => {
				b.addEventListener('click', () => {
					const sku = b.getAttribute('data-sku');
					if (!sku) return;
					const currentItem = cartItems.find(i => i.sku === sku);
					if (currentItem) {
						updateItemQuantity(sku, (currentItem.cantidad || 1) + 1);
					}
				});
			});

			// Botones para quitar productos del checkout
			itemsListEl.querySelectorAll('.btn-remove-item').forEach(b => {
				b.addEventListener('click', () => {
					const skuToRemove = b.getAttribute('data-sku');
					if (skuToRemove) {
						removeFromCart(skuToRemove);
					}
				});
			});
		} else {
			itemsListEl.innerHTML = `
				<div class="text-center py-8 text-slate-400 space-y-3">
					<div class="text-3xl">🛒</div>
					<p class="font-bold text-white text-sm">Tu carrito está actualmente vacío</p>
					<p class="text-xs text-slate-400">Selecciona repuestos desde el catálogo para continuar con la compra.</p>
					<a href="/repuestos" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold text-black bg-gradient-to-r from-brand-green to-brand-cyan hover:opacity-90 transition-all shadow-[0_0_15px_rgba(0,255,127,0.3)]">
						← Ir al Catálogo de Repuestos
					</a>
				</div>
			`;
			if (itemsCountBadge) itemsCountBadge.textContent = "0 items";
		}

		updateTotals();
	}

	// Si se accedió con ?sku= o ?id= por URL directa (compra rápida SSR) y el carrito local está vacío,
	// importar ese producto inicial una sola vez al cargar la página
	const urlParams = new URLSearchParams(window.location.search);
	const initialSkuParam = urlParams.get('sku');
	const initialIdParam = urlParams.get('id');
	if ((initialSkuParam || initialIdParam) && getCart().length === 0) {
		const initialEl = document.getElementById('checkout-items-list')?.querySelector('[data-sku]');
		if (initialEl) {
			const sku = initialEl.getAttribute('data-sku') || '';
			const title = initialEl.getAttribute('data-title') || '';
			const price = parseFloat(initialEl.getAttribute('data-price') || '0');
			const image = initialEl.getAttribute('data-image') || '';
			if (sku) {
				addToCart({ sku, titulo: title, precio_venta: price, cantidad: 1, imagen: image });
				const cleanUrl = new URL(window.location.href);
				cleanUrl.searchParams.delete('sku');
				cleanUrl.searchParams.delete('id');
				window.history.replaceState({}, '', cleanUrl.toString());
			}
		}
	}

	// Escuchar eventos de actualización de carrito
	window.addEventListener('st:cart:updated', syncCartUI);

	// Inicializar
	initAuth();
	syncCartUI();
	updateTotals();

	// Manejo de retorno de Mercado Pago cuando el pago falla o es cancelado
	if (urlParams.get('payment') === 'failure') {
		const failedOrder = urlParams.get('order') || '';
		showSystemNotice({
			title: 'Pago No Completado',
			message: `No se completó el pago en Mercado Pago${failedOrder ? ` (Orden ${failedOrder})` : ''}.\n\nTus repuestos siguen guardados en el carrito para que puedas revisar tus datos o intentar con otro medio de pago.`,
			type: 'warning',
			btnText: 'Revisar Carrito'
		});
	}
</script>
