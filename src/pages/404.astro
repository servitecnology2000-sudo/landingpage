---
export const prerender = false;
Astro.response.status = 404;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
	title="Página No Encontrada (404) | SERVITECNOLOGY" 
	description="La página o el recurso solicitado no fue encontrado. Explora nuestro catálogo de repuestos y servicios informáticos en Santiago de Chile."
>
	<Header />

	<main class="relative bg-black min-h-[75vh] flex items-center justify-center py-24 px-6 overflow-hidden">
		<!-- Background Glows -->
		<div class="absolute top-1/3 left-1/3 w-[400px] h-[400px] bg-brand-cyan/5 rounded-full blur-[140px] pointer-events-none"></div>
		<div class="absolute bottom-1/3 right-1/3 w-[400px] h-[400px] bg-brand-green/5 rounded-full blur-[140px] pointer-events-none"></div>

		<div class="relative z-10 max-w-lg mx-auto text-center space-y-6 bg-zinc-950/40 border border-white/10 p-8 sm:p-12 rounded-3xl backdrop-blur-xl shadow-2xl">
			<div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-brand-cyan/10 border border-brand-cyan/20 text-brand-cyan font-black text-3xl tracking-wider shadow-[0_0_30px_rgba(0,207,255,0.2)]">
				404
			</div>

			<h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
				Página No Encontrada
			</h1>

			<p class="text-sm sm:text-base text-slate-300 leading-relaxed">
				La dirección que intentas visitar no existe, cambió de ubicación o el producto fue retirado de nuestro catálogo.
			</p>

			<div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3 w-full">
				<a 
					href="/repuestos" 
					class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-gradient-to-r from-brand-green to-brand-cyan text-black font-bold text-xs uppercase tracking-wider hover:opacity-90 transition-all shadow-[0_0_20px_rgba(0,255,127,0.25)]"
				>
					<svg class="w-4 h-4 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
					Catálogo de Repuestos
				</a>

				<a 
					href="/" 
					class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-bold text-xs uppercase tracking-wider transition-all border border-white/10 hover:border-white/20"
				>
					Ir a la Portada
				</a>
			</div>
		</div>
	</main>

	<Footer />
</Layout>
