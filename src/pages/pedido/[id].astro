---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { supabaseAdmin } from '../../lib/supabase';

const { id } = Astro.params;
const orderId = id?.toUpperCase() || 'ST-2026-0000';

// Intentar leer el pedido desde la base de datos
let order: any = null;
let customer: any = null;
try {
	const { data } = await supabaseAdmin
		.from('orders')
		.select('*')
		.eq('id', orderId)
		.single();
	if (data) {
		order = data;
		if (order.customer_id) {
			const { data: custData } = await supabaseAdmin
				.from('customers')
				.select('*')
				.eq('id', order.customer_id)
				.single();
			if (custData) customer = custData;
		}
	}
} catch (e) {
	console.warn('No se pudo leer pedido desde Supabase, se resolverá en cliente:', e);
}

// Parámetros de retorno de Mercado Pago
const paymentStatusParam = Astro.url.searchParams.get('payment');
const statusParam = Astro.url.searchParams.get('status');
const collectionStatusParam = Astro.url.searchParams.get('collection_status');
const paymentIdParam = Astro.url.searchParams.get('payment_id') || Astro.url.searchParams.get('collection_id');

const isPaid = (order?.payment_status === 'aprobado') ||
	(paymentStatusParam === 'success') ||
	(statusParam === 'approved') ||
	(collectionStatusParam === 'approved');

const finalPaymentId = order?.mp_payment_id || paymentIdParam || '';

// Datos bancarios oficiales de SERVITECNOLOGY SpA (para compras por transferencia)
const BANK_DETAILS = {
	banco: "BancoEstado",
	tipoCuenta: "Cuenta Corriente",
	numeroCuenta: "00-721-94820-01",
	titular: "SERVITECNOLOGY SpA",
	rut: "77.892.410-K",
	email: "contacto@servitecnology.com"
};
---

<Layout 
	title={isPaid ? `¡Pago Confirmado! | Pedido ${orderId} — SERVITECNOLOGY` : `Pedido ${orderId} | Instrucciones de Transferencia — SERVITECNOLOGY`}
	description="Detalle oficial de tu pedido en SERVITECNOLOGY. Seguimiento de entrega, facturación electrónica SII y soporte técnico especializado."
>
	<Header />

	<main class="relative bg-black min-h-screen py-16 border-b border-white/5">
		<!-- Glows -->
		<div class={`absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[400px] ${isPaid ? 'bg-emerald-500/10' : 'bg-yellow-500/5'} rounded-full blur-[160px] pointer-events-none`}></div>

		<!-- Indicador oculto para hidratación en cliente -->
		<div id="is-paid-indicator" data-paid={isPaid ? 'true' : 'false'} class="hidden"></div>

		<div class="relative z-10 mx-auto max-w-4xl px-6 w-full">
			
			<!-- Success & Status Banner -->
			<div class="text-center max-w-2xl mx-auto mb-10 space-y-4">
				{isPaid ? (
					<div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-bold uppercase tracking-wider shadow-[0_0_20px_rgba(16,185,129,0.25)]">
						<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
						<span>Pago Confirmado con Mercado Pago</span>
					</div>
				) : (
					<div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-yellow-500/10 border border-yellow-500/30 text-yellow-400 text-xs font-bold uppercase tracking-wider shadow-[0_0_20px_rgba(234,179,8,0.2)]">
						<span class="w-2 h-2 rounded-full bg-yellow-400 animate-ping"></span>
						<span>Pendiente de Pago por Transferencia</span>
					</div>
				)}

				<h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
					{isPaid ? '¡Pago Confirmado & Pedido en Preparación!' : '¡Pedido Registrado con Éxito!'}
				</h1>
				<p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-xl mx-auto">
					{isPaid ? (
						'Hemos recibido tu pago mediante Mercado Pago. Tus repuestos están asegurados y nuestro equipo técnico ya se encuentra preparando tu despacho o citación de retiro.'
					) : (
						'Gracias por comprar en SERVITECNOLOGY. Tu pedido ha sido generado bajo el código único:'
					)}
				</p>
				
				<!-- Order ID Pill with Copy Button -->
				<div class="inline-flex items-center gap-3 p-3 sm:p-4 rounded-2xl bg-zinc-950/80 border-2 border-brand-cyan/40 shadow-[0_0_30px_rgba(0,207,255,0.2)] font-mono">
					<span class="text-xl sm:text-3xl font-black text-white tracking-wider" id="order-id-display">{orderId}</span>
					<button 
						type="button" 
						id="btn-copy-id" 
						class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-brand-cyan/20 text-brand-cyan text-xs font-bold transition-all cursor-pointer flex items-center gap-1.5 border border-white/10"
						title="Copiar código de pedido"
					>
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
						<span id="copy-text">Copiar</span>
					</button>
				</div>
			</div>

			<!-- Status Bar: Paid Banner or Countdown Timer -->
			{isPaid ? (
				<div class="mb-10 p-5 rounded-2xl bg-gradient-to-r from-emerald-500/15 via-brand-cyan/10 to-transparent border border-emerald-500/30 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-[0_0_30px_rgba(16,185,129,0.1)]">
					<div class="flex items-center gap-3.5">
						<div class="w-10 h-10 rounded-xl bg-emerald-400/20 border border-emerald-400/40 flex items-center justify-center text-xl shrink-0">
							✅
						</div>
						<div class="text-left">
							<h3 class="text-sm font-bold text-white">Stock 100% Asegurado y Descontado</h3>
							<p class="text-xs text-slate-300">
								Transacción aprobada {finalPaymentId ? `(N° Operación: ${finalPaymentId})` : ''}. Se ha enviado un correo formal con el resumen completo.
							</p>
						</div>
					</div>
					<div class="px-4 py-2 rounded-xl bg-emerald-500/20 border border-emerald-500/40 text-center font-mono font-black text-emerald-300 text-xs sm:text-sm shrink-0">
						Estado: En Preparación
					</div>
				</div>
			) : (
				<div class="mb-10 p-5 rounded-2xl bg-gradient-to-r from-yellow-500/10 via-amber-500/10 to-transparent border border-yellow-500/30 flex flex-col sm:flex-row items-center justify-between gap-4">
					<div class="flex items-center gap-3.5">
						<div class="w-10 h-10 rounded-xl bg-yellow-400/20 border border-yellow-400/40 flex items-center justify-center text-xl shrink-0">
							⏱️
						</div>
						<div class="text-left">
							<h3 class="text-sm font-bold text-white">Reserva Temporal de Stock Activa</h3>
							<p class="text-xs text-slate-300">Tus repuestos quedan reservados exclusivamente para ti durante 2 horas.</p>
						</div>
					</div>
					<div class="px-4 py-2 rounded-xl bg-black/60 border border-yellow-500/40 text-center font-mono font-black text-yellow-300 text-base sm:text-lg shrink-0" id="countdown-timer">
						01:59:59
					</div>
				</div>
			)}

			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
				
				<!-- Left Column: Fulfillment Details or Bank Transfer Box (7 Cols) -->
				<div class="lg:col-span-7 space-y-6">
					
					{isPaid ? (
						<div class="p-6 sm:p-8 rounded-3xl bg-zinc-950/80 border-2 border-emerald-500/40 shadow-[0_0_40px_rgba(16,185,129,0.15)] space-y-6">
							<div class="flex items-center justify-between border-b border-white/10 pb-4">
								<div class="flex items-center gap-3">
									<div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-lg">
										📦
									</div>
									<h2 class="text-lg font-bold text-white">Detalles de Entrega & Despacho</h2>
								</div>
								<span class="text-[10px] font-bold text-emerald-400 uppercase tracking-widest bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded">
									{order?.delivery_type === 'retiro' ? 'Retiro en Taller' : 'Envío por Pagar'}
								</span>
							</div>

							<div class="space-y-3 text-xs">
								{order?.delivery_type === 'retiro' ? (
									<div class="p-4 rounded-2xl bg-white/5 border border-white/10 space-y-2">
										<div class="flex items-center gap-2 text-brand-cyan font-bold text-sm">
											<span>📍</span>
											<span>Oficina Técnica Servitecnology (Santiago Centro)</span>
										</div>
										<p class="text-slate-300 leading-relaxed">
											Tus repuestos serán embalados y rotulados inmediatamente. Te enviaremos una notificación por correo electrónico y WhatsApp en cuanto tu orden esté lista para retiro.
										</p>
										<div class="pt-2 text-[11px] text-slate-400 space-y-1">
											<p>• <strong>Ubicación:</strong> Santiago Centro, Región Metropolitana.</p>
											<p>• <strong>Requisitos de retiro:</strong> Presentar el código <span class="font-mono text-white font-bold">{orderId}</span> y cédula de identidad.</p>
										</div>
									</div>
								) : (
									<div class="p-4 rounded-2xl bg-white/5 border border-white/10 space-y-2">
										<div class="flex items-center gap-2 text-brand-cyan font-bold text-sm">
											<span>🚚</span>
											<span>Despacho a Domicilio — Envío por Pagar (Cobro en Destino)</span>
										</div>
										<p class="text-slate-300 leading-relaxed">
											El costo del flete se abona directamente a la empresa de transporte al momento de recibir el paquete en tu dirección.
										</p>
										<div class="pt-2 text-[11px] text-slate-400 space-y-1">
											<p>• <strong>Comuna de Destino:</strong> <span class="text-white font-semibold">{order?.commune || 'Por coordinar'}</span></p>
											<p>• <strong>Dirección Registrada:</strong> <span class="text-white font-semibold">{order?.shipping_address || 'Por coordinar'}</span></p>
											<p>• <strong>Seguimiento:</strong> Te enviaremos el número de transporte de Starken / Chilexpress en cuanto sea despachado.</p>
										</div>
									</div>
								)}

								<div class="p-4 rounded-xl bg-white/5 border border-white/5 space-y-2 font-mono text-xs">
									<div class="flex items-center justify-between">
										<span class="text-slate-400 font-sans">Pasarela de Pago:</span>
										<span class="font-bold text-white flex items-center gap-1.5">
											<span class="w-2 h-2 rounded-full bg-emerald-400"></span>
											Mercado Pago (Acreditado)
										</span>
									</div>
									{finalPaymentId && (
										<div class="flex items-center justify-between">
											<span class="text-slate-400 font-sans">N° Operación MP:</span>
											<span class="font-bold text-brand-cyan">{finalPaymentId}</span>
										</div>
									)}
									<div class="flex items-center justify-between">
										<span class="text-slate-400 font-sans">Estado de la Orden:</span>
										<span class="font-bold text-emerald-400">En Preparación</span>
									</div>
								</div>
							</div>

							<div class="pt-2">
								<a 
									id="btn-whatsapp-paid"
									href={`https://wa.me/56948672300?text=${encodeURIComponent(`Hola SERVITECNOLOGY, mi pago para el pedido ${orderId} fue acreditado exitosamente con Mercado Pago (ID: ${finalPaymentId}). Quisiera consultar sobre el estado de preparación y entrega.`)}`}
									target="_blank"
									rel="noopener noreferrer"
									class="w-full py-4 px-6 rounded-2xl font-bold text-black bg-brand-green hover:opacity-90 shadow-[0_0_25px_rgba(0,255,127,0.3)] transition-all flex items-center justify-center gap-2.5 text-sm tracking-wide"
								>
									<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.458 5.704 1.459h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
									<span>Consultar Estado por WhatsApp</span>
								</a>
							</div>
						</div>
					) : (
						<div class="p-6 sm:p-8 rounded-3xl bg-zinc-950/80 border-2 border-brand-green/40 shadow-[0_0_40px_rgba(0,255,127,0.15)] space-y-6">
							<div class="flex items-center justify-between border-b border-white/10 pb-4">
								<div class="flex items-center gap-3">
									<div class="w-8 h-8 rounded-lg bg-brand-green/20 text-brand-green flex items-center justify-center font-bold">
										🏦
									</div>
									<h2 class="text-lg font-bold text-white">Datos Bancarios Oficiales</h2>
								</div>
								<span class="text-[10px] font-bold text-brand-green uppercase tracking-widest bg-brand-green/10 border border-brand-green/20 px-2 py-0.5 rounded">
									Cuenta Empresa
								</span>
							</div>

							<p class="text-xs text-slate-300 leading-relaxed">
								Realiza una transferencia electrónica por el monto total a la siguiente cuenta oficial de Servitecnology:
							</p>

							<div class="space-y-3 font-mono text-xs">
								<div class="flex items-center justify-between p-3 rounded-xl bg-white/5 border border-white/5">
									<span class="text-slate-400 font-sans">Banco:</span>
									<span class="font-bold text-white text-sm">{BANK_DETAILS.banco}</span>
								</div>

								<div class="flex items-center justify-between p-3 rounded-xl bg-white/5 border border-white/5">
									<span class="text-slate-400 font-sans">Tipo de Cuenta:</span>
									<span class="font-bold text-white">{BANK_DETAILS.tipoCuenta}</span>
								</div>

								<div class="flex items-center justify-between p-3 rounded-xl bg-white/5 border border-white/5">
									<span class="text-slate-400 font-sans">Número de Cuenta:</span>
									<div class="flex items-center gap-2">
										<span class="font-black text-brand-cyan text-sm">{BANK_DETAILS.numeroCuenta}</span>
										<button type="button" class="btn-copy-account text-[10px] text-slate-400 hover:text-brand-cyan underline font-sans cursor-pointer transition-colors" data-val={BANK_DETAILS.numeroCuenta}>Copiar</button>
									</div>
								</div>

								<div class="flex items-center justify-between p-3 rounded-xl bg-white/5 border border-white/5">
									<span class="text-slate-400 font-sans">Titular:</span>
									<span class="font-bold text-white">{BANK_DETAILS.titular}</span>
								</div>

								<div class="flex items-center justify-between p-3 rounded-xl bg-white/5 border border-white/5">
									<span class="text-slate-400 font-sans">RUT:</span>
									<div class="flex items-center gap-2">
										<span class="font-bold text-white">{BANK_DETAILS.rut}</span>
										<button type="button" class="btn-copy-rut text-[10px] text-slate-400 hover:text-brand-cyan underline font-sans cursor-pointer transition-colors" data-val={BANK_DETAILS.rut}>Copiar</button>
									</div>
								</div>

								<div class="flex items-center justify-between p-3 rounded-xl bg-white/5 border border-white/5">
									<span class="text-slate-400 font-sans">Correo comprobante:</span>
									<span class="font-bold text-slate-200">{BANK_DETAILS.email}</span>
								</div>

								<div class="p-4 rounded-xl bg-yellow-500/10 border-2 border-yellow-400/50 space-y-1 text-center">
									<span class="text-[11px] font-black text-yellow-400 uppercase tracking-wide font-sans">
										⚠️ Asunto / Mensaje obligatorio de la transferencia:
									</span>
									<div class="text-xl font-black text-yellow-300 font-mono tracking-widest pt-1">
										{orderId}
									</div>
									<p class="text-[10px] text-slate-400 font-sans mt-1">
										Debes incluir exactamente este código para que el sistema asocie tu pago automáticamente.
									</p>
								</div>
							</div>

							<div class="pt-2">
								<a 
									id="btn-whatsapp-notify"
									href={`https://wa.me/56948672300?text=${encodeURIComponent(`Hola SERVITECNOLOGY, acabo de realizar la transferencia para mi pedido ${orderId}. Adjunto mi comprobante de pago.`)}`}
									target="_blank"
									rel="noopener noreferrer"
									class="w-full py-4 px-6 rounded-2xl font-bold text-black bg-brand-green hover:opacity-90 shadow-[0_0_25px_rgba(0,255,127,0.3)] transition-all flex items-center justify-center gap-2.5 text-sm tracking-wide"
								>
									<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.458 5.704 1.459h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
									<span>Informar Transferencia vía WhatsApp</span>
								</a>
							</div>
						</div>
					)}

					<!-- SII Electronic Invoicing Guarantee & 3x3 Warranty -->
					<div class="p-5 rounded-2xl bg-white/5 border border-white/10 flex items-start gap-3">
						<svg class="w-5 h-5 text-brand-cyan shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
						<div class="space-y-1 text-xs text-left">
							<h4 class="font-bold text-white">Factura Electrónica SII & Garantía Técnica 3x3</h4>
							<p class="text-slate-400 leading-relaxed">
								{isPaid 
									? 'Tu Factura Electrónica conforme al SII será emitida y enviada a tu correo registrado. Todos los repuestos disponen de 90 días de garantía técnica formal con Servitecnology SpA.'
									: 'Una vez validada la transferencia bancaria por nuestro equipo administrativo, recibirás en tu correo la Factura Electrónica emitida formalmente ante el SII junto con el comprobante de despacho o la citación de retiro.'}
							</p>
						</div>
					</div>

					<!-- Portabilidad de Datos & Derechos ARCOP para el Comprador (Invitado o Registrado) -->
					<div 
						id="order-data-carrier" 
						class="hidden" 
						data-order-id={orderId}
						data-created-at={order?.created_at || new Date().toISOString()}
						data-is-paid={isPaid ? 'true' : 'false'}
						data-total={order?.total_amount || 0}
						data-shipping-cost={order?.shipping_cost || 0}
						data-delivery-type={order?.delivery_type || 'retiro'}
						data-commune={order?.commune || order?.shipping_commune || ''}
						data-address={order?.shipping_address || ''}
						data-customer-name={customer?.full_name || ''}
						data-customer-rut={customer?.rut || ''}
						data-customer-email={customer?.email || ''}
						data-customer-phone={customer?.phone || ''}
						data-customer-type={customer?.customer_type || 'invitado'}
					></div>

					<div class="p-6 sm:p-7 rounded-3xl bg-zinc-950/80 border border-white/10 backdrop-blur-md shadow-xl space-y-4 text-left">
						<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-white/10">
							<div class="flex items-center gap-3">
								<div class="w-9 h-9 rounded-xl bg-brand-cyan/15 border border-brand-cyan/30 flex items-center justify-center text-lg shrink-0">
									🛡️
								</div>
								<div>
									<h3 class="text-sm font-bold text-white flex items-center gap-2">
										<span>Tus Datos & Derechos ARCOP</span>
										<span class="text-[10px] font-mono px-2 py-0.5 rounded bg-brand-cyan/10 text-brand-cyan border border-brand-cyan/20">Ley N° 21.719</span>
									</h3>
									<p class="text-[11px] text-slate-400">
										Válido para compras en modo invitado o cuenta registrada.
									</p>
								</div>
							</div>

							<a href="/privacidad" target="_blank" rel="noopener noreferrer" class="text-xs text-brand-green hover:underline font-semibold flex items-center gap-1">
								<span>Política de Privacidad</span>
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
							</a>
						</div>

						<p class="text-xs text-slate-300 leading-relaxed">
							Conforme al Artículo 9 de la <strong>Ley N° 21.719</strong>, puedes descargar una constancia digital estructurada (JSON) con los datos y repuestos de esta orden, o solicitar la rectificación o cancelación ante nuestro Oficial de Privacidad sin necesidad de registrar una cuenta.
						</p>

						<div class="flex items-center gap-3 flex-wrap pt-1">
							<button 
								type="button" 
								id="btn-export-order-data" 
								class="px-4 py-2.5 rounded-xl text-xs font-bold text-black bg-gradient-to-r from-brand-cyan to-brand-green hover:opacity-90 active:scale-98 transition-all flex items-center justify-center gap-2 cursor-pointer shadow-[0_0_15px_rgba(0,207,255,0.2)]"
							>
								<span>📥</span>
								<span>Descargar Constancia de Datos (JSON)</span>
							</button>

							<a 
								href={`mailto:privacidad@servitecnology.com?subject=${encodeURIComponent(`Solicitud Derechos ARCOP Ley 21719 - Pedido ${orderId}`)}&body=${encodeURIComponent(`Estimado Oficial de Privacidad SERVITECNOLOGY,\n\nSolicito ejercer mis derechos ARCOP (Acceso / Rectificación / Cancelación / Oposición / Portabilidad) respecto a los datos registrados en mi compra con código ${orderId}.\n\nNombre Completo:\nRUT:\nCorreo Electrónico de compra:\nSolicitud específica:`)}`}
								class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 hover:border-brand-cyan/30 transition-all flex items-center justify-center gap-2"
							>
								<span>⚖️</span>
								<span>Solicitar Derechos ARCOP</span>
							</a>
						</div>
					</div>

				</div>

				<!-- Right Column: Order Details & Breakdown (5 Cols) -->
				<div class="lg:col-span-5 space-y-6">
					<div class="p-6 rounded-3xl bg-zinc-950/80 border border-white/10 backdrop-blur-md space-y-6">
						<h3 class="text-sm font-bold text-white uppercase tracking-wider border-b border-white/10 pb-3">
							Detalle de la Orden
						</h3>

						<!-- Items Container -->
						<div id="order-items-list" class="space-y-3">
							{order && order.items && order.items.map((it: any) => (
								<div class="flex items-center gap-3 p-3 rounded-xl bg-white/5 border border-white/5">
									{it.imagen ? (
										<img src={it.imagen} alt="" class="w-12 h-12 rounded-lg object-cover bg-zinc-900 border border-white/10 shrink-0" />
									) : (
										<div class="w-12 h-12 rounded-lg bg-zinc-900 border border-white/10 flex items-center justify-center text-slate-500 text-xs shrink-0">ST</div>
									)}
									<div class="flex-1 min-w-0 text-xs">
										<h4 class="font-bold text-white truncate">{it.titulo}</h4>
										<p class="text-[10px] text-slate-400 font-mono">SKU: {it.sku}</p>
										<div class="flex items-center justify-between mt-1">
											<span class="font-bold text-brand-green">${it.precio_venta?.toLocaleString('es-CL')} CLP</span>
											<span class="text-[10px] text-slate-400">Cant: {it.cantidad}</span>
										</div>
									</div>
								</div>
							))}
						</div>

						<!-- Delivery info -->
						<div class="p-3.5 rounded-xl bg-white/5 border border-white/5 space-y-1.5 text-xs text-left">
							<span class="text-[10px] font-bold uppercase text-slate-400 tracking-wider">Método de Entrega:</span>
							<p id="delivery-display" class="text-white font-bold">
								{order ? (order.delivery_type === 'retiro' ? 'Retiro en Oficina Técnica ($0)' : `Despacho a Domicilio (${order.commune || 'Por coordinar'})`) : 'Cargando datos...'}
							</p>
						</div>

						<!-- Payment status pill in sidebar -->
						<div class="p-3.5 rounded-xl bg-white/5 border border-white/5 space-y-1 text-xs text-left">
							<span class="text-[10px] font-bold uppercase text-slate-400 tracking-wider">Estado del Pago:</span>
							<p class={`font-bold ${isPaid ? 'text-emerald-400' : 'text-yellow-400'} flex items-center gap-1.5`}>
								<span class={`w-2 h-2 rounded-full ${isPaid ? 'bg-emerald-400' : 'bg-yellow-400'}`}></span>
								{isPaid ? 'Aprobado con Mercado Pago' : 'Pendiente de Transferencia'}
							</p>
						</div>

						<!-- Total Breakdown -->
						<div class="space-y-2 pt-4 border-t border-white/10 text-xs">
							<div class="flex items-center justify-between text-slate-400">
								<span>Despacho:</span>
								<span id="display-shipping" class="font-bold text-white font-mono">
									{order ? (order.shipping_cost > 0 ? `$${order.shipping_cost?.toLocaleString('es-CL')} CLP` : 'Cobro en Destino / Gratis') : '---'}
								</span>
							</div>
							<div class="flex items-center justify-between text-base font-extrabold text-white pt-2 border-t border-white/10">
								<span>{isPaid ? 'Total Pagado en Web:' : 'Total a Transferir:'}</span>
								<span id="display-total" class="text-2xl text-transparent bg-clip-text bg-gradient-to-r from-brand-green to-brand-cyan font-mono">
									{order ? `$${order.total_amount?.toLocaleString('es-CL')} CLP` : '---'}
								</span>
							</div>
						</div>

						<a 
							href="/repuestos" 
							class="block w-full text-center py-3 rounded-xl border border-white/10 hover:border-white/20 text-slate-300 text-xs font-semibold hover:text-white transition-colors"
						>
							← Volver al Catálogo Ecommerce
						</a>
					</div>
				</div>

			</div>
		</div>
	</main>

	<Footer />
</Layout>

<script>
	// Client hydration
	const isPaidMode = document.getElementById('is-paid-indicator')?.getAttribute('data-paid') === 'true';
	const orderId = document.getElementById('order-id-display')?.textContent?.trim() || '';
	const storedOrderStr = sessionStorage.getItem(`order_${orderId}`);

	if (storedOrderStr) {
		try {
			const storedOrder = JSON.parse(storedOrderStr);
			
			// Hydrate items if empty in DOM
			const itemsContainer = document.getElementById('order-items-list');
			if (itemsContainer && itemsContainer.children.length === 0 && storedOrder.items) {
				itemsContainer.innerHTML = storedOrder.items.map((it: any) => `
					<div class="flex items-center gap-3 p-3 rounded-xl bg-white/5 border border-white/5">
						<img src="${it.imagen || '/imagenes/logost.png'}" alt="" class="w-12 h-12 rounded-lg object-cover bg-zinc-900 border border-white/10 shrink-0" />
						<div class="flex-1 min-w-0 text-xs">
							<h4 class="font-bold text-white truncate">${it.titulo}</h4>
							<p class="text-[10px] text-slate-400 font-mono">SKU: ${it.sku}</p>
							<div class="flex items-center justify-between mt-1">
								<span class="font-bold text-brand-green">$${(it.precio_venta || 0).toLocaleString('es-CL')} CLP</span>
								<span class="text-[10px] text-slate-400">Cant: ${it.cantidad || 1}</span>
							</div>
						</div>
					</div>
				`).join('');
			}

			// Delivery display
			const deliveryEl = document.getElementById('delivery-display');
			if (deliveryEl && storedOrder.delivery_type) {
				deliveryEl.textContent = storedOrder.delivery_type === 'retiro' 
					? 'Retiro en Oficina Técnica ($0)'
					: `Despacho a Domicilio (${storedOrder.commune || 'Por coordinar'})`;
			}

			// Shipping
			const shippingEl = document.getElementById('display-shipping');
			if (shippingEl) {
				shippingEl.textContent = storedOrder.shipping_cost > 0
					? `$${storedOrder.shipping_cost.toLocaleString('es-CL')} CLP`
					: 'Cobro en Destino / Gratis';
			}

			// Total
			const totalEl = document.getElementById('display-total');
			if (totalEl && storedOrder.total_amount) {
				totalEl.textContent = `$${storedOrder.total_amount.toLocaleString('es-CL')} CLP`;
			}

			// Only update WhatsApp transfer prefill if NOT paid
			if (!isPaidMode) {
				const btnWa = document.getElementById('btn-whatsapp-notify') as HTMLAnchorElement;
				if (btnWa) {
					const waText = `Hola SERVITECNOLOGY, acabo de realizar la transferencia para mi pedido ${orderId} por un total de $${(storedOrder.total_amount || 0).toLocaleString('es-CL')} CLP. Adjunto mi comprobante de pago.`;
					btnWa.href = `https://wa.me/56948672300?text=${encodeURIComponent(waText)}`;
				}
			}

		} catch (e) {
			console.error('Error restaurando pedido desde sessionStorage:', e);
		}
	}

	// Limpiar carrito al confirmar orden
	import { clearCart } from '../../lib/cart';
	try {
		clearCart();
	} catch(e) {}

	// Botón Copiar Código de Pedido
	const btnCopyId = document.getElementById('btn-copy-id');
	const copyText = document.getElementById('copy-text');
	btnCopyId?.addEventListener('click', async () => {
		if (orderId) {
			await navigator.clipboard.writeText(orderId);
			if (copyText) copyText.textContent = '¡Copiado! ✓';
			setTimeout(() => {
				if (copyText) copyText.textContent = 'Copiar';
			}, 2000);
		}
	});

	// Botones copiar datos bancarios (cuenta y RUT) en caso de transferencia
	document.querySelectorAll('.btn-copy-account, .btn-copy-rut').forEach(btn => {
		btn.addEventListener('click', async () => {
			const val = btn.getAttribute('data-val') || '';
			if (val) {
				await navigator.clipboard.writeText(val);
				const originalText = btn.textContent;
				btn.textContent = '¡Copiado! ✓';
				btn.classList.add('text-brand-green');
				setTimeout(() => {
					btn.textContent = originalText;
					btn.classList.remove('text-brand-green');
				}, 2000);
			}
		});
	});

	// Contador regresivo de 2 horas ÚNICAMENTE en modo transferencia pendiente
	const timerEl = document.getElementById('countdown-timer');
	if (timerEl && !isPaidMode) {
		let remainingSeconds = 2 * 60 * 60; // 2 horas

		const interval = setInterval(() => {
			remainingSeconds--;
			if (remainingSeconds <= 0) {
				clearInterval(interval);
				if (timerEl) timerEl.textContent = "Expirado";
				return;
			}

			const hrs = Math.floor(remainingSeconds / 3600);
			const mins = Math.floor((remainingSeconds % 3600) / 60);
			const secs = remainingSeconds % 60;

			const formatted = `${String(hrs).padStart(2, '0')}:${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
			if (timerEl) timerEl.textContent = formatted;
		}, 1000);
	}

	// Exportar constancia de datos de la orden en JSON (Art. 9 Ley N° 21.719 para invitados y registrados)
	const btnExportOrderData = document.getElementById('btn-export-order-data');
	btnExportOrderData?.addEventListener('click', () => {
		try {
			const carrier = document.getElementById('order-data-carrier');
			let parsedStored: any = null;
			if (storedOrderStr) {
				try { parsedStored = JSON.parse(storedOrderStr); } catch {}
			}

			const exportOrderPayload = {
				metadatos: {
					plataforma: "SERVITECNOLOGY E-commerce & SaaS",
					responsable_legal: "SERVITECNOLOGY SpA",
					normativa: "Ley N° 21.719 sobre Protección de Datos Personales de Chile - Art. 9 Derecho a la Portabilidad",
					fecha_exportacion: new Date().toISOString(),
					formato: "application/json",
					contacto_privacidad: "privacidad@servitecnology.com",
					tipo_adquisicion: carrier?.getAttribute('data-customer-type') || (parsedStored?.customer ? 'invitado' : 'invitado')
				},
				comprador_titular: {
					nombre: carrier?.getAttribute('data-customer-name') || parsedStored?.customer?.full_name || "Titular de la orden",
					rut: carrier?.getAttribute('data-customer-rut') || parsedStored?.customer?.rut || "Registrado en facturación SII",
					email: carrier?.getAttribute('data-customer-email') || parsedStored?.customer?.email || "Registrado en compra",
					telefono: carrier?.getAttribute('data-customer-phone') || parsedStored?.customer?.phone || "Registrado en despacho"
				},
				orden_compra: {
					orden_id: orderId,
					fecha: carrier?.getAttribute('data-created-at') || new Date().toISOString(),
					estado_pago: (carrier?.getAttribute('data-is-paid') === 'true' || isPaidMode) ? 'aprobado' : 'pendiente_transferencia',
					modalidad_entrega: carrier?.getAttribute('data-delivery-type') || parsedStored?.delivery_type || 'retiro',
					direccion_despacho: carrier?.getAttribute('data-address') || parsedStored?.address || 'Oficina Técnica Santiago Centro',
					comuna_despacho: carrier?.getAttribute('data-commune') || parsedStored?.commune || 'Santiago',
					total_pagado_web_clp: Number(carrier?.getAttribute('data-total')) || parsedStored?.total_amount || 0,
					costo_flete_clp: Number(carrier?.getAttribute('data-shipping-cost')) || parsedStored?.shipping_cost || 0,
					items: parsedStored?.items || []
				}
			};

			const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(exportOrderPayload, null, 2));
			const downloadAnchor = document.createElement('a');
			downloadAnchor.setAttribute("href", dataStr);
			downloadAnchor.setAttribute("download", `servitecnology-constancia-pedido-${orderId}.json`);
			document.body.appendChild(downloadAnchor);
			downloadAnchor.click();
			downloadAnchor.remove();

			const originalText = btnExportOrderData.innerHTML;
			btnExportOrderData.innerHTML = '<span>✅</span><span>¡Constancia JSON Descargada!</span>';
			setTimeout(() => {
				btnExportOrderData.innerHTML = originalText;
			}, 2500);
		} catch (err) {
			console.error('Error generando constancia JSON de orden:', err);
		}
	});
</script>
