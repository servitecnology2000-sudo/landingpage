---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CintaTrabajos from '../components/CintaTrabajos.astro';

const pageTitle = "Instalación de Redes, Cableado Estructurado y WiFi | Servitecnology";
const pageDescription = "Soluciones de conectividad y redes para hogares y empresas. Cableado estructurado, ampliación de señal WiFi, routers y configuración de red.";
const waMessage = encodeURIComponent(`Hola SERVITECNOLOGY, requiero soporte de redes o conectividad para mi oficina o domicilio.`);
const waLink = `https://wa.me/56948672300?text=${waMessage}`;
---

<Layout 
	title={pageTitle} 
	description={pageDescription}
	keywords="redes, wifi lento, cableado estructurado, mejorar wifi, router mesh, access point, servitecnology, chile"
>
	<Header />

	<main class="relative bg-black min-h-screen pb-20 overflow-hidden">
		<!-- HERO SECTION BANNER -->
		<section class="relative min-h-[50vh] md:min-h-[60vh] flex items-center justify-center overflow-hidden pt-28 pb-16 md:pt-32 md:pb-24 bg-black border-b border-white/10 mb-12">
			<!-- Background Image with Overlay -->
			<div class="absolute inset-0 z-0 pointer-events-none">
				<img src="/imagenes/redes.jpg" alt="Instalación de Redes, Cableado Estructurado y WiFi" class="w-full h-full object-cover object-center scale-105 filter brightness-90" />
				<div class="absolute inset-0 bg-gradient-to-t from-black via-black/75 to-black/60 z-10"></div>
				<div class="absolute inset-0 bg-radial-gradient from-transparent via-black/40 to-black z-10"></div>
			</div>

			<!-- Decorative Glows & Grid Pattern -->
			<div class="absolute top-1/2 left-1/4 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] bg-brand-green/15 rounded-full blur-[140px] pointer-events-none z-10"></div>
			<div class="absolute bottom-1/4 right-1/4 translate-x-1/2 translate-y-1/2 w-[400px] h-[400px] bg-brand-cyan/15 rounded-full blur-[140px] pointer-events-none z-10"></div>
			<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:32px_32px] pointer-events-none z-10"></div>

			<!-- Hero Content -->
			<div class="relative z-20 mx-auto max-w-5xl px-6 w-full text-center space-y-6">
				<div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-brand-green/30 bg-brand-green/10 text-brand-green text-xs sm:text-sm font-semibold uppercase tracking-wider backdrop-blur-md shadow-lg">
					<span class="w-2 h-2 rounded-full bg-brand-green animate-pulse"></span>
					Conectividad Profesional & WiFi
				</div>

				<h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight text-white leading-tight drop-shadow-[0_4px_16px_rgba(0,0,0,0.9)]">
					Instalación de Redes y <br class="hidden sm:inline" />
					<span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-green via-brand-green to-brand-cyan drop-shadow-[0_2px_10px_rgba(0,255,127,0.4)]">
						Conectividad Empresarial
					</span>
				</h1>

				<p class="text-slate-200 text-base md:text-xl max-w-3xl mx-auto leading-relaxed drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)] font-medium">
					{pageDescription}
				</p>

				<div class="pt-4 flex flex-wrap justify-center gap-4">
					<a 
						href={waLink}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex justify-center items-center gap-3 bg-brand-green text-black hover:bg-brand-cyan px-8 py-4 rounded-xl font-bold text-base transition-all duration-300 shadow-[0_0_25px_rgba(0,255,127,0.3)] hover:scale-105"
					>
						Optimizar mi Red
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
					</a>
				</div>
			</div>
		</section>

		<!-- PROCESO DE CONTRATACIÓN -->
		<section class="relative z-10 mx-auto max-w-5xl px-6 w-full py-16 border-t border-white/5">
			<h2 class="text-2xl md:text-4xl font-extrabold text-white text-center mb-12">
				Proceso de <span class="text-brand-green">Optimización</span>
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<div class="bg-zinc-950/50 border border-white/5 p-6 rounded-2xl relative overflow-hidden group hover:border-brand-green/20 transition-all duration-300">
					<div class="absolute -top-4 -right-4 text-8xl font-black text-white/5 select-none">1</div>
					<h3 class="text-xl font-bold text-white mb-3">1. Diagnóstico de Señal</h3>
					<p class="text-slate-400 text-sm leading-relaxed">
						Realizamos un análisis de espectro inalámbrico y saturación de canales en tu propiedad para localizar las zonas sin cobertura o con interferencia.
					</p>
				</div>
				<div class="bg-zinc-950/50 border border-white/5 p-6 rounded-2xl relative overflow-hidden group hover:border-brand-green/20 transition-all duration-300">
					<div class="absolute -top-4 -right-4 text-8xl font-black text-white/5 select-none">2</div>
					<h3 class="text-xl font-bold text-white mb-3">2. Plan de Canalización</h3>
					<p class="text-slate-400 text-sm leading-relaxed">
						Proponemos la ubicación óptima para Access Points, repetidores tipo Mesh y puntos cableados estratégicos para computadores y consolas.
					</p>
				</div>
				<div class="bg-zinc-950/50 border border-white/5 p-6 rounded-2xl relative overflow-hidden group hover:border-brand-green/20 transition-all duration-300">
					<div class="absolute -top-4 -right-4 text-8xl font-black text-white/5 select-none">3</div>
					<h3 class="text-xl font-bold text-white mb-3">3. Certificación y Entrega</h3>
					<p class="text-slate-400 text-sm leading-relaxed">
						Instalamos canalizaciones prolijas, crimpamos conectores RJ45 de alta calidad y testeamos la red para certificar que recibes el 100% de la velocidad de tu plan contratado.
					</p>
				</div>
			</div>
		</section>

		<!-- CÓMO TRABAJAMOS -->
		<section class="relative z-10 mx-auto max-w-5xl px-6 w-full py-16 border-t border-white/5">
			<h2 class="text-2xl md:text-4xl font-extrabold text-white text-center mb-12">
				Garantía y Metodología en Conectividad
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
				<div class="space-y-6">
					<div class="flex gap-4 items-start">
						<div class="p-3 bg-brand-green/10 rounded-xl text-brand-green border border-brand-green/20 shrink-0">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
						</div>
						<div>
							<h3 class="text-lg font-bold text-white mb-1">Tiempos de Respuesta</h3>
							<p class="text-slate-400 text-sm leading-relaxed">
								Evaluaciones presenciales programadas en 24/48 horas. Ejecuciones de cableado y montaje en terreno en el día acordado.
							</p>
						</div>
					</div>
					<div class="flex gap-4 items-start">
						<div class="p-3 bg-brand-cyan/10 rounded-xl text-brand-cyan border border-brand-cyan/20 shrink-0">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
						</div>
						<div>
							<h3 class="text-lg font-bold text-white mb-1">Garantía de Estabilidad</h3>
							<p class="text-slate-400 text-sm leading-relaxed">
								6 meses de soporte técnico de red ante cualquier desconfiguración de Access Points o daño en la estructura física instalada.
							</p>
						</div>
					</div>
				</div>
				<div class="space-y-6">
					<div class="flex gap-4 items-start">
						<div class="p-3 bg-brand-green/10 rounded-xl text-brand-green border border-brand-green/20 shrink-0">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z" /></svg>
						</div>
						<div>
							<h3 class="text-lg font-bold text-white mb-1">Insumos Certificados</h3>
							<p class="text-slate-400 text-sm leading-relaxed">
								Utilizamos cables de red de cobre sólido blindado para exteriores (FTP Cat6) y gabinetes ordenadores para proteger tus equipos y routers principales.
							</p>
						</div>
					</div>
					<div class="flex gap-4 items-start">
						<div class="p-3 bg-brand-cyan/10 rounded-xl text-brand-cyan border border-brand-cyan/20 shrink-0">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
						</div>
						<div>
							<h3 class="text-lg font-bold text-white mb-1">Seguridad de Red</h3>
							<p class="text-slate-400 text-sm leading-relaxed">
								Configuramos políticas de seguridad (WPA3), aislamiento de red de invitados y filtros para proteger tu privacidad de intrusiones.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- CINTA UNIFICADA DE CLIENTES SATISFECHOS - REDES -->
		<CintaTrabajos 
			categoria="redes" 
			tituloSeccion="Instalaciones y Proyectos de Redes en Terreno"
			subtituloSeccion="Cableado estructurado, racks de comunicaciones y redes inalámbricas empresariales."
		/>
	</main>

	<Footer />
	<WhatsAppButton phone="56948672300" message="Hola SERVITECNOLOGY, consulto por redes..." />
</Layout>
