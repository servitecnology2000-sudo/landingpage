---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CintaTrabajos from '../components/CintaTrabajos.astro';
import { fetchYouTubeVideos, SUBSCRIBE_URL, CHANNEL_URL, CHANNEL_ID } from '../lib/youtube';

const pageTitle = "Canal de YouTube Oficial | Casos de Éxito y Reparaciones en Vivo | SERVITECNOLOGY";
const pageDescription = "Transparencia técnica en cada trabajo. Mira nuestras reparaciones en vivo, diagnósticos de microelectrónica y encuentra los repuestos exactos para tu equipo en Santiago.";
const pageKeywords = "youtube servitecnology, reparaciones en vivo, cambiar ram ssd hp pavilion, arreglo placa madre santiago, microelectronica laptops, repuestos computadores chile, reparacion impresoras epson santiago";

const videos = await fetchYouTubeVideos();

// Structured data for Video Gallery
const videoSchema = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	"name": "Videos de Reparaciones y Casos de Éxito - SERVITECNOLOGY",
	"description": pageDescription,
	"itemListElement": videos.map((v, i) => ({
		"@type": "ListItem",
		"position": i + 1,
		"item": {
			"@type": "VideoObject",
			"name": v.title,
			"description": v.description,
			"thumbnailUrl": [v.thumbnail],
			"uploadDate": v.publishedAt,
			"contentUrl": v.url,
			"embedUrl": v.embedUrl
		}
	}))
};
---

<Layout 
	title={pageTitle} 
	description={pageDescription}
	keywords={pageKeywords}
>
	<!-- Structured Data JSON-LD for Google Video Indexing -->
	<script type="application/ld+json" is:inline set:html={JSON.stringify(videoSchema)} />

	<Header />

	<main class="relative bg-black min-h-screen pb-20 overflow-hidden text-slate-100">
		<!-- HERO SECTION BANNER (ESTILO NATIVO SERVITECNOLOGY CON OVERLAY YOUTUBE) -->
		<section class="relative min-h-[55vh] md:min-h-[65vh] flex items-center justify-center overflow-hidden pt-28 pb-16 md:pt-32 md:pb-24 bg-black border-b border-white/10 mb-12">
			<!-- Background Image with Texture & Relief Overlays -->
			<div class="absolute inset-0 z-0 pointer-events-none">
				<img 
					src="/imagenes/youtube_hero.jpg" 
					alt="Estudio y Taller Técnico SERVITECNOLOGY en YouTube" 
					class="w-full h-full object-cover object-center scale-105 filter brightness-90 opacity-40" 
				/>
				<div class="absolute inset-0 bg-gradient-to-t from-black via-black/85 to-black/70 z-10"></div>
				<div class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_0%,rgba(0,0,0,0.7)_60%,#000000_100%)] z-10"></div>
			</div>

			<!-- Stylized YouTube Watermark/Logo Overlay in Dark Low-Opacity Relief -->
			<div class="absolute inset-0 flex items-center justify-center pointer-events-none z-10 overflow-hidden select-none">
				<svg class="w-[500px] sm:w-[750px] lg:w-[1000px] h-auto text-white/[0.035] filter drop-shadow-[0_0_80px_rgba(255,0,0,0.18)] -rotate-3 scale-110 transition-transform duration-1000" viewBox="0 0 24 24" fill="currentColor">
					<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
				</svg>
			</div>

			<!-- Decorative Ambient Glows & Cyberpunk Grid Pattern -->
			<div class="absolute top-1/2 left-1/4 -translate-x-1/2 -translate-y-1/2 w-[450px] h-[450px] bg-[#00F0FF]/15 rounded-full blur-[150px] pointer-events-none z-10"></div>
			<div class="absolute bottom-1/4 right-1/4 translate-x-1/2 translate-y-1/2 w-[450px] h-[450px] bg-red-600/15 rounded-full blur-[150px] pointer-events-none z-10"></div>
			<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:32px_32px] pointer-events-none z-10"></div>

			<!-- Hero Content -->
			<div class="relative z-20 mx-auto max-w-5xl px-6 w-full text-center space-y-6">
				<!-- YouTube Live Badge -->
				<div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-red-500/30 bg-red-950/40 text-red-400 text-xs sm:text-sm font-semibold uppercase tracking-wider backdrop-blur-md shadow-[0_0_25px_rgba(255,0,0,0.25)]">
					<span class="relative flex h-2.5 w-2.5">
						<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
						<span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-500"></span>
					</span>
					<span>Canal Oficial de YouTube</span>
				</div>

				<!-- Main Title with Custom Linear Gradient: Verde Turquesa (#00F0FF) -> Azul Eléctrico (#0088FF) -> Rojo Vibrante (#FF0000) -->
				<h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black tracking-tight text-white leading-tight drop-shadow-[0_4px_16px_rgba(0,0,0,0.9)]">
					<span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00F0FF] via-[#0088FF] to-[#FF0000] drop-shadow-[0_2px_14px_rgba(0,240,255,0.35)]">
						Casos de Éxito y Reparaciones en Vivo
					</span>
				</h1>

				<!-- Subtitle -->
				<p class="text-slate-200 text-base md:text-xl max-w-3xl mx-auto leading-relaxed drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)] font-medium">
					Transparencia técnica en cada trabajo. Mira nuestras reparaciones en vivo y encuentra los repuestos exactos para tu equipo.
				</p>

				<!-- CTAs: Red HUD YouTube Button & Repuestos Catalog Button -->
				<div class="pt-4 flex flex-wrap justify-center items-center gap-4">
					<!-- Red HUD YouTube CTA Button -->
					<a 
						href={SUBSCRIBE_URL}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex justify-center items-center gap-3 bg-gradient-to-r from-[#FF0000] to-[#CC0000] hover:from-[#E60000] hover:to-[#B30000] text-white px-8 py-4 rounded-xl font-extrabold text-base transition-all duration-300 shadow-[0_0_30px_rgba(255,0,0,0.45)] hover:shadow-[0_0_40px_rgba(255,0,0,0.7)] hover:scale-105 active:scale-95 group border border-red-400/30"
					>
						<svg class="w-6 h-6 text-white group-hover:scale-110 transition-transform drop-shadow" viewBox="0 0 24 24" fill="currentColor">
							<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
						</svg>
						<span>Suscribirse al Canal</span>
					</a>

					<!-- Catálogo de Repuestos CTA Button -->
					<a 
						href="/repuestos"
						class="inline-flex justify-center items-center gap-2.5 bg-zinc-900/90 hover:bg-zinc-800 text-slate-200 hover:text-brand-cyan px-7 py-4 rounded-xl font-bold text-base transition-all duration-300 border border-white/10 hover:border-brand-cyan/40 shadow-lg hover:shadow-[0_0_20px_rgba(0,207,255,0.2)] hover:scale-105"
					>
						<svg class="w-5 h-5 text-brand-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
						</svg>
						<span>Ver Catálogo de Repuestos</span>
					</a>
				</div>

				<!-- Highlights Pill Bar -->
				<div class="pt-6 flex flex-wrap justify-center items-center gap-3 sm:gap-6 text-xs text-slate-400">
					<div class="flex items-center gap-2 bg-white/5 border border-white/10 px-3.5 py-1.5 rounded-full backdrop-blur-sm">
						<svg class="w-4 h-4 text-brand-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
						<span>100% Diagnósticos Reales</span>
					</div>
					<div class="flex items-center gap-2 bg-white/5 border border-white/10 px-3.5 py-1.5 rounded-full backdrop-blur-sm">
						<svg class="w-4 h-4 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
						<span>Microelectrónica & Upgrades</span>
					</div>
					<div class="flex items-center gap-2 bg-white/5 border border-white/10 px-3.5 py-1.5 rounded-full backdrop-blur-sm">
						<svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
						<span>Videos en Alta Resolución</span>
					</div>
				</div>
			</div>
		</section>

		<!-- PARRILLA DE VIDEOS AUTOMATIZADA (HUD CYBERPUNK) -->
		<section class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 w-full py-8">
			<!-- Section Header & Filter Controls (Debug text cleaned, Text gradient applied) -->
			<div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 pb-6 border-b border-white/10">
				<div>
					<!-- Custom Text Gradient: Verde Turquesa (#00F0FF) -> Azul Eléctrico (#0088FF) -->
					<h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
						<span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00F0FF] to-[#0088FF] drop-shadow-[0_2px_10px_rgba(0,240,255,0.3)]">
							Contenido técnico y guías de taller
						</span>
					</h2>
					<p class="text-slate-400 text-sm mt-1 max-w-2xl">
						Aprende a reparar, potenciar tus equipos y descubre cómo realizamos cada trabajo con estándar de laboratorio.
					</p>
				</div>

				<!-- Category Filter Pills Exact: Todos, Reparación, Shorts, Impresoras, Upgrades, Microelectrónica -->
				<div class="flex flex-wrap items-center gap-2" id="video-filter-bar">
					<button class="filter-btn active-filter px-3.5 py-2 rounded-lg text-xs font-semibold bg-[#00F0FF] text-black transition-all duration-200 cursor-pointer shadow-[0_0_15px_rgba(0,240,255,0.3)]" data-filter="all">
						Todos
					</button>
					<button class="filter-btn px-3.5 py-2 rounded-lg text-xs font-semibold bg-zinc-900 text-slate-300 hover:text-[#00F0FF] border border-white/10 hover:border-[#00F0FF]/40 transition-all duration-200 cursor-pointer" data-filter="reparacion">
						Reparación
					</button>
					<button class="filter-btn px-3.5 py-2 rounded-lg text-xs font-semibold bg-zinc-900 text-slate-300 hover:text-[#00F0FF] border border-white/10 hover:border-[#00F0FF]/40 transition-all duration-200 cursor-pointer" data-filter="shorts">
						Shorts
					</button>
					<button class="filter-btn px-3.5 py-2 rounded-lg text-xs font-semibold bg-zinc-900 text-slate-300 hover:text-[#00F0FF] border border-white/10 hover:border-[#00F0FF]/40 transition-all duration-200 cursor-pointer" data-filter="impresoras">
						Impresoras
					</button>
					<button class="filter-btn px-3.5 py-2 rounded-lg text-xs font-semibold bg-zinc-900 text-slate-300 hover:text-[#00F0FF] border border-white/10 hover:border-[#00F0FF]/40 transition-all duration-200 cursor-pointer" data-filter="upgrades">
						Upgrades
					</button>
					<button class="filter-btn px-3.5 py-2 rounded-lg text-xs font-semibold bg-zinc-900 text-slate-300 hover:text-[#00F0FF] border border-white/10 hover:border-[#00F0FF]/40 transition-all duration-200 cursor-pointer" data-filter="microelectronica">
						Microelectrónica
					</button>
				</div>
			</div>

			<!-- Video Grid: Cyberpunk HUD Containers (#0A1118 a #121E2B, Cyan borders, Subtle Shadows) -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="videos-grid">
				{videos.map((video) => {
					const formattedDate = new Date(video.publishedAt).toLocaleDateString('es-CL', {
						year: 'numeric',
						month: 'short',
						day: 'numeric'
					});

					const categoryAttr = (video.category || 'reparacion').toLowerCase();

					return (
						<article 
							class="video-card group flex flex-col justify-between rounded-2xl bg-gradient-to-b from-[#0A1118] to-[#121E2B] border border-brand-cyan/20 hover:border-brand-cyan/80 p-4 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_0_30px_rgba(0,240,255,0.2)] backdrop-blur-xl relative overflow-hidden"
							data-category={categoryAttr}
							data-title={video.title.toLowerCase()}
							data-desc={(video.description || '').toLowerCase()}
							data-is-short={video.isShort ? "true" : "false"}
						>
							<!-- Cyberpunk Corner HUD Accents -->
							<div class="absolute top-0 right-0 w-8 h-8 border-t-2 border-r-2 border-brand-cyan/40 group-hover:border-brand-cyan transition-colors pointer-events-none rounded-tr-xl"></div>
							<div class="absolute bottom-0 left-0 w-8 h-8 border-b-2 border-l-2 border-brand-cyan/40 group-hover:border-brand-cyan transition-colors pointer-events-none rounded-bl-xl"></div>

							<div class="space-y-4">
								<!-- Video Thumbnail / Player Trigger with 16:9 Aspect Ratio -->
								<div class="relative aspect-video rounded-xl overflow-hidden bg-black/80 border border-white/10 group-hover:border-brand-cyan/40 transition-all">
									<img 
										src={video.thumbnail} 
										alt={video.title} 
										loading="lazy" 
										class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 filter brightness-95"
									/>
									
									<!-- Dark Gradient Overlay on hover -->
									<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-60 group-hover:opacity-30 transition-opacity"></div>

									<!-- Play Button HUD Badge -->
									<button 
										type="button"
										class="open-video-modal absolute inset-0 m-auto w-14 h-14 rounded-full bg-red-600/90 text-white flex items-center justify-center shadow-[0_0_25px_rgba(255,0,0,0.6)] group-hover:scale-110 group-hover:bg-red-600 transition-all duration-300 cursor-pointer focus:outline-none focus:ring-2 focus:ring-brand-cyan"
										data-video-id={video.id}
										data-video-title={video.title}
										aria-label={`Reproducir ${video.title}`}
									>
										<svg class="w-6 h-6 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
											<path d="M8 5v14l11-7z"/>
										</svg>
									</button>

									<!-- Category & Time Badges -->
									<div class="absolute bottom-2.5 left-2.5 right-2.5 flex items-center justify-between pointer-events-none">
										<span class="text-[11px] font-mono font-bold px-2.5 py-0.5 rounded bg-black/80 text-brand-cyan border border-brand-cyan/30 backdrop-blur-sm">
											{video.category}
										</span>
										<span class="text-[11px] font-mono px-2 py-0.5 rounded bg-black/80 text-slate-300 backdrop-blur-sm">
											{formattedDate}
										</span>
									</div>
								</div>

								<!-- Video Title and Description -->
								<div class="space-y-2">
									<h3 class="text-base font-bold text-white group-hover:text-brand-cyan transition-colors line-clamp-2 leading-snug">
										<button 
											type="button" 
											class="open-video-modal text-left hover:underline cursor-pointer focus:outline-none"
											data-video-id={video.id}
											data-video-title={video.title}
										>
											{video.title}
										</button>
									</h3>
									<p class="text-slate-400 text-xs leading-relaxed line-clamp-2">
										{video.description || 'Mira este procedimiento técnico grabado directamente en nuestro laboratorio de Santiago.'}
									</p>
								</div>
							</div>

							<!-- Cyberpunk HUD Divider & Repuestos Direct Link Block -->
							<div class="mt-4 pt-3.5 border-t border-white/10 space-y-2.5">
								<!-- Linking to Repuestos -->
								<div class="bg-black/50 border border-brand-cyan/20 rounded-xl p-2.5 flex items-center justify-between gap-3 group-hover:border-brand-cyan/40 transition-colors">
									<div class="flex items-center gap-2 min-w-0">
										<div class="w-7 h-7 rounded-lg bg-brand-cyan/10 border border-brand-cyan/30 flex items-center justify-center shrink-0">
											<svg class="w-4 h-4 text-brand-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
											</svg>
										</div>
										<div class="truncate">
											<span class="block text-[10px] uppercase font-mono text-slate-400">Repuestos del Video</span>
											<span class="block text-xs font-semibold text-slate-200 truncate">{video.repuestoQuery || 'Componentes compatibles'}</span>
										</div>
									</div>

									<a 
										href="/repuestos" 
										class="shrink-0 text-xs font-bold text-brand-cyan hover:text-white bg-brand-cyan/10 hover:bg-brand-cyan/30 px-3 py-1.5 rounded-lg border border-brand-cyan/30 transition-all flex items-center gap-1"
									>
										<span>Ver</span>
										<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
									</a>
								</div>

								<!-- Direct Action Row -->
								<div class="flex items-center justify-between pt-1">
									<a 
										href={video.url} 
										target="_blank" 
										rel="noopener noreferrer" 
										class="text-xs text-red-400 hover:text-red-300 font-medium inline-flex items-center gap-1.5 transition-colors"
									>
										<svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
											<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
										</svg>
										<span>Abrir en YouTube</span>
									</a>

									<a 
										href={`https://wa.me/56948672300?text=${encodeURIComponent(`Hola SERVITECNOLOGY, vi su video "${video.title}" y necesito cotizar una reparación similar o repuestos.`)}`} 
										target="_blank" 
										rel="noopener noreferrer" 
										class="text-xs text-brand-green hover:underline font-medium inline-flex items-center gap-1"
									>
										<span>Cotizar Falla</span>
