<script>
	// Modal Interactivity
	const modal = document.getElementById('youtube-video-modal');
	const iframe = document.getElementById('modal-video-iframe') as HTMLIFrameElement | null;
	const modalTitle = document.getElementById('modal-video-title');
	const modalLink = document.getElementById('modal-youtube-link') as HTMLAnchorElement | null;
	const closeBtn = document.getElementById('close-video-modal');
	const openButtons = document.querySelectorAll('.open-video-modal');

	function openModal(videoId: string, title: string) {
		if (!modal || !iframe) return;
		iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
		if (modalTitle) modalTitle.textContent = title;
		if (modalLink) modalLink.href = `https://www.youtube.com/watch?v=${videoId}`;
		modal.classList.remove('hidden');
		modal.classList.add('flex');
		document.body.style.overflow = 'hidden';
	}

	function closeModal() {
		if (!modal || !iframe) return;
		iframe.src = '';
		modal.classList.add('hidden');
		modal.classList.remove('flex');
		document.body.style.overflow = '';
	}

	openButtons.forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement);
			const videoId = target.getAttribute('data-video-id');
			const title = target.getAttribute('data-video-title') || 'Video de Servitecnology';
			if (videoId) openModal(videoId, title);
		});
	});

	closeBtn?.addEventListener('click', closeModal);

	modal?.addEventListener('click', (e) => {
		if (e.target === modal) closeModal();
	});

	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
			closeModal();
		}
	});

	// Updated Category Filter Tabs: Todos, Reparación, Shorts, Impresoras, Upgrades, Microelectrónica
	const filterBtns = document.querySelectorAll('.filter-btn');
	const videoCards = document.querySelectorAll<HTMLElement>('.video-card');

	filterBtns.forEach(btn => {
		btn.addEventListener('click', () => {
			filterBtns.forEach(b => {
				b.classList.remove('active-filter', 'bg-[#00F0FF]', 'text-black', 'shadow-[0_0_15px_rgba(0,240,255,0.3)]');
				b.classList.add('bg-zinc-900', 'text-slate-300');
			});

			btn.classList.add('active-filter', 'bg-[#00F0FF]', 'text-black', 'shadow-[0_0_15px_rgba(0,240,255,0.3)]');
			btn.classList.remove('bg-zinc-900', 'text-slate-300');

			const filter = btn.getAttribute('data-filter');

			videoCards.forEach(card => {
				const cat = (card.getAttribute('data-category') || '').toLowerCase();
				const title = (card.getAttribute('data-title') || '').toLowerCase();
				const desc = (card.getAttribute('data-desc') || '').toLowerCase();
				const isShort = card.getAttribute('data-is-short') === 'true';

				let matches = false;

				if (filter === 'all') {
					matches = true;
				} else if (filter === 'reparacion') {
					matches = cat.includes('repara') || (!isShort && !cat.includes('impresora') && !cat.includes('micro') && !cat.includes('upgrade'));
				} else if (filter === 'shorts') {
					matches = isShort || cat.includes('short') || title.includes('#short') || desc.includes('#short') || title.includes('shorts');
				} else if (filter === 'impresoras') {
					matches = cat.includes('impresora') || title.includes('impresora') || title.includes('epson') || title.includes('canon') || title.includes('cabezal') || title.includes('almohadilla') || title.includes('toner');
				} else if (filter === 'upgrades') {
					matches = cat.includes('upgrade') || title.includes('ram') || title.includes('ssd') || title.includes('upgrade') || title.includes('disco') || title.includes('memoria') || title.includes('aumentar');
				} else if (filter === 'microelectronica') {
					matches = cat.includes('micro') || title.includes('placa') || title.includes('corto') || title.includes('mosfet') || title.includes('soldadura') || title.includes('bios') || title.includes('condensador') || title.includes('19v');
				}

				if (matches) {
					card.style.display = 'flex';
				} else {
					card.style.display = 'none';
				}
			});
		});
	});
</script>
