---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Button from '../components/Button.astro';
---

<Layout title="Infra Manager Pro | ERP de Gestión Inmobiliaria - SERVITECNOLOGY">
	<Header />
	
	<main class="bg-black min-h-screen pt-20">
		<div class="max-w-7xl mx-auto px-6 py-16 md:py-24 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
			<!-- Text Content -->
			<div class="space-y-8">
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-purple-500/30 bg-purple-500/10 text-purple-400 text-xs font-semibold uppercase tracking-wider">
					Arquitectura de Confianza
				</div>
				
				<h1 class="text-4xl md:text-5xl font-black text-white tracking-tight">
					Infra Manager Pro - <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-fuchsia-500">Administración Rigurosa</span>
				</h1>
				
				<p class="text-lg text-slate-300 leading-relaxed">
					Administrar no es solo gestionar datos; es comprar paz mental. Reduzca el error humano al 0% con nuestro sistema ERP corporativo diseñado para la gestión de condominios e infraestructura institucional.
				</p>
				
				<ul class="space-y-4">
					<li class="flex items-start gap-3 text-slate-300">
						<svg class="w-6 h-6 text-purple-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
						</svg>
						<span><strong>Finanzas de Élite:</strong> Automatización de morosidad, cobros asíncronos y trazabilidad total de cada centavo en registros inmutables.</span>
					</li>
					<li class="flex items-start gap-3 text-slate-300">
						<svg class="w-6 h-6 text-purple-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
						</svg>
						<span><strong>Checklists Predictivos:</strong> Evidencia operativa multimedia 4K para respaldar mantenimientos y reparaciones.</span>
					</li>
					<li class="flex items-start gap-3 text-slate-300">
						<svg class="w-6 h-6 text-purple-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
						</svg>
						<span><strong>Democracia Digital & Votos:</strong> Votaciones certificadas desde el smartphone para asambleas con total validez.</span>
					</li>
				</ul>
				
				<div class="pt-6 flex flex-wrap gap-4">
					<Button href="https://inframanagerpro.com" variant="primary" class="px-8 py-4 bg-purple-600 hover:bg-purple-500 text-white shadow-[0_0_20px_rgba(147,51,234,0.4)]" target="_blank">
						Conocer InfraManagerPro y Solicitar Demo
					</Button>
				</div>
			</div>
			
			<!-- Visual Mockup -->
			<div class="relative w-full rounded-2xl overflow-hidden border border-white/10 bg-zinc-900 shadow-2xl">
				<div class="absolute inset-0 bg-gradient-to-tr from-purple-600/20 to-transparent pointer-events-none"></div>
				<div class="aspect-square md:aspect-[4/3] flex items-center justify-center p-8">
					<div class="w-full max-w-lg bg-[#ffffff] rounded-xl border border-slate-200 shadow-2xl overflow-hidden flex flex-col h-[400px]">
						<div class="h-12 bg-slate-50 border-b border-slate-200 flex items-center justify-between px-4">
							<div class="flex items-center gap-2">
								<div class="w-6 h-6 rounded-md bg-purple-600 flex items-center justify-center text-white text-[10px] font-bold">IP</div>
								<span class="text-sm font-semibold text-slate-800">Infra Manager Pro</span>
							</div>
							<div class="flex gap-2">
								<span class="px-2 py-1 bg-green-100 text-green-700 text-[10px] font-bold rounded">Certificado</span>
							</div>
						</div>
						
						<div class="flex-1 flex bg-slate-100 p-4 gap-4">
							<!-- Sidebar -->
							<div class="w-1/3 space-y-2">
								<div class="h-8 bg-purple-100 rounded flex items-center px-2 border-l-4 border-purple-600">
									<div class="w-3 h-3 rounded bg-purple-400 mr-2"></div>
									<div class="h-2 w-16 bg-purple-300 rounded"></div>
								</div>
								<div class="h-8 bg-white rounded flex items-center px-2">
									<div class="w-3 h-3 rounded bg-slate-300 mr-2"></div>
									<div class="h-2 w-12 bg-slate-200 rounded"></div>
								</div>
								<div class="h-8 bg-white rounded flex items-center px-2">
									<div class="w-3 h-3 rounded bg-slate-300 mr-2"></div>
									<div class="h-2 w-14 bg-slate-200 rounded"></div>
								</div>
							</div>
							
							<!-- Main Content Area -->
							<div class="flex-1 bg-white rounded-lg shadow-sm p-4 flex flex-col gap-4">
								<div class="flex justify-between items-end pb-2 border-b border-slate-100">
									<div>
										<div class="text-[10px] text-slate-400 uppercase font-bold tracking-wider">Flujo de Caja</div>
										<div class="text-2xl font-black text-slate-800">$12,450.00</div>
									</div>
									<div class="w-16 h-8 bg-green-50 rounded"></div>
								</div>
								
								<div class="space-y-3">
									<div class="flex justify-between items-center p-2 rounded bg-slate-50 border border-slate-100">
										<div class="flex items-center gap-2">
											<div class="w-6 h-6 rounded-full bg-blue-100"></div>
											<div class="h-2 w-20 bg-slate-300 rounded"></div>
										</div>
										<div class="h-2 w-10 bg-slate-400 rounded"></div>
									</div>
									<div class="flex justify-between items-center p-2 rounded bg-slate-50 border border-slate-100">
										<div class="flex items-center gap-2">
											<div class="w-6 h-6 rounded-full bg-purple-100"></div>
											<div class="h-2 w-24 bg-slate-300 rounded"></div>
										</div>
										<div class="h-2 w-12 bg-slate-400 rounded"></div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>
	
	<Footer />
	<WhatsAppButton phone="56948672300" message="Hola, me gustaría solicitar una demostración del sistema Infra Manager Pro." />
</Layout>
