---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CintaTrabajos from '../components/CintaTrabajos.astro';

const pageTitle = "Quiénes Somos | Servitecnology - Servicio Técnico desde 2021";
const pageDescription = "Conoce la historia de Servitecnology. Desde 2021 entregando soluciones integrales en reparación de computadores, repuestos, redes y seguridad en Santiago.";

const valores = [
	{
		titulo: "Transparencia Total",
		descripcion: "Diagnósticos honestos sin costos ocultos ni letra chica. Te informamos detalladamente sobre la falla y cada componente reemplazado antes de intervenir tu equipo.",
		icon: "shield-check",
		color: "brand-cyan"
	},
	{
		titulo: "Calidad Garantizada",
		descripcion: "Trabajamos únicamente con repuestos verificados, insumos térmicos de alta gama y herramientas de precisión. Todas nuestras reparaciones de hardware cuentan con garantía real por escrito.",
		icon: "badge-check",
		color: "brand-green"
	},
	{
		titulo: "Compromiso Local",
		descripcion: "Atención ágil en la Región Metropolitana de Santiago. Ofrecemos soporte presencial en terreno y asistencia remota fuera de horario laboral para asegurar tu continuidad operativa.",
		icon: "map-pin",
		color: "brand-cyan"
	},
	{
		titulo: "Pasión por la Tecnología",
		descripcion: "Amamos la tecnología. Nos capacitamos e innovamos constantemente en hardware, modding, infraestructura de red, seguridad CCTV e inteligencia artificial.",
		icon: "cpu",
		color: "brand-green"
	}
];
---

<Layout 
	title={pageTitle} 
	description={pageDescription}
	keywords="quienes somos servitecnology, servicio tecnico santiago, historia servitecnology, equipo servitecnology, mision vision servitecnology"
>
	<Header />

	<main class="relative bg-black min-h-screen pt-24 pb-20 overflow-hidden">
		<!-- Background Glows -->
		<div class="absolute top-1/4 left-1/4 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[550px] bg-brand-cyan/5 rounded-full blur-[160px] pointer-events-none z-0"></div>
		<div class="absolute bottom-1/4 right-1/4 translate-x-1/2 translate-y-1/2 w-[550px] h-[550px] bg-brand-green/5 rounded-full blur-[160px] pointer-events-none z-0"></div>
		<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:32px_32px] pointer-events-none z-0"></div>

		<!-- HERO SECTION -->
		<section class="relative z-10 mx-auto max-w-5xl px-6 w-full text-center py-12 md:py-20 space-y-6">
			<div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-brand-cyan/20 bg-brand-cyan/5 text-brand-cyan text-sm font-semibold uppercase tracking-wider">
				<span class="w-2 h-2 rounded-full bg-brand-cyan animate-pulse"></span>
				Trayectoria y Compromiso desde 2021
			</div>
			
			<h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-tight">
				Quiénes Somos: <br class="hidden sm:inline" />
				<span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-cyan via-brand-cyan to-brand-green">
					Pasión y Transparencia en Tecnología
				</span>
			</h1>

			<p class="text-slate-300 text-lg md:text-xl max-w-3xl mx-auto leading-relaxed pt-2">
				Nacimos para transformar el soporte técnico informático en Santiago. Combinamos rigor profesional, transparencia absoluta y flexibilidad horaria adaptada a las necesidades reales de nuestros clientes.
			</p>
		</section>

		<!-- SECCIÓN NUESTRA HISTORIA -->
		<section class="relative z-10 mx-auto max-w-5xl px-6 w-full py-12">
			<div class="relative group p-8 sm:p-12 rounded-3xl border border-white/10 bg-zinc-950/80 backdrop-blur-2xl shadow-2xl overflow-hidden">
				<div class="absolute top-0 right-0 w-96 h-96 bg-brand-cyan/5 rounded-full blur-[120px] pointer-events-none"></div>

				<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
					<div class="lg:col-span-7 space-y-6">
						<div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-brand-green">
							<span>Nuestra Historia</span>
						</div>
						
						<h2 class="text-2xl sm:text-4xl font-extrabold text-white leading-snug">
							Construyendo confianza tecnológica <span class="text-brand-cyan">paso a paso</span>
						</h2>

						<p class="text-slate-300 text-base leading-relaxed">
							Fundada en <strong class="text-white font-semibold">2021</strong> en Santiago de Chile, <strong class="text-brand-cyan font-semibold">SERVITECNOLOGY</strong> nació como respuesta a la falta de un servicio técnico cercano, honesto y verdaderamente eficiente en la Región Metropolitana.
						</p>

						<p class="text-slate-300 text-base leading-relaxed">
							Desde nuestros inicios, entendimos que detrás de cada computadora, servidor o sistema de cámaras hay un usuario o empresa que no puede darse el lujo de detener sus actividades. Por ello, desarrollamos un modelo único de soporte que incluye <strong class="text-brand-green font-semibold">atención en horarios vespertinos (After Office) y fines de semana</strong>, asegurando que tus equipos reciban mantenimiento sin interrumpir tu jornada de trabajo.
						</p>

						<p class="text-slate-300 text-base leading-relaxed">
							Hoy en día, abarcamos desde la reparación especializada de hardware de computadoras y notebooks, hasta el suministro de repuestos originales, el montaje de redes empresariales y la instalación de sistemas de seguridad CCTV.
						</p>
					</div>

					<div class="lg:col-span-5 relative flex justify-center">
						<div class="relative w-full max-w-sm rounded-2xl border border-white/15 overflow-hidden shadow-2xl bg-zinc-900 group-hover:border-brand-cyan/30 transition-colors duration-500">
							<img src="/imagenes/principal.jpg" alt="Instalaciones y Taller SERVITECNOLOGY" class="w-full h-80 object-cover object-center group-hover:scale-105 transition-transform duration-700" />
							<div class="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-transparent"></div>
							<div class="absolute bottom-6 left-6 right-6">
								<div class="text-3xl font-black text-brand-cyan">2021</div>
								<div class="text-xs text-slate-300 uppercase tracking-wider font-semibold">Año de Fundación en Santiago</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- SECCIÓN MISIÓN Y VISIÓN -->
		<section class="relative z-10 mx-auto max-w-5xl px-6 w-full py-12">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
				
				<!-- Tarjeta Misión -->
				<div class="relative group p-8 rounded-2xl border border-white/10 bg-zinc-950/70 backdrop-blur-xl hover:border-brand-cyan/30 transition-all duration-300 shadow-xl flex flex-col justify-between">
					<div class="space-y-4">
						<div class="flex items-center gap-3">
							<div class="p-3 rounded-xl bg-brand-cyan/10 text-brand-cyan border border-brand-cyan/20">
								<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
								</svg>
							</div>
							<h3 class="text-2xl font-bold text-white tracking-tight">Nuestra Misión</h3>
						</div>

						<p class="text-slate-300 text-sm sm:text-base leading-relaxed pt-2">
							Proveer soluciones tecnológicas integrales, confiables y eficientes, garantizando la continuidad operativa y tranquilidad de personas y empresas mediante soporte técnico transparente, repuestos garantizados y atención de alta calidad.
						</p>
					</div>
					
					<div class="mt-6 pt-4 border-t border-white/5 flex items-center gap-2 text-xs font-semibold text-brand-cyan">
						<span class="w-1.5 h-1.5 rounded-full bg-brand-cyan"></span>
						Compromiso con la excelencia operativa
					</div>
				</div>

				<!-- Tarjeta Visión -->
				<div class="relative group p-8 rounded-2xl border border-white/10 bg-zinc-950/70 backdrop-blur-xl hover:border-brand-green/30 transition-all duration-300 shadow-xl flex flex-col justify-between">
					<div class="space-y-4">
						<div class="flex items-center gap-3">
							<div class="p-3 rounded-xl bg-brand-green/10 text-brand-green border border-brand-green/20">
								<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
								</svg>
							</div>
							<h3 class="text-2xl font-bold text-white tracking-tight">Nuestra Visión</h3>
						</div>

						<p class="text-slate-300 text-sm sm:text-base leading-relaxed pt-2">
							Posicionarnos como el servicio técnico e integrador de soluciones tecnológicas líder y de mayor confianza en la Región Metropolitana, destacados por nuestra ética humana, innovación constante y rapidez de respuesta.
						</p>
					</div>

					<div class="mt-6 pt-4 border-t border-white/5 flex items-center gap-2 text-xs font-semibold text-brand-green">
						<span class="w-1.5 h-1.5 rounded-full bg-brand-green"></span>
						Liderazgo tecnológico y confianza comprobada
					</div>
				</div>

			</div>
		</section>

		<!-- SECCIÓN VALORES CORPORATIVOS -->
		<section class="relative z-10 mx-auto max-w-5xl px-6 w-full py-16 border-t border-white/5">
			<div class="text-center max-w-3xl mx-auto mb-12 space-y-4">
				<div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-brand-cyan/20 bg-brand-cyan/5 text-brand-cyan text-sm font-semibold uppercase tracking-wider">
					Principios Fundamentales
				</div>
				<h2 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white">
					Valores que Guían <br class="hidden sm:inline" />
					<span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-cyan to-brand-green">
						Nuestro Trabajo Diario
					</span>
				</h2>
				<p class="text-slate-400 text-base md:text-lg">
					Cada servicio que prestamos está respaldado por pilares éticos y técnicos fundamentales.
				</p>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
				{valores.map((item) => (
					<div class="bg-zinc-950/60 border border-white/5 p-6 rounded-2xl hover:border-brand-cyan/30 transition-all duration-300 group hover:-translate-y-1 shadow-lg flex flex-col justify-between">
						<div class="space-y-4">
							<div class={`p-3 w-fit rounded-xl bg-${item.color}/10 text-${item.color} border border-${item.color}/20 group-hover:scale-110 transition-transform`}>
								{item.icon === "shield-check" && (
									<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
								)}
								{item.icon === "badge-check" && (
									<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
								)}
								{item.icon === "map-pin" && (
									<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
								)}
								{item.icon === "cpu" && (
									<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 5h10a2 2 0 012 2v10a2 2 0 01-2 2H7a2 2 0 01-2-2V7a2 2 0 012-2z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 9h6v6H9V9z"></path></svg>
								)}
							</div>

							<h3 class="text-lg font-bold text-white">{item.titulo}</h3>
							<p class="text-slate-400 text-xs sm:text-sm leading-relaxed">
								{item.descripcion}
							</p>
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- CINTA DE TRABAJOS REALIZADOS -->
		<CintaTrabajos 
			categoria="soporte-tecnico" 
			tituloSeccion="Casos de Éxito y Proyectos"
			subtituloSeccion="Conoce de cerca la calidad y dedicación con la que tratamos cada trabajo en nuestro taller y en terreno."
		/>

		<!-- CTA FINAL DE CONTACTO -->
		<section class="relative z-10 mx-auto max-w-5xl px-6 w-full py-12 text-center">
			<div class="relative group p-8 sm:p-12 rounded-3xl border border-brand-cyan/20 bg-zinc-950/90 backdrop-blur-2xl shadow-[0_0_30px_rgba(0,207,255,0.1)] overflow-hidden space-y-6">
				<h2 class="text-3xl md:text-4xl font-extrabold text-white">
					¿Necesitas soporte técnico de confianza?
				</h2>
				<p class="text-slate-300 text-base max-w-2xl mx-auto">
					Ponte en contacto con nuestro equipo especialista hoy mismo. Te brindaremos asesoría personalizada y transparente.
				</p>
				<div class="pt-2 flex flex-wrap justify-center gap-4">
					<a 
						href="https://wa.me/56948672300?text=Hola%20SERVITECNOLOGY,%20me%20gustar%C3%ADa%20consultar%20por%20sus%20servicios..." 
						target="_blank" 
						rel="noopener noreferrer"
						class="inline-flex items-center gap-3 bg-brand-cyan text-black hover:bg-brand-green px-8 py-4 rounded-xl font-bold text-base transition-all duration-300 shadow-[0_0_20px_rgba(0,207,255,0.25)] hover:scale-105"
					>
						Hablar por WhatsApp
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.458 5.704 1.459h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
					</a>
					<a 
						href="/#servicios" 
						class="inline-flex items-center gap-2 bg-white/5 hover:bg-white/10 text-white border border-white/10 px-8 py-4 rounded-xl font-semibold text-base transition-all duration-300"
					>
						Explorar Servicios
					</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
	<WhatsAppButton phone="56948672300" message="Hola SERVITECNOLOGY, requiero información..." />
</Layout>
