						{ordersInPrepCount > 0 && pendingOrdersCount === 0 && (
							<span class="px-2 py-0.5 rounded-full bg-brand-cyan/20 text-brand-cyan border border-brand-cyan/40 text-[10px] font-mono font-bold">
