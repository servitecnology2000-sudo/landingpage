---
import Button from './Button.astro';

interface NavItem {
	label: string;
	href?: string;
	children?: { label: string; href: string }[];
}

const navItems: NavItem[] = [
	{
		label: 'Software SaaS',
		children: [
			{ label: 'Whagil IA (Automatización)', href: '/whagil' },
			{ label: 'Whalinkbot (Campañas)', href: '/whalinkbot' },
			{ label: 'Infra Manager Pro (ERP)', href: '/inframanagerpro' },
		]
	},
	{
		label: 'Servicios TI',
		children: [
			{ label: 'Soporte Técnico', href: '/soporte' },
			{ label: 'Desarrollo de Software', href: '/desarrollo' },
			{ label: 'CCTV y Redes', href: '/cctv' },
			{ label: 'Repuestos', href: '/repuestos' },
		]
	},
	{ label: 'Quiénes Somos', href: '/nosotros' },
];
---

<header class="sticky top-0 z-50 w-full border-b border-white/5 bg-black/75 backdrop-blur-md transition-all duration-300">
	<div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
		<!-- Brand Logo -->
		<a href="/" class="flex items-center gap-3 group">
			<img src="/imagenes/logost.png" alt="SERVITECNOLOGY Logo" class="h-10 w-auto object-contain group-hover:scale-105 transition-transform duration-300" />
			<span class="text-xl md:text-2xl font-extrabold tracking-wider bg-gradient-to-r from-brand-green to-brand-cyan bg-clip-text text-transparent group-hover:opacity-90 transition-opacity">
				SERVITECNOLOGY
			</span>
		</a>

		<!-- Desktop Navigation -->
		<nav class="hidden md:flex items-center gap-6">
			<a 
				href="mailto:contacto@servitecnology.com" 
				class="inline-flex items-center gap-2 text-xs font-medium text-slate-300 hover:text-brand-cyan transition-all duration-300 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 hover:border-brand-cyan/30 hover:bg-brand-cyan/5 group"
				aria-label="Enviar correo a contacto@servitecnology.com"
			>
				<svg class="w-3.5 h-3.5 text-brand-cyan group-hover:scale-110 transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
				</svg>
				<span class="tracking-wide">contacto@servitecnology.com</span>
			</a>
			{navItems.map((item) => (
				item.children ? (
					<div class="relative group">
						<button class="text-sm font-medium text-slate-300 hover:text-brand-cyan transition-colors duration-300 py-1 flex items-center gap-1">
							{item.label}
							<svg class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
							</svg>
						</button>
						<div class="absolute left-0 top-full mt-2 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
							<div class="bg-black/90 backdrop-blur-xl border border-white/10 rounded-xl overflow-hidden shadow-2xl py-2">
								{item.children.map(child => (
									<a href={child.href} class="block px-4 py-2 text-sm text-slate-300 hover:bg-brand-cyan/10 hover:text-brand-cyan transition-colors">
										{child.label}
									</a>
								))}
							</div>
						</div>
					</div>
				) : (
					<a 
						href={item.href} 
						class="text-sm font-medium text-slate-300 hover:text-brand-cyan transition-colors duration-300 relative py-1 after:absolute after:bottom-0 after:left-0 after:h-[2px] after:w-0 after:bg-brand-cyan after:transition-all after:duration-300 hover:after:w-full"
					>
						{item.label}
					</a>
				)
			))}

			<!-- YouTube Channel Button (Canal) -->
			<a 
				href="/canal-de-youtube" 
				class="relative inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold text-white bg-gradient-to-r from-red-600 to-red-500 hover:from-red-500 hover:to-red-600 border border-red-400/40 shadow-[0_0_16px_rgba(255,0,0,0.35)] hover:shadow-[0_0_24px_rgba(255,0,0,0.7)] hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 group cursor-pointer shrink-0 whitespace-nowrap"
				title="Canal Oficial de YouTube de SERVITECNOLOGY"
			>
				<svg class="w-4 h-4 text-white group-hover:scale-110 transition-transform drop-shadow-[0_1px_3px_rgba(0,0,0,0.8)] shrink-0" viewBox="0 0 24 24" fill="currentColor">
					<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
				</svg>
				<span class="tracking-wide">Canal</span>
				<span class="relative flex h-2 w-2 shrink-0">
					<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
					<span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
				</span>
			</a>

			<Button href="/#contacto" variant="outline" class="px-5 py-2 text-xs">
				Contacto
			</Button>
		</nav>

		<!-- Mobile Menu Toggle Button -->
		<button 
			id="menu-toggle" 
			class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border border-white/10 text-slate-300 hover:bg-white/5 md:hidden focus:outline-none"
			aria-label="Abrir menú de navegación"
		>
			<svg id="menu-icon" class="h-6 w-6 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
			</svg>
			<svg id="close-icon" class="hidden h-6 w-6 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
			</svg>
		</button>
	</div>

	<!-- Mobile Menu Panel -->
	<div 
		id="mobile-menu" 
		class="hidden w-full border-t border-white/5 bg-black/95 px-6 py-6 md:hidden transition-all duration-300 ease-in-out"
	>
		<nav class="flex flex-col gap-4">
			<a 
				href="mailto:contacto@servitecnology.com" 
				class="mobile-nav-link flex items-center gap-2.5 text-sm font-medium text-brand-cyan hover:underline py-2 border-b border-white/5"
			>
				<svg class="w-4 h-4 text-brand-cyan shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
				</svg>
				<span>contacto@servitecnology.com</span>
			</a>
			<!-- Mobile YouTube Button -->
			<a 
				href="/canal-de-youtube" 
				class="mobile-nav-link flex items-center justify-between p-3 rounded-xl bg-red-600/20 border border-red-500/40 text-white font-bold text-sm shadow-[0_0_15px_rgba(255,0,0,0.2)]"
			>
				<div class="flex items-center gap-2.5">
					<svg class="w-5 h-5 text-red-500" viewBox="0 0 24 24" fill="currentColor">
						<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
					</svg>
					<span>Nuestro Canal de YouTube</span>
				</div>
				<span class="text-xs bg-red-600 px-2 py-0.5 rounded text-white font-mono">En Vivo</span>
			</a>
			{navItems.map((item) => (
				item.children ? (
					<div class="py-2 border-b border-white/5">
						<div class="text-base font-semibold text-slate-100 mb-2">{item.label}</div>
						<div class="flex flex-col gap-2 pl-4">
							{item.children.map(child => (
								<a href={child.href} class="mobile-nav-link text-sm text-slate-400 hover:text-brand-cyan transition-colors">
									- {child.label}
								</a>
							))}
						</div>
					</div>
				) : (
					<a 
						href={item.href} 
						class="mobile-nav-link text-base font-medium text-slate-300 hover:text-brand-cyan transition-colors py-2 border-b border-white/5"
					>
						{item.label}
					</a>
				)
			))}
			<div class="pt-4">
				<Button href="/#contacto" variant="primary" class="w-full">
					Contacto
				</Button>
			</div>
		</nav>
	</div>
</header>

<script>
	const menuToggle = document.getElementById('menu-toggle');
	const mobileMenu = document.getElementById('mobile-menu');
	const menuIcon = document.getElementById('menu-icon');
	const closeIcon = document.getElementById('close-icon');
	const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

	function toggleMenu() {
		const isExpanded = mobileMenu?.classList.contains('hidden') === false;

		if (isExpanded) {
			mobileMenu?.classList.add('hidden');
			menuIcon?.classList.remove('hidden');
			closeIcon?.classList.add('hidden');
		} else {
			mobileMenu?.classList.remove('hidden');
			menuIcon?.classList.add('hidden');
			closeIcon?.classList.remove('hidden');
		}
	}

	menuToggle?.addEventListener('click', toggleMenu);

	// Close mobile menu when clicking a link
	mobileNavLinks.forEach(link => {
		link.addEventListener('click', () => {
			mobileMenu?.classList.add('hidden');
			menuIcon?.classList.remove('hidden');
			closeIcon?.classList.add('hidden');
		});
	});
</script>
