---
export interface BreadcrumbItem {
	label: string;
	href?: string;
}

export interface Props {
	items: BreadcrumbItem[];
	class?: string;
	centered?: boolean;
}

const { items = [], class: className = '', centered = false } = Astro.props;

const baseUrl = 'https://servitecnology.com';

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": items.map((item, index) => {
		const fullUrl = item.href
			? (item.href.startsWith('http') ? item.href : `${baseUrl}${item.href}`)
			: undefined;

		const listItem: any = {
			"@type": "ListItem",
			"position": index + 1,
			"name": item.label
		};

		if (fullUrl) {
			listItem.item = fullUrl;
		}

		return listItem;
	})
};
---

{items.length > 0 && (
	<>
		<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />

		<nav aria-label="Breadcrumb" class:list={["w-full py-3 select-none", className]}>
			<ol class:list={["flex items-center flex-wrap gap-1.5 sm:gap-2 text-xs sm:text-sm text-slate-400", centered ? "justify-center" : "justify-start"]}>
				{items.map((item, index) => {
					const isLast = index === items.length - 1;
					return (
						<li class="flex items-center gap-1.5 sm:gap-2">
							{index > 0 && (
								<svg class="w-3.5 h-3.5 text-slate-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
								</svg>
							)}
							{isLast || !item.href ? (
								<span 
									class="font-semibold text-white truncate max-w-[180px] sm:max-w-xs md:max-w-md lg:max-w-none" 
									aria-current={isLast ? "page" : undefined}
									title={item.label}
								>
									{item.label}
								</span>
							) : (
								<a 
									href={item.href} 
									class="hover:text-brand-cyan transition-colors duration-200 truncate max-w-[140px] sm:max-w-none"
									title={item.label}
								>
									{item.label}
								</a>
							)}
						</li>
					);
				})}
			</ol>
		</nav>
	</>
)}
