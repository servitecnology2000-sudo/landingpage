---
import { supabase } from '../lib/supabase';

// Obtener categorías reales desde Supabase con orden preferido
let categories: Array<{ id: string; label: string }> = [
	{ id: "todos", label: "Todos" }
];

const preferredOrder = ['todos', 'accesorios', 'cctv', 'impresora', 'cargadores', 'pantallas', 'video', 'teclados'];

try {
	const { data: products } = await supabase
		.from('repuestos_productos')
		.select('categoria');
	
	if (products && products.length > 0) {
		const unique = [...new Set(products.map(p => p.categoria).filter(Boolean))];
		
		const mapped = [
			{ id: 'todos', label: 'Todos' },
			...unique.map(cat => ({ id: cat, label: cat }))
		].sort((a, b) => {
			const indexA = preferredOrder.indexOf(a.id.toLowerCase());
			const indexB = preferredOrder.indexOf(b.id.toLowerCase());
			if (indexA !== -1 && indexB !== -1) return indexA - indexB;
			if (indexA !== -1) return -1;
			if (indexB !== -1) return 1;
			return a.label.localeCompare(b.label);
		});

		categories = mapped;
	} else {
		throw new Error('No products returned');
	}
} catch (e) {
	// Fallback con la lista oficial solicitada
	categories = [
		{ id: 'todos', label: 'Todos' },
		{ id: 'Accesorios', label: 'Accesorios' },
		{ id: 'CCTV', label: 'CCTV' },
		{ id: 'Impresora', label: 'Impresora' },
		{ id: 'Cargadores', label: 'Cargadores' },
		{ id: 'pantallas', label: 'pantallas' },
		{ id: 'Video', label: 'Video' },
		{ id: 'teclados', label: 'teclados' },
	];
}
---

<nav 
	id="repuestos-top-nav" 
	aria-label="Navegación de categorías y búsqueda de repuestos"
	class="relative z-30 mx-auto max-w-7xl px-4 sm:px-6 w-full pt-6 sm:pt-8 pb-4 overflow-hidden"
>
	<!-- Ambient Glow sutil -->
	<div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[150px] bg-brand-cyan/10 rounded-full blur-[120px] pointer-events-none -z-10"></div>

	<!-- ============================================================ -->
	<!-- 1. MENÚ DE CATEGORÍAS (UBICADO ARRIBA DEL CARRUSEL) -->
	<!-- ============================================================ -->
	<div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2.5 mb-5 sm:mb-6 px-1">
		{categories.map((cat) => (
			<button
				type="button"
				data-filter={cat.id}
				class:list={[
					"catalog-filter px-3 sm:px-5 py-1.5 sm:py-2.5 rounded-full text-xs sm:text-sm font-semibold tracking-wide transition-all duration-300 cursor-pointer border select-none focus:outline-none",
					cat.id === "todos"
						? "bg-brand-cyan text-black border-brand-cyan shadow-[0_0_15px_rgba(0,207,255,0.35)]"
						: "bg-zinc-900/80 text-slate-300 border-white/10 hover:text-white hover:border-brand-cyan/40 hover:bg-white/10 shadow-sm"
				]}
			>
				{cat.label}
			</button>
		))}
	</div>

	<!-- ============================================================ -->
	<!-- 2. BARRA DE BÚSQUEDA UNIVERSAL (ENTRE EL MENÚ Y EL CARRUSEL) -->
	<!-- ============================================================ -->
	<div class="max-w-3xl mx-auto mb-4 w-full">
		<div class="relative group">
			<!-- Resplandor dinámico en foco -->
			<div class="absolute -inset-0.5 bg-gradient-to-r from-brand-cyan via-brand-green to-brand-cyan rounded-2xl blur opacity-30 group-hover:opacity-60 group-focus-within:opacity-85 transition duration-500"></div>
			
			<!-- Contenedor del Input de Búsqueda -->
			<div class="relative flex items-center bg-zinc-950/95 border border-white/15 focus-within:border-brand-cyan rounded-2xl px-3.5 sm:px-5 py-2.5 sm:py-3.5 shadow-[0_15px_35px_-5px_rgba(0,0,0,0.85)] backdrop-blur-xl transition-all duration-300">
				<svg class="w-5 h-5 text-brand-cyan shrink-0 mr-3 transition-transform duration-300 group-focus-within:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
				</svg>
				
				<input 
					id="catalog-search-input"
					type="text" 
					placeholder="Buscar por SKU, modelo o repuesto (ej: ThinkPad, cargador, pantalla)..."
					class="w-full bg-transparent text-white placeholder-slate-400 text-xs sm:text-base font-medium focus:outline-none pr-10"
					autocomplete="off"
					spellcheck="false"
				/>
				
				<button 
					id="catalog-search-clear" 
					type="button" 
					class="hidden absolute right-3.5 top-1/2 -translate-y-1/2 p-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-slate-300 hover:text-white transition-all text-xs focus:outline-none cursor-pointer"
					title="Limpiar búsqueda"
					aria-label="Limpiar búsqueda"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>
				</button>
			</div>
		</div>

		<!-- Feedback Dinámico de Búsqueda (Oculto para mayor limpieza visual) -->
		<div id="search-feedback" class="hidden" aria-hidden="true">
			<div class="flex items-center gap-2 min-w-0">
				<span id="search-status-dot" class="w-2 h-2 rounded-full bg-brand-green animate-pulse shrink-0"></span>
				<span id="search-counter-text" class="font-medium text-slate-300 truncate">Explorando catálogo completo</span>
			</div>
			<span class="hidden sm:inline text-slate-500 font-normal shrink-0">
				Atajo rápido: pulsa <kbd class="px-1.5 py-0.5 rounded bg-white/10 text-brand-cyan font-mono text-[10px] border border-white/10">/</kbd> para buscar
			</span>
		</div>
	</div>
</nav>
