---
import Button from './Button.astro';
---

<section class="relative min-h-[92vh] flex items-center justify-center overflow-hidden py-24 sm:py-32 bg-black">
	<!-- Background Image with scroll fade-out effect -->
	<div id="hero-bg-image" class="absolute inset-0 z-0 pointer-events-none transition-opacity duration-75">
		<div class="absolute inset-0 bg-black/70 z-10"></div> <!-- Dark overlay to protect contrast -->
		<div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-black/30 z-10"></div> <!-- Top/bottom gradients -->
		<img src="/imagenes/principal.jpg" alt="SERVITECNOLOGY Soporte Principal" class="w-full h-full object-cover object-center" />
	</div>

	<!-- Decorative centered ambient glows -->
	<div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] md:w-[750px] h-[350px] md:h-[500px] bg-brand-cyan/15 rounded-full blur-[150px] pointer-events-none z-10"></div>
	<div class="absolute bottom-1/4 left-1/2 -translate-x-1/2 translate-y-1/4 w-[450px] md:w-[650px] h-[300px] md:h-[450px] bg-brand-green/10 rounded-full blur-[150px] pointer-events-none z-10"></div>

	<!-- Background grid pattern -->
	<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(255,255,255,0.025)_1px,transparent_1px)] bg-[size:32px_32px] pointer-events-none z-10"></div>

	<!-- Centered Hero Container -->
	<div class="relative z-20 mx-auto max-w-5xl px-6 w-full text-center flex flex-col items-center justify-center space-y-8 sm:space-y-10">
		<!-- Top Pill Badge -->
		<div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-brand-cyan/20 bg-brand-cyan/5 text-brand-cyan text-xs sm:text-sm font-semibold uppercase tracking-wider backdrop-blur-md shadow-[0_0_20px_rgba(0,207,255,0.15)]">
			<span class="w-2 h-2 rounded-full bg-brand-cyan animate-pulse"></span>
			SERVITECNOLOGY · Servicio Técnico Informático & E-commerce en Santiago
		</div>

		<!-- Main Hero Title -->
		<h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-tight leading-[1.05] sm:leading-[1.0] drop-shadow-[0_4px_24px_rgba(0,0,0,0.9)] max-w-4xl mx-auto">
			<span class="block pb-2 pt-1 text-transparent bg-clip-text bg-gradient-to-r from-brand-cyan via-brand-cyan to-brand-green drop-shadow-[0_2px_14px_rgba(0,207,255,0.45)]">
				Servicio Técnico Especializado
			</span>
			<span class="block mt-1 sm:mt-2 text-white">
				Repuestos y Soluciones TI
			</span>
		</h1>

		<!-- Subtitle -->
		<p class="text-base sm:text-lg md:text-xl text-slate-200 max-w-2xl sm:max-w-3xl mx-auto leading-relaxed drop-shadow-[0_2px_6px_rgba(0,0,0,0.85)] font-normal">
			En <strong class="text-white font-semibold">SERVITECNOLOGY</strong> reparamos tus computadores y notebooks, proveemos repuestos originales garantizados y desarrollamos soluciones de software SaaS para potenciar tu empresa en Santiago de Chile.
		</p>

		<!-- CTAs (Centered Action Buttons) -->
		<div class="flex flex-wrap gap-4 pt-2 sm:pt-4 justify-center items-center w-full max-w-3xl">
			<Button data-track-event="clic_boton" data-element-id="btn_hero_repuestos" variant="primary" href="/repuestos" class="px-8 py-4 text-base shadow-[0_0_25px_rgba(0,255,127,0.3)] hover:shadow-[0_0_35px_rgba(0,255,127,0.5)] bg-gradient-to-r from-brand-green to-brand-cyan text-black font-black uppercase tracking-wide">
				Tienda de Repuestos
			</Button>
			<Button data-track-event="clic_boton" data-element-id="btn_hero_servicios" variant="outline" href="#servicios" class="px-8 py-4 text-base bg-black/50 backdrop-blur-md border-white/20 hover:bg-white/10 hover:border-brand-cyan/40 text-white font-bold">
				Servicios TI
			</Button>
			<Button data-track-event="clic_boton" data-element-id="btn_hero_saas" variant="outline" href="#productos-saas" class="px-8 py-4 text-base bg-black/50 backdrop-blur-md border-white/20 hover:bg-white/10 hover:border-brand-cyan/40 text-white font-bold">
				Software SaaS
			</Button>
			<Button data-track-event="clic_boton" data-element-id="btn_hero_escribenos" variant="primary" href="https://wa.me/56948672300?text=Hola%20SERVITECNOLOGY,%20me%20interesan%20sus%20servicios..." target="_blank" rel="noopener noreferrer" class="px-8 py-4 text-base shadow-[0_0_25px_rgba(0,255,127,0.25)] hover:shadow-[0_0_35px_rgba(0,255,127,0.45)] bg-brand-green/10 border-brand-green/30 text-brand-green hover:bg-brand-green hover:text-black flex items-center gap-2">
				<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.458 5.704 1.459h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
				WhatsApp
			</Button>
		</div>
	</div>
</section>

<script>
	const bgImage = document.getElementById('hero-bg-image');
	if (bgImage) {
		window.addEventListener('scroll', () => {
			const scrollY = window.scrollY;
			const opacity = Math.max(0, 1 - scrollY / 600);
			bgImage.style.opacity = opacity.toString();
		}, { passive: true });
	}
</script>
