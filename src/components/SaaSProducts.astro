---
import Button from './Button.astro';

const saasProducts = [
	{
		id: 'whagil',
		title: 'Whagil IA',
		subtitle: 'Agentes IA & Automatización Meta',
		description: 'Plataforma B2B para automatizar ventas y atención con agentes de IA en WhatsApp e Instagram. Convierte comentarios en DM automáticos y atiende 24/7 con respuestas inteligentes.',
		icon: 'M13 10V3L4 14h7v7l9-11h-7z', // Zap icon
		link: '/whagil',
		color: 'from-blue-500 to-indigo-600',
		hoverColor: 'group-hover:shadow-[0_0_30px_rgba(59,130,246,0.3)]'
	},
	{
		id: 'whalinkbot',
		title: 'Whalinkbot',
		subtitle: 'Bots para WhatsApp & Campañas',
		description: 'Motor asíncrono para envío de campañas masivas y prospección por WhatsApp. 100% Cloud: envía mensajes y extrae clientes potenciales sin depender de tu PC encendida.',
		icon: 'M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z', // Box/Server icon
		link: '/whalinkbot',
		color: 'from-emerald-400 to-emerald-600',
		hoverColor: 'group-hover:shadow-[0_0_30px_rgba(16,185,129,0.3)]'
	},
	{
		id: 'inframanagerpro',
		title: 'Infra Manager Pro',
		subtitle: 'ERP & Gestión Empresarial',
		description: 'Sistema empresarial de alto nivel para gestión operativa, soporte y control financiero. Automatización de procesos, trazabilidad de cobros y margen de error 0%.',
		icon: 'M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11m16-11v11M8 14v3m4-3v3m4-3v3', // Bank/Building icon
		link: '/inframanagerpro',
		color: 'from-purple-500 to-fuchsia-600',
		hoverColor: 'group-hover:shadow-[0_0_30px_rgba(168,85,247,0.3)]'
	},
	{
		id: 'custom-dev',
		title: 'Software a Medida',
		subtitle: 'Bots de IA & Automatización',
		description: 'Desarrollamos bots para WhatsApp, agentes IA para atención 24/7, automatización de redes sociales (Instagram/Meta) y sistemas web conectados a tus bases de datos y pagos.',
		icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4', // Code icon
		link: '/desarrollo',
		color: 'from-cyan-400 to-teal-600',
		hoverColor: 'group-hover:shadow-[0_0_30px_rgba(0,207,255,0.3)]'
	}
];
---

<section id="productos-saas" class="relative py-24 bg-black overflow-hidden border-t border-white/5">
	<!-- Background Effects -->
	<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(0,207,255,0.05)_0%,transparent_50%)] pointer-events-none"></div>

	<div class="relative z-10 max-w-7xl mx-auto px-6">
		<div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
			<div class="inline-flex items-center justify-center gap-2 px-3 py-1 rounded-full border border-white/10 bg-white/5 text-slate-300 text-xs font-semibold uppercase tracking-wider mb-2">
				Software a Medida & Ecosistemas Digitales
			</div>
			<h2 class="text-3xl md:text-5xl font-black text-white tracking-tight">
				Plataformas SaaS, <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-cyan to-brand-green">Agentes IA & Bots</span>
			</h2>
			<p class="text-lg text-slate-400">
				Más que soporte técnico, somos creadores de tecnología. Automatiza la prospección, atención y gestión de tu empresa con agentes de inteligencia artificial y bots personalizados.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
			{saasProducts.map(product => (
				<div class={`group relative p-1 rounded-2xl bg-gradient-to-b ${product.color} opacity-90 hover:opacity-100 transition-all duration-500 ${product.hoverColor}`}>
					<div class="relative h-full bg-zinc-950 p-6 sm:p-7 rounded-xl flex flex-col items-start overflow-hidden">
						<!-- Glow effect behind content -->
						<div class={`absolute top-0 right-0 w-32 h-32 bg-gradient-to-br ${product.color} blur-[60px] opacity-20 group-hover:opacity-40 transition-opacity`}></div>
						
						<div class={`w-12 h-12 rounded-xl bg-gradient-to-br ${product.color} p-[1px] mb-5 flex-shrink-0 shadow-lg`}>
							<div class="w-full h-full bg-zinc-900 rounded-[11px] flex items-center justify-center">
								<svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
									<path stroke-linecap="round" stroke-linejoin="round" d={product.icon} />
								</svg>
							</div>
						</div>

						<h3 class="text-xl font-bold text-white mb-1.5">{product.title}</h3>
						<div class={`text-[11px] font-bold uppercase tracking-wider bg-clip-text text-transparent bg-gradient-to-r ${product.color} mb-3`}>
							{product.subtitle}
						</div>
						
						<p class="text-slate-400 text-xs sm:text-sm leading-relaxed flex-grow mb-6 relative z-10">
							{product.description}
						</p>

						<div class="w-full mt-auto relative z-10">
							<a href={product.link} class="inline-flex w-full items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-white text-xs sm:text-sm font-semibold transition-all group-hover:-translate-y-1">
								Conocer Detalles
								<svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
								</svg>
							</a>
						</div>
					</div>
				</div>
			))}
		</div>
	</div>
</section>
