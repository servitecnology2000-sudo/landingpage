---
import { supabase } from '../lib/supabase';

// 1. Consulta de Banners Activos EXCLUSIVOS de la sección 'repuestos'
let dbBanners: Array<{
	id: string;
	titulo: string;
	descripcion?: string;
	imagen_url: string;
	link_url?: string;
	alt_text?: string;
	orden?: number;
	badge?: string;
	cta_text?: string;
	is_hero?: boolean;
}> = [];

try {
	const { data, error } = await supabase
		.from('hero_banners')
		.select('*')
		.eq('seccion', 'repuestos')
		.eq('activo', true)
		.order('orden', { ascending: true })
		.order('created_at', { ascending: false });

	if (!error && data && data.length > 0) {
		dbBanners = data;
	}
} catch (e) {
	// Fallback silencioso y seguro
}

// 2. Diapositivas de Respaldo Curadas para la Tienda de Repuestos
// Incluye la imagen original (/imagenes/soportepc.jpg) y las 6 imágenes oficiales de Banners
const defaultRepuestosBanners = [
	{
		id: 'rep-slide-0-soporte',
		titulo: 'No tienes que hacerlo solo',
		descripcion: 'Instalamos y configuramos tus repuestos y componentes. Cotiza la instalación con nosotros.',
		imagen_url: '/imagenes/soportepc.jpg',
		alt_text: 'No tienes que hacerlo solo. Instalamos y configuramos tus repuestos',
		link_url: 'https://wa.me/56948672300?text=Hola%20SERVITECNOLOGY,%20deseo%20cotizar%20la%20instalaci%C3%B3n%20y%20configuraci%C3%B3n%20de%20mis%20repuestos...',
		badge: 'Servicio Técnico Garantizado',
		cta_text: 'Cotiza tu servicio',
		is_hero: true
	},
	{
		id: 'rep-slide-1-impresora',
		titulo: 'Oferta de Impresora Epson con Instalación Gratis',
		descripcion: 'Calidad excepcional y mayor velocidad. $199.000 con instalación técnica gratis.',
		imagen_url: '/imagenes/banners/1.jpg',
		alt_text: 'Oferta de Impresora Epson $199.000 con Instalación Gratis',
		link_url: 'https://wa.me/56948672300?text=Hola%20SERVITECNOLOGY,%20me%20interesa%20la%20Oferta%20de%20Impresora%20Epson%20por%20$199.000%20con%20instalaci%C3%B3n%20gratis',
		badge: 'Oferta Especial · $199.000',
