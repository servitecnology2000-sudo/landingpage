		imagen_url: '/imagenes/banners/6.jpg',
		alt_text: 'Kit Cámara Mercusys MC200 y Tarjeta MicroSD 64GB IMOU $41.900',
		link_url: 'https://wa.me/56948672300?text=Hola%20SERVITECNOLOGY,%20deseo%20el%20Kit%20C%C3%A1mara%20Mercusys%20MC200%20con%20MicroSD%2064GB%20por%20$41.900',
		badge: 'Kit Completo · $41.900',
