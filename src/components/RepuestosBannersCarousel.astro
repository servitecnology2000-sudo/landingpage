	},
	{
		id: 'rep-slide-2-ecommerce',
		titulo: 'Ecommerce de Repuestos y Hardware Informático',
		descripcion: 'Componentes testeados con garantía oficial. Retiro en oficina o despacho a domicilio.',
		imagen_url: '/imagenes/banners/2.jpg',
